   // Hàm Getdata
function Getdata(fromdate, todate) {
    var fromdate_ = fromdate == null ? $('#FROMDATE').val() : fromdate;
    var todate_ = todate == null ? $('#TODATE').val() : todate;

    return $.ajax({
        url: '@Url.Action("Getdata_")',
        data: {
            fromdate: fromdate_,
            todate: todate_
        },
        beforeSend: function () {
            // Hiển thị loading trong khi gửi yêu cầu
            $(".divLoading").addClass("loading");
        },
        success: function (response) {
            if (response.status < 0) {
                notify(response.text, "error");
            } else {
                notify(response.text, "success");
            }
        },
        error: function (message) {
            console.error('Lỗi:', message);
        }
    }).always(function() {
        // Gỡ bỏ loading sau khi hoàn tất yêu cầu AJAX
        $(".divLoading").removeClass("loading");
    });
}

