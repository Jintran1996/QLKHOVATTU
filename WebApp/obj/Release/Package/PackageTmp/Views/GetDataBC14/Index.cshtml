    <script type="text/javascript">
        $(document).ready(function () {
            GetList(false);

        });


        window.onload = function () {
            // Gửi yêu cầu đăng nhập lần đầu
            const login = () => {
                $(".divLoading").addClass("loading");

                const loginUrl = 'https://localhost:44338/Login/'; // Địa chỉ URL đăng nhập
                const credentials = {
                    username: '2464', // Tên người dùng
                    password: 'QuanTri101010'    // Mật khẩu
                };

                return fetch(loginUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(credentials)
                })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Đăng nhập không thành công!');
                        }
                        //  return response; // Trả về response nếu đăng nhập thành công
                    });
            };

            // Hàm xử lý các tham số từ URL
            const handleUrlParams = () => {
                const urlParams = new URLSearchParams(window.location.search);
                const dateValue = urlParams.get('data'); // Lấy giá trị của tham số "data"

                if (dateValue) {
                    console.log('Giá trị ngày nhận được:', dateValue);

                    const result = getFirstAndLastDateOfMonth(dateValue);
                    // Gọi Getdata như một hàm bất đồng bộ
                    return Getdata(result.firstDate, result.lastDate)

                        .then(() => {
                            console.log(`Ngày đầu tháng: ${result.firstDate}`);
                            console.log(`Ngày cuối tháng: ${result.lastDate}`);
                        });
                } else {
                    console.log('Không có giá trị "data" trong URL.');
                }
            };

            // Thực hiện đăng nhập và sau đó xử lý URL
            login()
                .then(() => {
                    return handleUrlParams(); // Chờ hoàn tất xử lý URL
                })
                .catch(error => {
                    console.error('Lỗi:', error);
                })
                .finally(() => {
                    // Luôn luôn xóa loading sau khi mọi thứ hoàn tất
                    $(".divLoading").removeClass("loading");
                });
        };

        function getFirstAndLastDateOfMonth(monthYear) {
            // Tách tháng và năm từ chuỗi

            const [month, year] = monthYear.split('/').map(Number);

            // Ngày đầu tháng
            const firstDate = new Date(year, month - 1, 1); // Tháng bắt đầu từ 0

            // Ngày cuối tháng
            const lastDate = new Date(year, month, 0); // Ngày 0 của tháng sau là ngày cuối của tháng hiện tại

            // Định dạng ngày dưới dạng "dd/mm/yyyy"
            const formatDate = (d) => {
                const dd = String(d.getDate()).padStart(2, '0');
                const mm = String(d.getMonth() + 1).padStart(2, '0');
                const yyyy = d.getFullYear();
                return `${dd}/${mm}/${yyyy}`;
            };

            return {
                firstDate: formatDate(firstDate),
                lastDate: formatDate(lastDate)
            };
        }
    </script>
