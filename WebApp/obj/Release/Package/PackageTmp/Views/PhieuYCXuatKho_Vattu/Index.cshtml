</div>

<div id="myModalUpload" class="modal fade modal-wide" role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmUpload", id = "frmUpload", enctype = "multipart/form-data" }))
            {
                <div class="modal-header bg-gradient-blue">
                    <div class="modal-title" style="font-size: 17px;text-transform:uppercase;color:mintcream"><strong id="myModalTitleUpload"></strong></div>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div id="myModalContentUpload">
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="text-right">
                        <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal"><i class="fa fa-close"></i>&nbsp;Close</button>
                    </div>
                </div>}
        </div>
    </div>
</div>
<div id="myModalDetailReport" class="modal fade modal-wide" role="dialog" style="overflow:auto">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <div class="modal-title" style="font-size: 17px;text-transform:uppercase;color:#3c8dbc"><strong id="myModalTitleDetailReport"></strong></div>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div id="myModalContentDetailReport" class="_print">

                </div>
            </div>
            <div class="modal-footer">
                <div class="text-right">
                    <button type="button" id="btPrint" onclick="javascript:CallPrint('myModalContentDetailReport');" class="btn btn-sm btn-success"><i class="fa fa-print"></i>&nbsp;In</button>

                    <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal"> <i class="fa fa-close"></i>&nbsp;Đóng</button>&nbsp;
                </div>
            </div>
        </div>
    </div>
</div>


@section scripts{
    <script language="javascript" type="text/javascript">
        function CallPrint(strid) {
            var prtContent = document.getElementById(strid);
            var WinPrint = window.open('', '', 'left=0,top=0,width=800,height=900,toolbar=0,scrollbars=0,status=0');
            WinPrint.document.write(prtContent.innerHTML);
            WinPrint.document.close();
            WinPrint.focus();
            WinPrint.print();
            WinPrint.close();
        }

    </script>
    <script type="text/javascript">
        var config = {
            '.chosen-select-search': {},
            '.chosen-select-search-deselect': { allow_single_deselect: true },
            '.chosen-select-search-no-single': { disable_search_threshold: 10 },
            '.chosen-select-search-no-results': { no_results_text: 'Oops, nothing found!' },
            '.chosen-select-search-width': { width: "95%" },
            'search_contains': true
        }
        for (var selector in config) {
            $(selector).chosen(config);
        }
    </script>

    <script>
        function reloadData(page) {
            try {
                _insert_nhapkho();
                reloadData_getlist();

            } catch (e) {
            }
        }


        function reloadData_getlist(isDelete) {
            var Search_ = $('#SOCTXNSearch').val();
            try {
            $.ajax({
                url: '@Url.Action("_GetList")',
                timeout: 20000,
                data: {
                    SOCTXNSearch: Search_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-khoxn').html(response);

                    $("#myTable").DataTable({
                        //"responsive": true,
                        "lengthChange": true,
                        "autoWidth": true,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
        }


         function _insert_nhapkho() {
            $.ajax({
                url: '@Url.Action("_Insert")',
                timeout: 20000,
                data: {
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-insert-nhapkho').html(response);

                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }


    </script>

    <script type="text/javascript">
        var $modal = $('#myModal');
        var $myModalContent = $("#myModalContent");
        var $myModalTitle = $("#myModalTitle");

        var $modalUpload = $('#myModalUpload');
        var $myModalContentUpload = $("#myModalContentUpload");
        var $myModalTitleUpload = $("#myModalTitleUpload");

        var $modalDetail = $('#myModalDetail');
        var $myModalContentDetail = $("#myModalContentDetail");
        var $myModalTitleDetail = $("#myModalTitleDetail");

        var $myModalDetailReport = $('#myModalDetailReport');
        var $myModalContentDetailReport = $("#myModalContentDetailReport");
        var $myModalTitleDetailReport = $("#myModalTitleDetailReport");

        var $modalEditct = $('#myModalEditct');
        var $myModalContentEditct = $("#myModalContentEditct");
        var $myModalTitleEditct = $("#myModalTitleEditct");
        $(document).ready(function () {
            reloadData(false);



            $("#myModal").on("hidden.bs.modal", function () {
                reloadData(false);
            });

            $("#btnSearch").click(function () {
                reloadData_getlist(true);
            });


            $("#btSaveInsert").click(function () {
                form = $("#frmInsert");
                form.removeData('validator');
                form.removeData('unobtrusiveValidation');
                $.validator.unobtrusive.parse("#frmInsert");
                if (form.valid()) {
                    $.ajax({
                        url: '@Url.Action("_InsertFun")' ,
                        type: "POST",
                        data: $('#frmInsert').serialize(),
                        beforeSend: function (xhr) {
                            $(".divLoading").addClass("loading");
                        },
                        success: function (result) {
                            if (result.status >= 1) {
                                notify(result.text, "success");
                                reloadData(true);
                            }
                            else {
                                notify(result.text, "error");
                            }
                            $(".divLoading").removeClass("loading");

                        },
                        error: function (message) {
                            $(".divLoading").removeClass("loading");
                        }
                    });
                }
            });


            /// End document  //
        });

           $("#btSavect").click(function () {
  
            var eGHICHU = $("#eGHICHU").val();   
               var eNGAYCT = $("#eNGAYCT").val();
            var eKHOAKEYXN = $("#eKHOAKEYXN").val();
            var eSOCTXN = $("#eSOCTXN").val();
            var eLOAIXN = $("#eLOAIXN").val();
            var eMAPHIEUPD_XBAN = $("#eMAPHIEUPD_XBAN").val();
            $.ajax({
                url: '@Url.Action("_ActionUpdateCTPhieu_XBAN")',
                type: "POST",
                data: {
                    SOCTXN: eSOCTXN,     
                    GHICHU: eGHICHU,           
                    MaPhieuPD: eMAPHIEUPD_XBAN,
                    KHOAKEYXN: eKHOAKEYXN,
                    LOAIXN: eLOAIXN,
                    NGAYCT: eNGAYCT,
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status >= 1) {
                        notify(result.text, "success");
                        //Details(result.obj, result.obj2);
                        reloadData_getlist_ctphieu();
                    }
                    else {
                        notify(result.text, "error");
                    }
                    $(".divLoading").removeClass("loading");
                    $('#closectphieuedit').trigger('click');

                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        });



        function Details(SOCTXN_, LOAIXN_,MAKHONHAN_,MAKHOXUAT_) {
            $myModalContentDetail.html("");
            $myModalTitleDetail.html("Chi tiết");
            $.ajax({
                url: '@Url.Action("_GetListCTPhieu")',
                timeout: 200000,
                data: {
                    SOCTXN: SOCTXN_, LOAIXN: LOAIXN_,
                    MAKHONHAN: MAKHONHAN_, MAKHOXUAT: MAKHOXUAT_

                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    $myModalContentDetail.html(result);
                    $modalDetail.modal();
                   // reloadData_getlist_ctphieu(false);
                    $(".divLoading").removeClass("loading");
                },
                failure: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function Delete(SOCTXN_) {
            var confirm_ = confirm('Bạn có chắc muốn xóa số phiếu này?' + SOCTXN_);
             if (confirm_) {
                 $.ajax({
                     url: '@Url.Action("_DeleteFun")',
                     timeout: 2000000,
                     type: "POST",
                     data: { SOCTXN: SOCTXN_ },
                     beforeSend: function (xhr) {
                         $(".divLoading").addClass("loading");
                     },
                     success: function (result) {

                         if (result.status >= 1) {
                             notify(result.text, "success");
                             reloadData_getlist(false);
                         }
                         else {
                             notify(result.text, "error");
                         }
                         $(".divLoading").removeClass("loading");
                     },
                     error: function (message) {
                         $(".divLoading").removeClass("loading");
                     }
                 });
             }
        }

        function Print_DV(SOCTXN_, MAKHOXUAT_) {
            $myModalContentDetailReport.html("");
            $myModalTitleDetailReport.html("Phiếu yêu cầu xuất kho vật tư hàng hoá - đơn vị");
            var SoChungTu = SOCTXN_;
            var makho = MAKHOXUAT_;

            $.ajax({
                url: '@Url.Action("print_Phieu", "LapPhieuYeuCauXuatKhoTuMaPhieuPheDuyet")',
                timeout: 200000,
                data: {
                    SoChungTu: SoChungTu,
                    makho: makho,
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
            }).done(function (data) {
                if (data.status == null) {
                    $(".divLoading").removeClass("loading");
                    console.log(data);
                    $myModalContentDetailReport.html(data);
                    $myModalDetailReport.modal();
                }
                else {
                    $(".divLoading").removeClass("loading");
                    notify(data.text, "error");
                }
            }).fail(function (data) {
                notify(data.text, "error");
            });
        }
          function EditCt(KHOAKEYXN_, SOCTXN_, LoaiXN_) {
            $myModalContentEditct.html("");
            $myModalTitleEditct.html("Hiệu Chỉnh");
            $.ajax({
                url: '@Url.Action("_UpdateCTPhieu_XBAN")',
                timeout: 200000,
                data: {
                    KHOAKEYXN: KHOAKEYXN_, SOCTXN: SOCTXN_
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    $myModalContentEditct.html(result);
                    $modalEditct.modal();
                   // Details(SOCTXN_, LoaiXN_);
                   // reloadData_getlist_ctphieu_xban();

                    $(".divLoading").removeClass("loading");
                },
                failure: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }
        function Deletect(KHOAKEYXN_, MAVT_, SOCTXN_, MAKHONHAN_, MAKHOXUAT_, LOAIXN_) {
            var xSOCTXN = SOCTXN_;
            var xLOAIXN = LOAIXN_;
            var xMAKHONHAN = MAKHONHAN_;
            var xMAKHOXUAT = MAKHOXUAT_;
            var confirm_ = confirm('Bạn có chắc muốn xóa MAVT này? '+ SOCTXN_+ "||" + MAVT_);
             if (confirm_) {
                 $.ajax({
                     url: '@Url.Action("_DeleteCTFun")',
                     timeout: 2000000,
                     type: "POST",
                     data: { KHOAKEYXN: KHOAKEYXN_ },
                     beforeSend: function (xhr) {
                         $(".divLoading").addClass("loading");
                     },
                     success: function (result) {

                         if (result.status >= 1) {
                             notify(result.text, "success");
                             document.getElementById("idCloseDetail").addEventListener("click", function () {
                                 $('#myModalDetail').modal('hide');
                             });
                             Details(xSOCTXN, xLOAIXN, xMAKHONHAN, xMAKHOXUAT);
                         }
                         else {
                             notify(result.text, "error");
                         }
                         $(".divLoading").removeClass("loading");

                     },
                     error: function (message) {
                         $(".divLoading").removeClass("loading");
                     }
                 });
             }
            }
    </script>
}





