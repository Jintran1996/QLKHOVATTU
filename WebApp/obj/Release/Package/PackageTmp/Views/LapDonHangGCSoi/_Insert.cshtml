                                                </div>
                                            </div>
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>Mã sợi thành phẩm:</label>
                                                    <select id="MASOITHANHPHAM" name="MASOITHANHPHAM" class="form-control form-control-md chosen-select">
                                                        <option value=" ">----</option>
                                                        @foreach (var item in maSoiThanhPham)
                                                        {
                                                            <option value="@item.MAVATTU">
