                        </div>
                        <div class="tab-pane fade col-md-12" id="custom-tabs-one-profile" role="tabpanel" aria-labelledby="custom-tabs-one-profile-tab">
                            <div class="row">
                                <div class=" col-md-12">
                                    <fieldset class="scheduler-border">
                                        <legend class="scheduler-border">Đơn hàng gia công sợi chi tiết</legend>
                                        <div class="row">
