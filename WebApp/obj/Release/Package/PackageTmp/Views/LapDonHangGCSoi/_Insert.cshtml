                                        </div>
                                        <div class="row">
                                            <div class="col-md-2">
                                                <div class="form-group">
                                                    <label>Loại đơn hàng:</label>
                                                    <select id="Loaidh" name="Loaidh" class="form-control form-control-md chosen-select">
