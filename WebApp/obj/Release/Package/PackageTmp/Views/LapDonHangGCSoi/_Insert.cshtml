                                <div class="row" style="margin-bottom:15px">
                                </div>
                                <div class="row " style="margin-bottom:5px">
                                    <button type="button" id="btnLuu" class="btn btn-group-xs btn-success" style="width: 120px" onclick="Luu_click();"><i class="fa fa-save"></i>&nbsp;Lưu</button>&nbsp;&nbsp;
                                    @*<button type="button" id="btnLuu" class="btn btn-xs btn-warning" style="width: 120px" onclick="openOutlookemailbox();"><i class="fa fa-mail-bulk"></i>&nbsp;Email</button>&nbsp;&nbsp;*@
                                    @*<button type="button" id="btnLuu" class="btn btn-xs btn-info" style="width: 120px" onclick="Export_Excel_Click();"><i class="fa fa-file-excel"></i>&nbsp;Excel</button>&nbsp;&nbsp;*@
                                    <button type="button" id="btnLuu" class="btn btn-xs btn-primary" style="width: 120px" onclick="click_Phieumoi();"><i class="fa fa-newspaper"></i>&nbsp;Phiếu mới</button>&nbsp;&nbsp;
                                    @*<button type="button" id="btnLuu" class="btn btn-xs btn-info" style="width: 180px" onclick="SearchMaHang();"><i class="fa fa-search"></i>&nbsp;Tra Cứu Mã Hàng</button>&nbsp;&nbsp;*@
                                </div>
                                <div class="row" style="margin-bottom:15px">
                                </div>                              
                                <div class="row col-md-12">
                                    <div class="col-md-12">
                                        <div class="card card-primary card-outline">
                                            <div class="card-body pad">
                                                <div class="row">
                                                    <div class="col-md-12 table-CTHD table-responsive">
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /.card -->
                                        </div>
                                    </div>
                                    <!-- /.col -->
                                </div>
                                <div class="row col-md-12" style="margin-bottom:10px">
                                    <div class="col-md-12">
                                        <div class="modal-footer">
                                            <div class="text-right">
                                                <button type="button" class="btn btn-danger btn-sm pull-right" style="width: 120px;" data-dismiss="modal" id="close_"><i class="fa fa-close"></i>&nbsp;Đóng</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


<script type="text/javascript">
    function toggle(source) {
        var checkboxes = document.querySelectorAll('input[type="checkbox"]');
        for (var i = 0; i < checkboxes.length; i++) {
            if (checkboxes[i] != source)
                checkboxes[i].checked = source.checked;
        }
    }
    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }

    $("#NGAYYEUCAU_").datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true,
        onClose: function (selectedDate) {
            //$("#FromDate").datepicker("option", "minDate", selectedDate);
        }
    });
    $("#NGAYKETTHUC_").datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true,
        onClose: function (selectedDate) {
            //$("#FromDate").datepicker("option", "minDate", selectedDate);
        }
    });

</script>

<!--    Load Data   -->
<script type="text/javascript">
    var $myModalDetailReport = $('#myModalDetailReport');
    var $myModalContentDetailReport = $("#myModalContentDetailReport");
    var $myModalTitleDetailReport = $("#myModalTitleDetailReport");

    $(document).ready(function () {
        $("#close_").click(function () {
            Xoa_DonHangKhiDongKhongChiTiet_Click();
            reloadData(true);
        });
    });

    //-------------Xoá đơn hàng khi đóng chưa có chi tiết đơn hàng--------------//
     function Xoa_DonHangKhiDongKhongChiTiet_Click() {
         var MADH_GCSOI = $('#MaDonHang_CT').val();
         var confirm_ = confirm('Bạn có chắc muốn đóng chương trình?');
         if (confirm_) {
             $.ajax({
                 type: "POST",
                 async: false,
                 url: '@Url.Action("Xoa_DonHangKhiDongKhongChiTiet_Click")',
                 data: {
                     MADH_GCSOI: MADH_GCSOI,
                 },
                 beforeSend: function () {
                     $(".divLoading").addClass("loading");
                 },
             }).done(function (data) {
                 $(".divLoading").removeClass("loading");
                 if (data.status > 0) {
                     notify(data.text, "success");
                 }
                 else {
                     notify(data.text, "error");
                 }

             }).fail(function (errors) {
                 console.log(errors);
             });
         }
     }

    //-------------Load view update detail--------------//
    function UpdateChiTietView_Click(Khoa) {
        $.ajax({
            type: "GET",
            async: false,
            url: '@Url.Action("UpdateChiTietView_Click")',
            data: {
                Khoa: Khoa,
            },
            beforeSend: function () {
                $(".divLoading").addClass("loading");
            },
        }).done(function (data) {
            $(".divLoading").removeClass("loading");
            $('.table-updateDetail').html(data);
        }).fail(function (errors) {
            console.log(errors);
        });

    }
</script>
<!--    Action event  -->
<script type="text/javascript">
    //-----------------Action chuyển tiếp----------------//
    function ChuyenTiep_click() {
        var LOAIGIACONG = $('#LOAIGIACONG').val();
        var IDMADV_YC = $('#IDMADV_YC').val();
        var IDMADV_TH = $('#IDMADV_TH').val();
        var MANV_DONVIYC_XX = $('#MANV_DONVIYC_XX').val();
        var MANV_DONVITH_XACNHAN = $('#MANV_DONVITH_XACNHAN').val();
        $.ajax({
            type: "POST",
            async: false,
            url: '@Url.Action("ChuyenTiep_click")',
            data: {
                LOAIGIACONG: LOAIGIACONG,
                IDMADV_YC: IDMADV_YC,
                IDMADV_TH: IDMADV_TH,
                MANV_DONVITH_XACNHAN: MANV_DONVITH_XACNHAN,
                MANV_DONVIYC_XX: MANV_DONVIYC_XX,
            },
            beforeSend: function () {
                $(".divLoading").addClass("loading");
            },
        }).done(function (data) {
            $(".divLoading").removeClass("loading");
            if (data.status > 0) {
                notify(data.text, "success");
                $('#custom-tabs-one-profile-tab').trigger('click');
                //$("#custom-tabs-one-profile-tab").attr('style', 'display:""');
                //$("#custom-tabs-one-home-tab").attr('style', 'display:none');
                document.getElementById("tab-1").style.display = 'none';
                document.getElementById("tab-2").style.display = 'block';
                load_CTPhieu();
            }
            else {
                notify(data.text, "error");
            }

        }).fail(function (errors) {
            console.log(errors);
        });

    }
    //-----------------Lưu chi tiết Đơn hàng----------------//
    function Luu_click() {
        var MaDonHang_CT = $('#MaDonHang_CT').val();
        var NGAYYEUCAU_ = $('#NGAYYEUCAU_').val();
        var NGAYKETTHUC_ = $('#NGAYKETTHUC_').val();
        var Loaidh = $('#Loaidh').val();
        var SOLUONGYEUCAU = $('#SOLUONGYEUCAU').val();
        var MASOITHANHPHAM = $('#MASOITHANHPHAM').val();
        $.ajax({
            type: "POST",
            async: false,
            url: '@Url.Action("Luu_click")',
            data: {
                MADH_GCSOI: MaDonHang_CT,
                NGAYYEUCAU_: NGAYYEUCAU_,
                NGAYKETTHUC_: NGAYKETTHUC_,
                Loaidh: Loaidh,
                SOLUONGYEUCAU: SOLUONGYEUCAU,
                MASOITHANHPHAM: MASOITHANHPHAM,
            },
            beforeSend: function () {
                $(".divLoading").addClass("loading");
            },
        }).done(function (data) {
            $(".divLoading").removeClass("loading");
            load_CTPhieu();
            if (data.status > 0) {
                notify(data.text, "success");
                load_CTPhieu();
            }
            else {
                notify(data.text, "error");
                $(".divLoading").removeClass("loading");
            }

        }).fail(function (errors) {
            console.log(errors);
        });
    }
     //-----------------Action phiếu mới----------------//
    function click_Phieumoi() {
        var MADH_GCSOI = $("#MaDonHang_CT").val();
        $.ajax({
            type: "POST",
            async: false,
            url: '@Url.Action("TaoPhieuMoi_Click")',
            data: {
                MADH_GCSOI: MADH_GCSOI,
            },
            beforeSend: function () {
                $(".divLoading").addClass("loading");
            },
        }).done(function (data) {
            $(".divLoading").removeClass("loading");
            if (data.status == 1) {
                $('#custom-tabs-one-home-tab').trigger('click');
                document.getElementById("tab-2").style.display = 'none';
                document.getElementById("tab-1").style.display = 'block';
                $("#MaDonHang_CT").empty();
                $("#MaDonHang_CT").append($('<option/>', { value: " " }).html("--Danh sách đơn hàng gia công sợi --"));
                $("#MaDonHang_CT").trigger("chosen:updated");
            }
            if (data.status == -1)
            {
                notify(data.text, "error");
                //$('#custom-tabs-one-home-tab').trigger('click');
                //document.getElementById("tab-2").style.display = 'none';
                //document.getElementById("tab-1").style.display = 'block';
                //$("#Sohopdong").empty();
                //$("#Sohopdong").append($('<option/>', { value: " " }).html("--Danh sách phiếu chuyển thông tin--"));
                //$("#Sohopdong").trigger("chosen:updated");
            }
            else {
                notify(data.text, "error");
            }


        }).fail(function (errors) {
            console.log(errors);
        });
    }
    function LoadGDDVTH() {
        var IDMADV_TH_ = $("#IDMADV_TH").val();
        var MANV_DONVITH_XACNHAN = $("#MANV_DONVITH_XACNHAN");
        MANV_DONVITH_XACNHAN.empty();
        $.ajax({
            type: "POST",
            async: false,
            url: '@Url.Action("_ListGDDVTH")',
            data: {
                IDMADVTH: IDMADV_TH_,
            },
            success: function (result) {
                $.each(result.obj, function (i, state) {
                    MANV_DONVITH_XACNHAN.append($('<option/>', { value: this.MANV }).html(this.HT));
                });
                MANV_DONVITH_XACNHAN.trigger("chosen:updated");
            }
        });
    }
    
</script>

