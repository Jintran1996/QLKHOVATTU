@{
    var list = ViewBag.List as List<ToolsApp.EntityFramework.VatTu.TABLE_LUUTRU_SOHOADON>;

    //var fileNames = list.FirstOrDefault().TenHinhAnh.Split(';');


    var Username = ViewBag.Username;
    var STT = 1;
}

<table id="myTable" class="table table-bordered">
    <thead>
        <tr>
            <th></th>
            <th width="40px">STT</th>
            <th>SOCTXN</th>
            <th>PO</th>
            <th>Ký hiệu HĐ</th>
            <th>Số hóa đơn</th>
            <th>Ngày HĐ</th>

            <th>Hình ảnh</th>
            <th>File PDF</th>
            <th>Link HĐ</th>
            <th>Ngày khai</th>
            <th>Tờ Khai</th>
            <th>MST</th>
            <th>Xuất xứ</th>
            <th>Ngoại tệ</th>
            <th>Tỷ giá</th>
            <th>Ghi chú</th>
            <th>MANV cập nhật</th>
            <th>NGÀY cập nhật</th>


        </tr>
    </thead>

    <tbody>
        @foreach (var item in list.OrderByDescending(p => p.NGAYCN).Take(100))
        {
        <tr>
            <td>
                <a onclick="Delete('@item.SOCTXN')" class="btn">
                    <i class="far fa-trash-alt" style="color:red" title="Xóa"></i> 
                </a>
            </td>
            <td> @STT </td>
            <td> @item.SOCTXN </td>
            <td> @item.PO </td>
            <td> @item.kyhieuhoadon </td>
            <td> @item.sohoadon </td>
            <td>@(item.NGAYHD?.ToString("dd/MM/yyyy"))</td>
            <td>
                @if (item != null && !string.IsNullOrEmpty(item.TenHinhAnh))
                {
                    var fileNames = item.TenHinhAnh.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
                    foreach (var fileName in fileNames)
                    {
                        var imagePath = $"{ToolsApp.Utilities.Utils.WebConfigKey.Domain}/Upload/{item.Thumuc}/{fileName}";

                        <div style="position: relative; display: inline-block; margin-right: 15px; vertical-align: middle;">

                            <a href="@imagePath" target="_blank">
                                <img src="@imagePath" width="40" style="margin-right:10px; border:1px solid #ccc;" title="@System.IO.Path.GetFileName(imagePath)" />
                            </a>

                            <!-- Nút dấu X dùng FontAwesome (hoặc dùng chữ x nếu không có icon) -->
                            <a onclick="DeleteImageFile('@item.SOCTXN', '@fileName')"
                               style="position: absolute; top: -5px; right: -5px; background: red; color: white; border-radius: 50%; width: 16px; height: 16px; display: flex; align-items: center; justify-content: center; font-size: 10px; cursor: pointer; text-decoration: none;"
                               title="Xóa file này">
                                <i class="fas fa-times"></i>
                            </a>
                        </div>
                    }
                }
                <!-- Thay đổi hàm onclick để kích hoạt ô chọn file ẩn -->
                <a onclick="TriggerImageUpload('@item.SOCTXN')" class="btn" style="vertical-align: middle;">
                    <i class="fas fa-plus" style="color: blue" title="Thêm mới file ảnh"></i>
                </a>

                <!-- Thêm thuộc tính multiple vào cuối thẻ input -->
                <input type="file" id="fileimage_@item.SOCTXN" accept="image/png, image/jpeg, image/jpg" multiple style="display: none;" onchange="UploadImageFile('@item.SOCTXN')" />


            </td>
            <td>

                @if (item != null && !string.IsNullOrEmpty(item.FileNamePDF))
                {
                    var fileNames = item.FileNamePDF.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
                    foreach (var fileName in fileNames)
                    {
                        var PDFPath = $"{ToolsApp.Utilities.Utils.WebConfigKey.Domain}/Upload/{item.Thumuc}/{fileName}";

                        <div style="position: relative; display: inline-block; margin-right: 15px; vertical-align: middle;">
                            <a href="@PDFPath" target="_blank" data-toggle="tooltip" title="@System.IO.Path.GetFileName(PDFPath)">
                                <img src="~/Content/images/pdf-icon.png" width="40" />
                            </a>

                            <!-- Nút dấu X dùng FontAwesome (hoặc dùng chữ x nếu không có icon) -->
                            <a onclick="DeletePDFFile('@item.SOCTXN', '@fileName')"
                               style="position: absolute; top: -5px; right: -5px; background: red; color: white; border-radius: 50%; width: 16px; height: 16px; display: flex; align-items: center; justify-content: center; font-size: 10px; cursor: pointer; text-decoration: none;"
                               title="Xóa file này">
                                <i class="fas fa-times"></i>
                            </a>
                        </div>
                    }
                }
                <!-- Thay đổi hàm onclick để kích hoạt ô chọn file ẩn -->
                <a onclick="TriggerPDFUpload('@item.SOCTXN')" class="btn" style="vertical-align: middle;">
                    <i class="fas fa-plus" style="color: red" title="Thêm mới file PDF"></i>
                </a>

                <!-- Thêm thuộc tính multiple vào cuối thẻ input -->
                <input type="file" id="filepdf_@item.SOCTXN" accept=".pdf" multiple style="display: none;" onchange="UploadPDFFile('@item.SOCTXN')" />
            </td>
            <td>

                @if (item.LinkHD != null || item.LinkHD != "")
                {
                    @*<a target="_blank" href="@item.LinkHD">
                    <i class="fas fa-paper-plane">  Đường dẫn</i>
                </a>*@
                    if (item.LinkHD != null && item.LinkHD != "")
                    {
                        var fileNames = item.LinkHD.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
                        foreach (var fileName in fileNames)
                        {


                            <a href="@fileName" target="_blank" data-toggle="tooltip" title="@System.IO.Path.GetFileName(fileName)">
                                <i class="fas fa-link">  Đường dẫn</i>
                            </a>
                        }
                    }

                }
            </td>
            <td>@(item.NGAYKHAI?.ToString("dd/MM/yyyy"))</td>
            <td> @item.TOKHAI </td>
            <td> @item.MST </td>
            <td> @item.XUATXU </td>
            <td> @item.NgoaiTe </td>
            <td> @item.TyGia_NgoaiTe </td>
            <td> @item.GhiChu </td>
            <td> @item.MANVCN </td>
            <td> @item.NGAYCN </td>
        </tr>
            STT++;


        }
    </tbody>
</table>


