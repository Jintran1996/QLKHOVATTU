    document.getElementById("pdfFile").addEventListener("change", function () {
        let files = this.files;
        let base64Files = [];
        let fileList = document.getElementById("fileList");
        fileList.innerHTML = ""; // Xóa danh sách cũ

        for (let i = 0; i < files.length; i++) {
            let reader = new FileReader();

            // Hiển thị tên file ngay khi chọn
            let li = document.createElement("li");
            li.textContent = files[i].name;
            fileList.appendChild(li);

            // Convert sang base64
            reader.onload = function (e) {
                base64Files.push({
                    name: files[i].name,
                    data: e.target.result
                });

                // Khi tất cả file đã xong thì gán vào hidden input
                if (base64Files.length === files.length) {
                    document.getElementById("FileDataPDFBase64").value = JSON.stringify(base64Files);
                }
            };

            reader.readAsDataURL(files[i]);
        }
    });


