
@{ var locations = ViewBag.locations as List<ToolsApp.EntityFramework.VatTu.VATTU2024_DMKHO>; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tra Cứu Tồn Theo Mã VT</title>
    <link rel="stylesheet" href="~/Content/bootstraptracuuxnk.min.css" />

    <style>
        body {
            background: #f5f7fa;
        }

        .card {
            border-radius: 16px;
        }

        .table thead th {
            background: #0d6efd;
            color: white;
        }
    </style>
</head>

<body>
    <div class="card card-primary card-outline">
        <div class="card-header">
            <h3 class="card-title"><b>📦 TRA CỨU TIẾN ĐỘ MUA HÀNG - MÃ VẬT TƯ</b></h3>
        </div>

        <div class="card-body row">

            <!-- SEARCH BY PHIEU -->
            <div class="col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input search-type" type="radio" name="searchType" value="DK2">
                    <label class="form-check-label"><b>Theo mã phiếu phê duyệt</b> </label>
                </div>
                <input type="text" id="MAPHIEUPDSearch" class="form-control"
                       placeholder="Nhập mã phiếu phê duyệt">
            </div>

            <!-- SEARCH BY MAVT -->
            <div class="col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input search-type" type="radio" name="searchType" value="DK4">
                    <label class="form-check-label"><b>Theo mã vật tư</b></label>
                </div>
                <input type="text" id="MAVTSearch" class="form-control"
                       placeholder="Nhập mã vật tư">
            </div>

            <!-- SEARCH BY DATE -->
            <div class="col-md-4">
                <div class="form-check mb-2">
                    <input class="form-check-input search-type" type="radio" name="searchType" value="DK3" checked>
                    <label class="form-check-label"><b>Theo ngày phê duyệt</b></label>
                </div>

                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><b>Từ ngày</b></span>
                    </div>

                    <input type="date" id="TUNGAYSearch" class="form-control"
                           value="@DateTime.Now.AddDays(-3).ToString("yyyy-MM-dd")">

                    <div class="input-group-prepend">
                        <span class="input-group-text"><b>Đến ngày</b></span>
                    </div>

                    <input type="date" id="DENNGAYSearch" class="form-control"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")">
                </div>
            </div>

            <!-- SEARCH BY WEEK -->
            <div class="col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input search-type" type="radio" name="searchType" value="DK5" >
                    <label class="form-check-label"><b>Theo Tuần</b></label>
                </div>

                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><b>Chọn tuần</b></span>
                    </div>

                    <input type="week"
                           class="form-control"
                           id="weekPicker"
                           name="weekPicker">                 
                </div>
            </div>

        </div>

        <div class="card-body">
            <button class="btn btn-primary" onclick="btnSearch()">
                <i class="fa fa-search"></i> Tra cứu
            </button>
        </div>
    </div>



    <div class="row">
        <div class="col-md-12">
            <div class="card card-primary card-outline">
                <div class="card-header">
                    <h3 class="card-title">
                        <b>Danh sách </b>
                    </h3>
                </div>
                <div class="card-body pad">
                    <div class="row">
                        <div class="col-md-12 table-body table-responsive">

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
@section scripts{
    <script language="javascript" type="text/javascript">
        function CallPrint(strid) {
            var prtContent = document.getElementById(strid);
            var WinPrint = window.open('', '', 'left=0,top=0,width=800,height=900,toolbar=0,scrollbars=0,status=0');
            WinPrint.document.write(prtContent.innerHTML);
            WinPrint.document.close();
            WinPrint.focus();
            WinPrint.print();
            WinPrint.close();
        }

    </script>
    <script type="text/javascript">
        var config_ = {
            '.chosen-select-search': {},
            '.chosen-select-search-deselect': { allow_single_deselect: true },
            '.chosen-select-search-no-single': { disable_search_threshold: 10 },
            '.chosen-select-search-no-results': { no_results_text: 'Oops, nothing found!' },
            '.chosen-select-search-width': { width: "95%" },
            'search_contains': true
        }
        for (var selector in config_) {
            $(selector).chosen(config_);
        }

    </script>

    <script type="text/javascript">

        function btnSearch() {
           // GetList();
            reloadData(false);
        }

        // Getlist tạm ko sử dụng //
        function GetList() {
            try {
            $.ajax({
                url: '@Url.Action("GetList")',
                type: "POST",
                data: {
                    MAVTSearch: $("#MAVTSearch").val(),

                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status < 0) {
                        notify(result.text, "error");
                        $(".divLoading").removeClass("loading");
                    }
                    else {
                        $('.table-body').html(result);
                        $("#myTable").DataTable({
                            destroy: true,
                            "language": {
                                "sProcessing": "Đang xử lý...",
                                "sLengthMenu": " Hiển thị _MENU_ dữ liệu",
                                "sZeroRecords": "Không tìm thấy kết quả",
                                "sEmptyTable": "Không có dữ liệu",
                                "sInfo": "Hiển thị _START_ tới _END_ của _TOTAL_ dữ liệu",
                                "sInfoEmpty": "Hiển thị 0 tới 0 của 0 dữ liệu",
                                "sInfoFiltered": "(được lọc từ _MAX_ dữ liệu)",
                                "sInfoPostFix": "",
                                "sSearch": "Tìm kiếm:",
                                "sUrl": "",
                                "sInfoThousands": ",",
                                "sLoadingRecords": "Đang tải...",
                                "oPaginate": {
                                    "sFirst": "Đầu tiên",
                                    "sLast": "Cuối cùng",
                                    "sNext": "Sau",
                                    "sPrevious": "Trước"
                                },
                                "oAria": {
                                    "sSortAscending": ":Sắp xếp thứ tự tăng dần",
                                    "sSortDescending": ": Sắp xếp thứ tự giảm dần"
                                }
                            },
                            "lengthMenu": [25, 50, 75, 100],
                            "info": false,
                            "processing": false,
                            "serverSide": false,
                            "bFilter": true,
                            "bPaginate": true,
                            "bLengthChange": true,
                            "bInfo": true,
                            "responsive": true,
                            "lengthChange": true,
                            "autoWidth": false,
                            "stateSave": true,
                            "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                            "initComplete": function (oSettings) {

                            }
                        });
                        $(".divLoading").removeClass("loading");
                    }
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });

            } catch (e) {
            }
        }
        ///... End Getlist ////

     function reloadData(isDelete) {
            let weekValue = $("#weekPicker").val();
            var searchType = $('input[name="searchType"]:checked').val();
        try {
            $.ajax({
                url: '@Url.Action("GetList")',
                timeout: 2000000,
                type: "POST",
                data: {
                    searchType: searchType,
                    MAPHIEUPDSearch: $("#MAPHIEUPDSearch").val(),
                    MAVTSearch: $("#MAVTSearch").val(),
                    TUNGAY_: $("#TUNGAYSearch").val(),
                    DENNGAY_: $("#DENNGAYSearch").val(),
                    weekValue: weekValue,

                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body').html(response);

                    // Hủy tất cả các DataTable cũ nếu tồn tại
                    $('.table').each(function () {
                        if ($.fn.DataTable.isDataTable(this)) {
                            $(this).DataTable().destroy(); // Phá hủy DataTable cũ
                        }
                    });

                    $('.table').each(function (index) {
                        console.log(index);
                        $(this).attr('id', 'myTable_' + (index + 1)); // Thêm ID động
                        $(this).DataTable({
                            responsive: true,
                            lengthChange: true,
                            autoWidth: false,
                            stateSave: true,
                            buttons: [                          
                                {
                                    extend: 'excelHtml5',
                                    text: 'Xuất Excel',
                                    title: null, // Không thêm tiêu đề vào file xuất
                                    exportOptions: {
                                        columns: ':visible', // Chỉ xuất các cột đang hiển thị
                                    }
                                },
                                {
                                    extend: 'print',
                                    text: 'In Danh sách',
                                    title: 'Tra Cứu Tiến Độ Mua Hàng', // Không thêm tiêu đề khi in
                                    exportOptions: {
                                        columns: ':visible',
                                    }
                                },
                                {
                                    extend: 'colvis',
                                    text: 'Cột ẩn / hiện',                                 
                                },


                               

                            ],

                            initComplete: function (oSettings) {
                                // Thêm logic nếu cần khi DataTable đã khởi tạo
                            }
                        }).buttons().container().appendTo('#myTable_' + (index + 1) + '_wrapper .col-md-6:eq(0)');


                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }


            });
            } catch (e) {
            }
        }






        // Hàm bỏ dấu tiếng Việt
        function toNoUnicode(str) {
            return str.normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/đ/g, "d").replace(/Đ/g, "D")
                .toLowerCase();
        }


    </script>

    <script type="text/javascript">

        $(document).ready(function () {
            reloadData(false);
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function () {
          
        });
    </script>


}