                <div class="modal-footer">
                    <div class="text-right">
                        <button id="btnPrint" onclick="javascript:CallPrint('print_socai');" type="button" title="In báo cáo" class="btn bg-gradient-indigo"><i class="fa fa-print"></i>&nbsp;In</button>
