    <script>
        var $modalPrint = $('#myModalPrint');
        var $myModalContentPrint = $("#myModalContentPrint");
        var $myModalTitleDT = $("#myModalTitlePrint");

        function Print() {
            var SOCTVT_ = $("#SOCTVT").val();
            $.ajax({
                url: '@Url.Action("_PrintReport")',
                timeout: 20000,
                data: {
                    SOCTVT: SOCTVT_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                    success: function (result) {
                        if (result.status < 0) {
                            notify(result.text, "error");
                            $(".divLoading").removeClass("loading");
                        }
                        else {
