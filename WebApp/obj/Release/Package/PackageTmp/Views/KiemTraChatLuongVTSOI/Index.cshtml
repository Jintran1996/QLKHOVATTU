        function PrintKS() {
            var SOCTXN_ = $("#SOCTXN").val();
            $.ajax({
                url: '@Url.Action("_PrintReportKS")',
                timeout: 20000,
                data: {
                    SOCTXN: SOCTXN_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                    success: function (result) {
                        if (result.status < 0) {
                            notify(result.text, "error");
                            $(".divLoading").removeClass("loading");
                        }
                        else {
                            $myModalContentPrint.html(result);
                            $modalPrint.modal();
                            $(".divLoading").removeClass("loading");
                        }
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

