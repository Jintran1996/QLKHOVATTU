@using System.Globalization;
@{
    var url = ViewData["URL_IMAGE"];
    var list = ViewBag.inVT as List<ToolsApp.EntityFramework.VatTu.SP_CRCHATLUONG_NEW_Result>;
    var vchukyGDDV = ViewBag.Base64ImageGDDV;
    var vchukyThuKho = ViewBag.Base64ImageThuKho;
    var SOCTPrint = (list.Count > 0 ? list[0].SOCT : "");
    var STT = 1;
}

<head>
<style>
/* ================== PAGE SETUP ================== */
@@page {
    size: A4;
    margin: 12mm;
}

/* ================== PRINT BASE ================== */
@@media print {

    html, body {
        width: 210mm;
        height: 297mm;
        margin: 0;
        padding: 0;
        font-family: "Times New Roman", Times, serif;
        font-size: 13px;
        color: #000;
        background: #fff;
    }

    /* ================== RESET BOOTSTRAP ================== */
    .row,
    .col-md-12,
    .container,
    .container-fluid,
    .card,
    .card-body {
        margin: 0 !important;
        padding: 0 !important;
        max-width: 100% !important;
    }

    /* ================== TABLE CORE ================== */
    table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        page-break-inside: auto;
    }

    th, td {
        border: 1px solid #000;
        padding: 4px 6px;
        vertical-align: top;
        word-break: break-word;
        white-space: normal;
        line-height: 1.3;
    }

    th {
        text-align: center;
        font-weight: bold;
    }

    /* ================== ROW CONTROL ================== */
    tr {
        page-break-inside: avoid;
        page-break-after: auto;
    }

    /* ================== IMAGE ================== */
    img {
        max-width: 100%;
        height: auto;
    }

    /* ================== FOOTER ================== */
    .print-footer {
        page-break-before: always;
        margin-top: 20mm;
        text-align: center;
        page-break-inside: avoid;
    }

    /* ================== UTIL ================== */
    .text-center {
        text-align: center;
    }
}
    </style>
</head>



<div class="row" style="margin-top: 2px">
    <div class="col-md-12">
        <div class="card card-primary">
            <div class="card-body pad" style="font-family: 'Times New Roman', Times, serif;" id="print_socai">

                <!-------------------------------------phần header------------------------------------------>
                <div class="print-header row" style="margin-bottom:5px">
                    <table>
                        <colgroup>
                            <col style="width:20%" />
                            <col style="width:30%" />
                            <col style="width:10%" />
                            <col style="width:10%" />
                            <col style="width:30%" />
                        </colgroup>
                        <tr>
                            <td style="text-align:center">
                                <img src="@url/Content/images/ThaiTuan.png" style="width:85%;" />
                            </td>
                            <th style="text-align:left" colspan="3" width="750px">
                                <span> BM02/QI13</span><br />
                                <h4 style="text-align:center"><b>PHIẾU KIỂM TRA NGUYÊN NHIÊN VẬT LIỆU ĐẦU VÀO</b></h4>
                            </th>
                            <th style="width:250px; text-align:left; vertical-align:top; padding:0.6rem;" colspan="2">
                                <div style="margin-bottom:0.6rem;">
                                    <strong>Số CT:</strong>
                                    <span>@(list.Count > 0 ? list[0].SOCT : "")</span>
                                    <input type="hidden" id="SOCTPrint" value="@SOCTPrint" />
                                </div>

                                <div>
                                    <strong>Số PO:</strong>
                                    <span>@(list.Count > 0 ? list[0].SOPO : "")</span>
                                </div>
                            </th>

                        </tr>
                    </table>
                </div>

                <div class="print-body row">
                    <table>
                        <colgroup>
                            <col style="width:10%" />
                            <col style="width:38%" />
                            <col style="width:10%" />
                            <col style="width:12%" />
                            <col style="width:30%" />
                        </colgroup>

                        <tr style="text-align:center" class="table-header">
                            <th width="40px">STT</th>
                            <th colspan="2" width="250px">Thông tin về sản phẩm</th>
                            <th width="60px">Số lượng</th>
                            <th width="120px">Kiểm tra ngoại quan kho</th>
                            <th width="250px">
                                Phần Đ.Vị kiểm tra chất lượng/Tiêu chuẩn kỹ thuật nhập kho
                            </th>
                        </tr>

                        <tbody>
                            @foreach (var item in list)
                            {
                                <tr>
                                    <td rowspan="2" style="text-align:center; vertical-align:middle;">@STT</td>

                                    <td colspan="2">
                                        <p style="text-align: left; padding: 0.5rem 0rem 0rem 0.5rem">Mã SP: <b>@item.MAVT</b></p>
                                        <p style="text-align: left; padding: 0rem 0rem 0rem 0.5rem">Tên SP: @item.TENVT</p>
                                        <p style="text-align: left; padding: 0rem 0rem 0rem 0.5rem">ĐVT: @item.DVT</p>
                                        <p style="text-align: left; padding: 0rem 0rem 0rem 0.5rem">Mã phiếu PD: <b>@item.MAPHIEUPD</b></p>
                                        <p style="text-align: left; padding: 0rem 0rem 0.5rem 0.5rem">Họ tên NLP :: @item.HOTENNLP</p>
                                    </td>
                                    <td style="padding: 0rem 0.5rem 0rem 0rem; text-align: center; vertical-align: middle">@item.THUC</td>
                                    <td style="text-align: left; padding: 0rem 0rem 0rem 0.5rem">Tình trạng: @item.KHOKIEMTRA</td>
                                    <td>
                                        <p style="text-align: left; padding: 0rem 0rem 0rem 0.5rem">Dạng lỗi:........................................</p>
                                        <p style="text-align: left; padding: 0rem 0rem 0rem 0.5rem">Kết quả:.....@item.DANGLOI .....</p>
                                        <p style="text-align: left; padding: 0rem 0rem 0rem 0.5rem">Nhận/Loại.....@item.LOAI .....</p>
                                        <p style="text-align: left; padding: 0rem 0rem 0rem 0.5rem">NV kiểm tra:....@item.HOTENNGUOIKT .....</p>
                                    </td>
                                </tr>

                                <tr style="border-top:1px dashed #000;">
                                    <!-- CỘT TRÁI -->
                                    @*  <td style="text-align:center"></td>*@
                                    <td style="width:50%" colspan="2">
                                        <b>Thông tin NCC:</b><br />
                                        <p style="text-align: left; padding: 0rem 0rem 0rem 0.5rem">Tên SP NCC: @item.TENVATTU_NCC</p>
                                        <p style="text-align: left; padding: 0rem 0rem 0rem 0.5rem">ĐVT NCC: @item.DVT_NCC</p>

                                    </td>
                                    <td style="padding: 0rem 0.5rem 0rem 0rem; text-align: center; vertical-align: middle">@item.SOLUONGNCC</td>


                                    <!-- CỘT GIỮA -->
                                    <td style="width:25%" colspan="2">
                                        <p style="text-align: left; padding: 0rem 0rem 0rem 0.5rem"><b>Số hóa đơn: </b>@item.SOCTKETOAN<br /><br /></p>
                                        <p style="text-align: left; padding: 0rem 0rem 0rem 0.5rem"><b>Ngày:</b> @item.NGAYKETOAN</p>
                                    </td>

                                </tr>
                                STT++;
                            }

                        </tbody>
                    </table>
                </div>

                <div class="print-footer row">
                    <table>
                        <colgroup>
                            <col style="width:10%" />
                            <col style="width:38%" />
                            <col style="width:10%" />
                            <col style="width:12%" />
                            <col style="width:30%" />
                        </colgroup>
                        <tr>
                            <td style="text-align: center; vertical-align: middle" colspan="3">
                                <p>Ngày kho kiểm tra:<b>@(list.Count <= 0 ? "" : list[0].NGAYKHO)</b></p>
                                <p style="padding-bottom:10px">Thủ kho: </p>
                                <img src="@vchukyThuKho" style="max-height: 80px;" />
                                <p>Họ và Tên: <b>@(list.Count <=0 ? "" : list[0].HOTENTHUKHO)</b></p>
                            </td>
                            <td style="text-align: center; vertical-align: middle" colspan="3">
                                <p>Ngày đơn vị kiểm tra:</p>
                                <p style="padding-bottom:10px">Ban GĐ Đơn vị: </p>
                                <img src="@vchukyGDDV" style="max-height: 80px;" />
                                <p>Họ và Tên: <b>@(list.Count <=0 ? "" : list[0].GIAMDOC)</b></p>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>












