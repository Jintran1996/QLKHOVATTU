@section scripts{
    <script type="text/javascript">
        var config = {
            '.chosen-select-search': {},
            '.chosen-select-search-deselect': { allow_single_deselect: true },
            '.chosen-select-search-no-single': { disable_search_threshold: 10 },
            '.chosen-select-search-no-results': { no_results_text: 'Oops, nothing found!' },
            '.chosen-select-search-width': { width: "95%" },
            'search_contains': true
        }
        for (var selector in config) {
            $(selector).chosen(config);
        }
    </script>
    <script language="javascript" type="text/javascript">
        function CallPrint(strid) {
            var prtContent = document.getElementById(strid);
            var WinPrint = window.open('', '', 'left=0,top=0,width=800,height=900,toolbar=0,scrollbars=0,status=0');
            WinPrint.document.write(prtContent.innerHTML);
            WinPrint.document.close();
            WinPrint.focus();
            WinPrint.print();
            WinPrint.close();
        }


    </script>

    <script>
        function reloadData(page) {
            try {
                _insert_nhapkho();
                reloadData_getlist();

            } catch (e) {
            }
        }
        function reloadData_getlist(isDelete) {
            var Search_ = $('#SOCTXNSearch').val();
            try {
            $.ajax({
                url: '@Url.Action("_GetList")',
                timeout: 20000,
                data: {
                    SOCTXNSearch: Search_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-khoxn').html(response);

                    $("#myTable").DataTable({
                        //"responsive": true,
                        "lengthChange": true,
                        "autoWidth": true,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
        }
        function _insert_nhapkho() {
            $.ajax({
                url: '@Url.Action("_Insert")',
                timeout: 20000,
                data: {
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-insert-nhapkho').html(response);


                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }


    </script>

    <script type="text/javascript">
        var $modal = $('#myModal');
        var $myModalContent = $("#myModalContent");
        var $myModalTitle = $("#myModalTitle");

        var $modalUpload = $('#myModalUpload');
        var $myModalContentUpload = $("#myModalContentUpload");
        var $myModalTitleUpload = $("#myModalTitleUpload");

        var $modalDetail = $('#myModalDetail');
        var $myModalContentDetail = $("#myModalContentDetail");
        var $myModalTitleDetail = $("#myModalTitleDetail");

        var $modalEditct = $('#myModalEditct');
        var $myModalContentEditct = $("#myModalContentEditct");
        var $myModalTitleEditct = $("#myModalTitleEditct");

        //form in
        var $modalPrint = $('#myModalPrint');
        var $myModalContentPrint = $("#myModalContentPrint");
        var $myModalTitlePrint = $("#myModalTitlePrint");

        var $modalDienGiai = $('#myModalDienGiai');
        var $myModalContentDienGiai = $("#myModalContentDienGiai");
        var $myModalTitleDienGiai = $("#myModalTitleDienGiai");

        var $modalPrint_Diengiai = $('#myModalPrint_Diengiai');
        var $myModalContentPrint_Diengiai = $("#myModalContentPrint_Diengiai");
        var $myModalTitlePrint_Diengiai = $("#myModalTitlePrint_Diengiai");

        $(document).ready(function () {
            reloadData(false);

            $("#myModal").on("hidden.bs.modal", function () {
                reloadData(false);
            });

            $("#btnSearch").click(function () {
                reloadData_getlist(true);
            });

            $("#btSavect").click(function () {
            var eSOHOADON = $("#eSOHOADON").val();
            var eNGAYCT = $("#eNGAYCT").val();
            var eSOLUONGTT = $("#eSOLUONGTT").val();
            var eGHICHU = $("#eGHICHU").val();
            var eID_XN = $("#eID_XN").val();
            var eKHOAKEYXN = $("#eKHOAKEYXN").val();
            var eSOCTXN = $("#eSOCTXN").val();
            var eLOAIXN = $("#eLOAIXN").val();
                   var eLO = $("#eLO").val();
                var eHIEU = $("#eHIEU").val();
            $.ajax({
                url: '@Url.Action("_ActionUpdateCTPhieu_NK")',
                type: "POST",
                data: {
                    SOCTXN: eSOCTXN,
                    SOHOADON: eSOHOADON,
                    NGAYCT_: eNGAYCT,
                    SOLUONGTT: eSOLUONGTT,
                    GHICHU: eGHICHU,
                    ID_XN: eID_XN,
                    KHOAKEYXN: eKHOAKEYXN,
                    LOAIXN: eLOAIXN,
                    LO: eLO,
                    HIEU: eHIEU,
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status >= 1) {
                        notify(result.text, "success");
                       // Details(result.obj, result.obj2);
                    }
                    else {
                        notify(result.text, "error");
                    }
                    $('#closectphieuedit').trigger('click');
                    reloadData_getlist_ctphieu(eSOCTXN);
                    $(".divLoading").removeClass("loading");


                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        });

            $("#btSaveInsert").click(function () {
                form = $("#frmInsert");
                form.removeData('validator');
                form.removeData('unobtrusiveValidation');
                $.validator.unobtrusive.parse("#frmInsert");
                if (form.valid()) {
                    $.ajax({
                        url: '@Url.Action("_InsertFun")' ,
                        type: "POST",
                        data: $('#frmInsert').serialize(),
                        beforeSend: function (xhr) {
                            $(".divLoading").addClass("loading");
                        },
                        success: function (result) {
                            if (result.status >= 1) {
                                notify(result.text, "success");
                                reloadData(true);
                            }
                            else {
                                notify(result.text, "error");
                            }
                            $(".divLoading").removeClass("loading");

                        },
                        error: function (message) {
                            $(".divLoading").removeClass("loading");
                        }
                    });
                }
            });


            /// End document  //
        });

        function TransAPI(SOCTXN_, MAHTHUC_) {
            var confirm_ = confirm('Bạn có chắc chuyển thông tin này đến Netsuite theo số phiếu này?' + SOCTXN_);
            if (confirm_) {
                $.ajax({
                    url: '@Url.Action("_TransAPI")',
                    timeout: 200000,
                    type: "POST",
                    data: {
                        SOCTXN: SOCTXN_, MAHINHTHUC: MAHTHUC_,
                        KEY: "1"
                    },
                    beforeSend: function () {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {

                        if (result.status >= 1) {
                            notify(result.text, "success");

                        }
                        else {
                            notify(result.text, "error");
                        }
                        reloadData();
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
        }

        function Details(SOCTXN_,MAHTHUC_) {
            $myModalContentDetail.html("");
            $myModalTitleDetail.html("Chi tiết");
            $.ajax({
                url: '@Url.Action("_GetListCTPhieu")',
                timeout: 200000,
                data: {
                    SOCTXN: SOCTXN_,  MAHTHUC: MAHTHUC_,
                    KEY: "1"
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    $myModalContentDetail.html(result);
                    $modalDetail.modal();

                    $(".divLoading").removeClass("loading");

                },
                failure: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function EditCt(ID_XN_, SOCTXN_) {
            $myModalContentEditct.html("");
            $myModalTitleEditct.html("Hiệu Chỉnh");
            $.ajax({
                url: '@Url.Action("_UpdateCTPhieu_NK")',
                timeout: 200000,
                data: {
                    ID_XN: ID_XN_, SOCTXN: SOCTXN_
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    $myModalContentEditct.html(result);
                    $modalEditct.modal();
                    $(".divLoading").removeClass("loading");
                },
                failure: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function DeletectALL(SOCTXN_,MAHTHUC_) {
            var confirm_ = confirm('Bạn có chắc muốn xóa tất cả theo số phiếu này?' + SOCTXN_);

             if (confirm_) {
                 $.ajax({
                     url: '@Url.Action("_DeleteALLFun")',
                     timeout: 2000000,
                     type: "POST",
                     data: { SOCTXN: SOCTXN_ },
                     beforeSend: function (xhr) {
                         $(".divLoading").addClass("loading");
                     },
                     success: function (result) {

                         if (result.status >= 1) {
                             notify(result.text, "success");
                             Details(SOCTXN_, MAHTHUC_);
                         }
                         else {
                             notify(result.text, "error");
                             $(".divLoading").removeClass("loading");
                         }

                     },
                     error: function (message) {
                         $(".divLoading").removeClass("loading");
                     }
                 });
             }
        }

        function DienGiai(SOCTXN_, KHOAKEYXN_, MAVT_) {
            $myModalContentDienGiai.html("");
            $myModalTitleDienGiai.html("Diễn giải");
            $.ajax({
                url: '@Url.Action("_DienGiaiView")',
                timeout: 200000,
                data: {
                    SOCTXN: SOCTXN_, KHOAKEYXN: KHOAKEYXN_, MAVT: MAVT_,
                    KEY: "1"
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    $myModalContentDienGiai.html(result);
                    $modalDienGiai.modal();

                    $(".divLoading").removeClass("loading");
                },
                failure: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function reloadData_getlist_ctphieu(SOCTXN_) {
            var SOCTXN_ = (SOCTXN_ == null || SOCTXN_ == "") ? $("#SophieuN_CT").val() : SOCTXN_;

            try {
            $.ajax({
                url: '@Url.Action("_GetListCTPhieu_View")',
                timeout: 20000,
                data: {
                    SOCTXN: SOCTXN_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-view-ctphieu').html(response);

                    $("#myTablectview").DataTable({
                        //"responsive": true,
                        "lengthChange": true,
                        "autoWidth": true,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
    }

        function Deletect(Khoa_, SOCTXN_, MAHTHUC_) {
            var confirm_ = confirm('Bạn có chắc muốn xóa mã hàng này?' + Khoa_);
             if (confirm_) {
                 $.ajax({
                     url: '@Url.Action("_DeletectFun")',
                     timeout: 2000000,
                     type: "POST",
                     data: { Khoa: Khoa_ },
                     beforeSend: function (xhr) {
                         $(".divLoading").addClass("loading");
                     },
                     success: function (result) {

                         if (result.status >= 1) {
                             notify(result.text, "success");
                             Details(SOCTXN_, MAHTHUC_);
                         }
                         else {
                             notify(result.text, "error");
                         }
                         $(".divLoading").removeClass("loading");
                     },
                     error: function (message) {
                         $(".divLoading").removeClass("loading");
                     }
                 });
             }
        }

        function Print(SOCTXN_) {
             $.ajax({
                url: '@Url.Action("_ReportPrint")',
                timeout: 20000,
                type: "GET",
                 data: {
                     SOCTXN: SOCTXN_,
                 },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                 success: function (result) {
                     if (result.status < 0) {
                         notify(result.text, "error");
                     }
                     else {
                         console.log(result);

                         $myModalContentPrint.html(result);
                         $modalPrint.modal();

                     }
                     $(".divLoading").removeClass("loading");
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function Delete(SOCTXN_) {
            var confirm_ = confirm('Bạn có chắc muốn xóa số phiếu này?' + SOCTXN_);
             if (confirm_) {
                 $.ajax({
                     url: '@Url.Action("_DeleteFun")',
                     timeout: 2000000,
                     type: "POST",
                     data: { SOCTXN: SOCTXN_ },
                     beforeSend: function (xhr) {
                         $(".divLoading").addClass("loading");
                     },
                     success: function (result) {

                         if (result.status >= 1) {
                             notify(result.text, "success");
                             reloadData_getlist(false);
                         }
                         else {
                             notify(result.text, "error");
                         }
                         $(".divLoading").removeClass("loading");
                     },
                     error: function (message) {
                         $(".divLoading").removeClass("loading");
                     }
                 });
             }
        }




    </script>
