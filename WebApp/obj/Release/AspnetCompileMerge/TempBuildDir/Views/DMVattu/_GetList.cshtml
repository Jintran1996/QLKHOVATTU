@{
    var list = ViewBag.List as List<ToolsApp.EntityFramework.VatTu.DANHMUCVATTU>;
    var Username = ViewBag.Username;
    var STT = 1;
}

<table id="myTable" class="table table-bordered">
    <thead>
        <tr>
            <th></th>
            <th width="40px">STT</th>
            <th>Mã vật tư</th>
            <th>Tên vật tư</th>
            <th>Loại vật tư</th>
            <th>Mã nhóm</th>
            <th>Đơn vị tính</th>
            <th>Đơn vị sử dụng</th>
            <th>Hình ảnh</th>
            <th>Hiệu lực</th>
            <th>IsAPI</th>


        </tr>
    </thead>

    <tbody>
        @foreach (var item in list.Take(100))
        {
        <tr>
            <td width="133px">

                <a onclick="btnDongBo('@item.MAVT')" class="btn">
                    <i class="fas fa-recycle"></i> Đồng bộ
                </a>
                <a onclick="OpenUploadImage('@item.MAVT')" class="btn">
                    <i class="fas fa-image"></i> Tải ảnh lên
                </a>

                @if (item.GuiAPI == "1")
                {

                }
                else
                {
                    <a onclick="Delete('@item.MAVT')" class="btn">
                        <i class="far fa-trash-alt"></i> Xóa
                    </a>
                }
            </td>
            <td> @STT </td>
            <td> @item.MAVT </td>
            <td> @item.TenVT </td>
            <td> @item.LoaiVT </td>
            <td> @item.Manhom </td>
            <td>@item.DVT</td>
            <td>@item.DonViSuDungtac</td>
            <td>
                @if (item != null && !string.IsNullOrEmpty(item.Images_v2))
                {
                    var fileNames = item.Images_v2.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries);
                    foreach (var fileName in fileNames)
                    {
                        var imagePath = $"{ToolsApp.Utilities.Utils.WebConfigKey.Domain}/materials_images/{fileName}";

                        <a href="@imagePath" target="_blank">
                            <img src="@imagePath" width="40" style="margin-right:10px; border:1px solid #ccc;" />
                        </a>
                    }
                }

            </td>

            <td style="text-align: center; font-size: 24px;">
                @if (@item.HieuLuc == true)
                {

                    <i class="fa fa-check" style="color: springgreen;"></i>
                }
                else
                {

                    <i class="fa fa-ban" style="color: red"></i>
                }
            </td>
            <td style="text-align: center; font-size: 24px;">
                @if (item.GuiAPI == "1")
                {

                    <i class="fa fa-check" style="color: springgreen;font-size: 24px;"></i>
                }
                else
                {


                }
            </td>

        </tr>
            STT++;


        }
    </tbody>
</table>