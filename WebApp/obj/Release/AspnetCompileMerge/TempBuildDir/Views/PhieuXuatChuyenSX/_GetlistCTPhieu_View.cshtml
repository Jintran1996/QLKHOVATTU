


@{
    var Lists = ViewBag.List as IEnumerable<ToolsApp.EntityFramework.KhoSoi.NL_CTPHIEUNHAP_CHUYEN>;

}

<table id="myTablectview" class="table table-bordered table-striped">
    <thead>
        <tr>
        
            <th style="text-align:center">.No</th>
            <th>SOCT Nhập</th>
            <th>SOCT Xuất</th>
            <th>MAVT</th>
            <th>Hiệu</th>
            <th>Lô</th>
            <th>Mã đơn hàng</th>
            <th>Số Lượng Xuất</th>
            <th>Ghi chú</th>
        </tr>
    </thead>
    <tbody>
        @{ var STT = 1; }
        @foreach (var item in Lists)
        {
            <tr>
            
                <td style="text-align:center">
                    @STT
                </td>
                <td>@item.SOCTNHAP</td>
                <td>@item.SOCTXUAT</td>
                <td>@item.MAVT</td>
                <td>@item.HIEU</td>
                <td>@item.LO</td>
                <td>@item.MADH</td>
                <td>@item.SOLUONGXUAT</td>
                <td>@item.GHICHU</td>


            </tr>

            STT++;
        }
    </tbody>
</table>