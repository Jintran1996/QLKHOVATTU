
@{ var locations = ViewBag.locations as List<ToolsApp.EntityFramework.VatTu.VATTU2024_DMKHO>;
    //int STT = 1; }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tra Cứu Tồn – Xuất – Nhập Kho</title>
    <link rel="stylesheet" href="~/Content/bootstraptracuuxnk.min.css" />
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script>
        $(".select2").select2();
    </script>

    <style>
        body {
            background: #f5f7fa;
        }

        .card {
            border-radius: 16px;
        }

        .table thead th {
            background: #0d6efd;
            color: white;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <h3 class="mb-4 fw-bold text-primary">📦 TRA CỨU TỒN CUỐI - VẬT TƯ</h3>
        <!-- Bộ lọc -->
        <div class="card shadow-sm mb-4">           
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Mã Kho</label>
                        <select id="MAKHOSEARCH" name="MAKHOSEARCH" class="form-control select2-kho" multiple size="6">
                            @foreach (var kho in locations)
                            {
                               <option value="@kho.MAKHO">@kho.MAKHO</option>
                            }
                        </select>
                    </div>         
                    <div class="col-md-4">
                        <label class="form-label">Từ ngày</label>
                        <input type="date" id="TUNGAY" class="form-control"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")"
                               placeholder="dd/mm/yyyy" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Đến ngày</label>
                        <input type="date" id="DENNGAY" class="form-control"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")"
                               placeholder="dd/mm/yyyy" />
                    </div>
                </div>
                <div class="mt-3 text-end">
                    <button onclick="btnSearch()" class="btn btn-primary px-4">🔍 Tra cứu</button>
               @*     <button onclick="btnExportExcel()" class="btn btn-success px-4 ms-2">⬇ Xuất Excel</button>*@
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card card-primary card-outline">
                <div class="card-header">
                    <h3 class="card-title">
                        <b>Danh mục xuất nhập kho</b>
                    </h3>
                </div>
                <div class="card-body pad">
                    <div class="row">
                        <div class="col-md-12 table-body table-responsive">

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
@section scripts{
    <script language="javascript" type="text/javascript">
        function CallPrint(strid) {
            var prtContent = document.getElementById(strid);
            var WinPrint = window.open('', '', 'left=0,top=0,width=800,height=900,toolbar=0,scrollbars=0,status=0');
            WinPrint.document.write(prtContent.innerHTML);
            WinPrint.document.close();
            WinPrint.focus();
            WinPrint.print();
            WinPrint.close();
        }

    </script>

    <script type="text/javascript">

        function btnSearch() {
           // GetList();
            reloadData(false);
        }
        function GetList() {
            try {
            $.ajax({
                url: '@Url.Action("GetList")',
                type: "POST",
                data: {
                    MAKHOSEARCH_: $("#MAKHOSEARCH").val(),
                    MAVTSearch: $("#MAVTSearch").val(),
                    TUNGAY_: $("#TUNGAY").val(),
                    DENNGAY_: $("#DENNGAY").val()
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status < 0) {
                        notify(result.text, "error");
                        $(".divLoading").removeClass("loading");
                    }
                    else {
                        $('.table-body').html(result);
                        $("#myTable").DataTable({
                            destroy: true,
                            "language": {
                                "sProcessing": "Đang xử lý...",
                                "sLengthMenu": " Hiển thị _MENU_ dữ liệu",
                                "sZeroRecords": "Không tìm thấy kết quả",
                                "sEmptyTable": "Không có dữ liệu",
                                "sInfo": "Hiển thị _START_ tới _END_ của _TOTAL_ dữ liệu",
                                "sInfoEmpty": "Hiển thị 0 tới 0 của 0 dữ liệu",
                                "sInfoFiltered": "(được lọc từ _MAX_ dữ liệu)",
                                "sInfoPostFix": "",
                                "sSearch": "Tìm kiếm:",
                                "sUrl": "",
                                "sInfoThousands": ",",
                                "sLoadingRecords": "Đang tải...",
                                "oPaginate": {
                                    "sFirst": "Đầu tiên",
                                    "sLast": "Cuối cùng",
                                    "sNext": "Sau",
                                    "sPrevious": "Trước"
                                },
                                "oAria": {
                                    "sSortAscending": ":Sắp xếp thứ tự tăng dần",
                                    "sSortDescending": ": Sắp xếp thứ tự giảm dần"
                                }
                            },
                            "lengthMenu": [25, 50, 75, 100],
                            "info": false,
                            "processing": false,
                            "serverSide": false,
                            "bFilter": true,
                            "bPaginate": true,
                            "bLengthChange": true,
                            "bInfo": true,
                            "responsive": true,
                            "lengthChange": true,
                            "autoWidth": false,
                            "stateSave": true,
                            "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                            "initComplete": function (oSettings) {

                            }
                        });
                        $(".divLoading").removeClass("loading");
                    }
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });

            } catch (e) {
            }
        }


    function reloadData(isDelete) {
        try {
            $.ajax({
                url: '@Url.Action("GetList")',
                timeout: 2000000,
                type: "POST",
                data: {
                    MAKHOSEARCH_: $("#MAKHOSEARCH").val(),
                    TUNGAY_: $("#TUNGAY").val(),
                    DENNGAY_: $("#DENNGAY").val()
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body').html(response);

                    // Hủy tất cả các DataTable cũ nếu tồn tại
                    $('.table').each(function () {
                        if ($.fn.DataTable.isDataTable(this)) {
                            $(this).DataTable().destroy(); // Phá hủy DataTable cũ
                        }
                    });

                    $('.table').each(function (index) {
                        $(this).attr('id', 'myTable_' + (index + 1)); // Thêm ID động
                        $(this).DataTable({
                            responsive: true,
                            lengthChange: true,
                            autoWidth: false,
                            stateSave: true,
                            buttons: [
                                {
                                    extend: 'csvHtml5',
                                    text: 'CSV',
                                    title: null, // Không thêm tiêu đề vào file xuất
                                    exportOptions: {
                                        columns: ':visible', // Chỉ xuất các cột đang hiển thị
                                    }
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: 'Excel',
                                    title: null, // Không thêm tiêu đề vào file xuất
                                    exportOptions: {
                                        columns: ':visible', // Chỉ xuất các cột đang hiển thị
                                    }
                                },                             
                                {
                                    extend: 'print',
                                    text: 'Print',
                                    title: 'Tra Cứu Phiếu Xuất – Nhập Kho', // Không thêm tiêu đề khi in
                                    exportOptions: {
                                        columns: ':visible',
                                    }
                                },
                                "colvis"
                                
                            ],
                            initComplete: function (oSettings) {
                                // Thêm logic nếu cần khi DataTable đã khởi tạo
                            }
                        }).buttons().container().appendTo('#myTable_' + (index + 1) + '_wrapper .col-md-6:eq(0)');
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
        }

        // Hàm bỏ dấu tiếng Việt
        function toNoUnicode(str) {
            return str.normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/đ/g, "d").replace(/Đ/g, "D")
                .toLowerCase();
        }

    </script>

    <script type="text/javascript">

        $(document).ready(function () {
            reloadData(false);
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            $.fn.select2.amd.require(['select2/compat/matcher'], function (oldMatcher) {
                $(".select2-kho").select2({
                    width: "100%",
                    placeholder: "-- Chọn kho --",
                    allowClear: true,
                    matcher: function (params, data) {
                        if ($.trim(params.term) === '') return data;

                        let text = (data.text || '').toLowerCase();
                        let term = params.term.toLowerCase();

                        // tìm không dấu
                        let textNo = toNoUnicode(text);
                        let termNo = toNoUnicode(term);

                        if (text.indexOf(term) > -1 || textNo.indexOf(termNo) > -1) {
                            return data;
                        }

                        return null;
                    }
                });

            });
        });
    </script>


}