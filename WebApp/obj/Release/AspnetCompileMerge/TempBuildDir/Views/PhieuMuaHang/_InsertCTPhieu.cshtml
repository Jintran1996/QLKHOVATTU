<script>
    function OnchangeVT(mavt_, imagev2_) {
        if (imagev2_) {
            $('#customer-image').show();
            $("#myImg").attr("src", "https://thaituangarment.com.vn/QLVatTuKhoSoi/materials_images/" + imagev2_);

        }
        else {
            $('#customer-image').hide();
            $("#myImg").attr("src", "https://thaituangarment.com.vn/QLVatTuKhoSoi/materials_images/no-image.png");
        }

        if (!mavt_ || mavt_.trim() === "") {     
            resetSoLuongTon();          
            return;
        }
        SoluongTon(mavt_.trim());  
 
     
    }

    function resetSoLuongTon() {
        $("#SLTonDvi").val("0.00");
        $("#SLTonCty").val("0.00");
    }

    function SoluongTon(mavt_) {

        var maphieu_ = $("#MaPhieu_CT").val();

        // disable khi đang load
        $("#SLTonDvi, #SLTonCty").prop("disabled", true);

        $.ajax({
            url: '@Url.Action("GetSLTonTheoMAVT")',
            type: "GET",
            dataType: "json",
            timeout: 20000,
            data: {
                MAVT: mavt_,
                maphieu: maphieu_
            }
        })
        .done(function (result) {
            $(".divLoading").addClass("loading");
            if (result && result.status === 1) {             

                let slDvi = result.objdvi;
                let slCty = result.objcty;

                $("#SLTonDvi").val(isNaN(slDvi) ? "0" : slDvi);
                $("#SLTonCty").val(isNaN(slCty) ? "0" : slCty);

            } else {
                resetSoLuongTon();
            }
            $(".divLoading").removeClass("loading");
        })
        .fail(function (xhr, status, error) {
            console.error("Lỗi lấy tồn kho:", error);
            resetSoLuongTon();
            $(".divLoading").removeClass("loading");
        })
        .always(function () {
            $("#SLTonDvi, #SLTonCty").prop("disabled", false);
            $(".divLoading").removeClass("loading");
        });
    }
</script>



<script type="text/javascript">
    $(document).ready(function () {
        reloadCTPhieu(false);

        $(".select2-ver2").select2({
            width: "100%",
            placeholder: "-- Vui lòng chọn --",
            allowClear: true,
            matcher: function (params, data) {
                if ($.trim(params.term) === '') return data;

                let text = (data.text || '').toLowerCase();
                let term = params.term.toLowerCase();

                // tìm không dấu
                let textNo = toNoUnicode(text);
                let termNo = toNoUnicode(term);

                if (text.indexOf(term) > -1 || textNo.indexOf(termNo) > -1) {
                    return data;
                }

                return null;
            }
        });
        function toNoUnicode(str) {
            if (!str) return "";
            return str.normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/đ/g, "d")
                .replace(/Đ/g, "D");
        }

        $("#MAVT").select2({
            width: "100%",
            placeholder: "-- Vui lòng chọn --",
            allowClear: true,
            minimumInputLength: 1,

            ajax: {
                url: '@Url.Action("SearchVatTu")',
                dataType: "json",
                delay: 250,

                data: function (params) {
                    return {
                        search: params.term,
                        page: params.page || 1,
                        loaivt: $("#LoaiVT_2").val()
                    };
                },

                processResults: function (data, params) {

                    params.page = params.page || 1;

                    return {
                        results: data.items,
                        pagination: {
                            more: data.more
                        }
                    };
                },

                cache: true
            }
        });



 

        $("#MAVT").on("change", function () {
            var selected = $(this).find(':selected');
            var imagev2 = selected.data('imagev2');
            console.log(imagev2);

            OnchangeVT($(this).val(), imagev2);

     
        });
    });
</script>
