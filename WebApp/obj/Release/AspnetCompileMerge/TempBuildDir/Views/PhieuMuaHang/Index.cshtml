@{
    ViewBag.Title = "Phiếu Yêu Cầu Mua Hàng";
}
<section class="content" style="font-size: 12px">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <!-- Section search -->
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <b>Tìm kiếm</b>
                        </h3>
                    </div>
                    <div class="card-body pad">
                        <div class="row">
                            <div class="col-md-4">
                                <!-- /.form-group -->
                                <div class="form-group">
                                    <label>Mã Phiếu: </label>
                                    <input class="form-control form-control-sm" type="text" autocomplete="off"
                                           id="MaphieuSearch" name="MaphieuSearch" />
                                </div>
                                <!-- /.form-group -->
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Mã Phiếu PD:</label>
                                    <input class="form-control form-control-sm" type="text" autocomplete="off"
                                           id="MaphieuPDSearch" name="MaphieuPDSearch" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label>Loại VT:</label>
                                    <input class="form-control form-control-sm" type="text" autocomplete="off"
                                           id="LoaiVTSearch" name="LoaiVTSearch" />
                                </div>
                            </div>
                            <!-- /.col -->
                            <div class="col-md-12">
                                <!-- /.form-group -->
                                <div class="form-group">
                                    <button id="btnSearch" type="button" class="btn bg-gradient-green" style="background-color:green; width: 100px"><i class="fa fa-search"></i> Tìm Kiếm</button>
                                </div>
                                <!-- /.form-group -->
                            </div>
                            <!-- /.col -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="card card-primary card-outline">
                    <div class="card-body pad">
                        <div class="row" style="margin-bottom:10px">
                            <div class="col-md-4">
                                <button id="btInsert" type="button" class="btn bg-gradient-green" ><i class="fa fa-plus"></i>&nbsp;Thêm mới</button>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 table-body table-responsive">

                            </div>
                        </div>
                    </div>
                    <!-- /.card -->
                </div>
            </div>
            <!-- /.col -->
        </div>
    </div><!-- /.container-fluid -->
</section>

<div id="myModalDetail" class="modal fade modal-wide " role="dialog">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmDetail", id = "frmDetail", enctype = "multipart/form-data" }))
            {
                <div class="modal-header bg-gradient-blue">
                    <div class="modal-title" style="font-size: 17px;text-transform:uppercase;color:mintcream"><strong id="myModalTitleDetail"></strong></div>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div id="myModalContentDetail">
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="text-right">
                        <button type="button" class="btn btn-danger" data-dismiss="modal" style="width: 100px"><i class="fa fa-close"></i>&nbsp;Đóng</button>
                    </div>
                </div>}
        </div>
    </div>
</div>

