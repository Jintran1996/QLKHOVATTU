        function Details(MAPHIEU_, LoaiVT_, LOAIPHIEU_) {
                    $myModalContentCTPhieu.html("");
                    $myModalTitleCTPhieu.html("Chi tiết");
            $.ajax({
                url: '@Url.Action("_InsertCTPhieu")',
                timeout: 20000,
                data: {
                    iMAPHIEU: MAPHIEU_, LoaiVT: LoaiVT_, LOAIPHIEU: LOAIPHIEU_
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    $myModalContentCTPhieu.html(result);
                    $modalCTPhieu.modal();
                    $(".divLoading").removeClass("loading");
                },
                failure: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function Delete(MAPHIEU_) {
            var confirm_ = confirm('Bạn có chắc muốn xóa mã này?');
            if (confirm_) {
                $.ajax({
                    url: '@Url.Action("_DeleteFun")',
                    timeout: 200000,
                    type: "POST",
                    data: { maPhieu: MAPHIEU_ },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status >= 1) {
                            notify(result.text, "success");
                            reloadData();
                        }
                        else {
                            notify(result.text, "error");
                        }

                        $(".divLoading").removeClass("loading");



                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
        }

        function Deletect(IDKHOA_) {
            var confirm_ = confirm('Bạn có chắc muốn xóa mã này?');
            if (confirm_) {
                $.ajax({
                    url: '@Url.Action("_DeleteCTFun")',
                    timeout: 200000,
                    type: "POST",
                    data: { IDKHOA: IDKHOA_ },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status >= 1) {
                            notify(result.text, "success");
                            Details(result.obj);
                        
                        }
                        else {
                            notify(result.text, "error");
                        }

                        $(".divLoading").removeClass("loading");



                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
        }

         $("#btSavect").click(function () {
              form = $("#frmEditct");
                form.removeData('validator');
                form.removeData('unobtrusiveValidation');
              $.validator.unobtrusive.parse("#frmEditct");
             if (form.valid()) {
                 console.warn(form.valid);
                    $.ajax({
                        url: '@Url.Action("_EditFunCT")',
                        type: "POST",
                        data: $('#frmEditct').serialize(),
                        beforeSend: function (xhr) {
                            $(".divLoading").addClass("loading");
                        },
                        success: function (result) {
                            if (result.status >= 1) {
                                notify(result.text, "success");
                                Details(result.obj);
                            }
                            else {
                                notify(result.text, "error");
                            }
                            $(".divLoading").removeClass("loading");
                            $('#closectphieuedit').trigger('click');

                        },
                        error: function (message) {
                            $(".divLoading").removeClass("loading");
                        }
                    });
                }
            });

        function Print(MaPhieu_) {
             $.ajax({
                url: '@Url.Action("_ReportPrintCT")',
                timeout: 20000,
                type: "GET",
                 data: {
                     MaPhieu: MaPhieu_,
                 },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                 success: function (result) {
                     if (result.status < 0) {
                         notify(result.text, "error");
                     }
                     else {
                         $myModalContentPrint.html(result);
                         $modalPrint.modal();
                         $(".divLoading").removeClass("loading");
                     }
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function openOutlookemailbox(MAPHIEU_) {
            $.ajax({
                type: "POST",
                url: '@Url.Action("openOutlookemailbox")',
                data: { MAPHIEU: MAPHIEU_ },
                    beforeSend: function () {
                    },
                    success: function (response) {
                        window.location = response;
                    },
                    error: function (xhr, errorType, exception) {
                    }
             });
        }
        $("#btnSaveExcel").click(function () {
            $.ajax({
                type: "POST",
                url: '@Url.Action("_FunImport")',
                data: {
                },
                beforeSend: function () {
                },
                success: function (response) {
                    window.location = response;
                },
                error: function (xhr, errorType, exception) {
                }
            });

        });

        function UploadTemplate() {
            form = $("#frmUpload");
            form.removeData('validator');
            form.removeData('unobtrusiveValidation');
            $.validator.unobtrusive.parse("#frmUpload");
            if (form.valid()) {
                var formdata = new FormData(); //FormData object
                var fileInput = document.getElementById('fuInputFile');
                formdata.append("fuInputFile", fileInput.files[0]);

                $.ajax({
                    url: "@Url.Action("_FunImport")",
                    type: "POST",
                    contentType: false,
                    processData: false,
                    data: formdata,
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status == 1) {
                            notify(result.text, "success");
                            $('.close').click();
                            reloadData(false);
                        }
                        else {
                            notify(result.text, "error");
                        }

                        $(".divLoading").removeClass("loading");
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
        }
    </script>
}