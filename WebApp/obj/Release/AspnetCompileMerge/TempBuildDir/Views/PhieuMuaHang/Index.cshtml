@section scripts{
    <script language="javascript" type="text/javascript">
        function CallPrint(strid) {
            var prtContent = document.getElementById(strid);
            var WinPrint = window.open('', '', 'left=0,top=0,width=800,height=900,toolbar=0,scrollbars=0,status=0');
            WinPrint.document.write(prtContent.innerHTML);
            WinPrint.document.close();
            WinPrint.focus();
            WinPrint.print();
            WinPrint.close();
        }


    </script>
    <script type="text/javascript">
        var config = {
            '.chosen-select-search': {},
            '.chosen-select-search-deselect': { allow_single_deselect: true },
            '.chosen-select-search-no-single': { disable_search_threshold: 10 },
            '.chosen-select-search-no-results': { no_results_text: 'Oops, nothing found!' },
            '.chosen-select-search-width': { width: "95%" },
            'search_contains': true
        }
        for (var selector in config) {
            $(selector).chosen(config);
        }
    </script>
    <script>
        function reloadData(isDelete) {
            try {
            $.ajax({
                url: '@Url.Action("_GetList")',
                timeout: 20000,
                data: {
                    MaphieuSearch: $("#MaphieuSearch").val(),
                    MaphieuPDSearch: $("#MaphieuPDSearch").val(),
                    LoaiVTSearch: $("#LoaiVTSearch").val()
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body').html(response);

                    $("#myTable").DataTable({
                        //"responsive": true,
                        destroy: true,
                        "language": {
                            "sProcessing": "Đang xử lý...",
                            "sLengthMenu": " Hiển thị _MENU_ dữ liệu",
                            "sZeroRecords": "Không tìm thấy kết quả",
                            "sEmptyTable": "Không có dữ liệu",
                            "sInfo": "Hiển thị _START_ tới _END_ của _TOTAL_ dữ liệu",
                            "sInfoEmpty": "Hiển thị 0 tới 0 của 0 dữ liệu",
                            "sInfoFiltered": "(được lọc từ _MAX_ dữ liệu)",
                            "sInfoPostFix": "",
                            "sSearch": "Tìm kiếm:",
                            "sUrl": "",
                            "sInfoThousands": ",",
                            "sLoadingRecords": "Đang tải...",
                            "oPaginate": {
                                "sFirst": "Đầu tiên",
                                "sLast": "Cuối cùng",
                                "sNext": "Sau",
                                "sPrevious": "Trước"
                            },
                            "oAria": {
                                "sSortAscending": ":Sắp xếp thứ tự tăng dần",
                                "sSortDescending": ": Sắp xếp thứ tự giảm dần"
                            }
                        },
                        "searching": true,
                            "info": false,
                        "processing": false,
                        "serverSide": false,
                        "bFilter": true,
                        "bPaginate": true,
                        "bLengthChange": true,
                        "bInfo": true,
                        "responsive": true,
                        "lengthChange": true,
                        "autoWidth": false,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }

            $("#myModal").on("hidden.bs.modal", function () {
                reloadData(false);
            });

            $("#btnSearch").click(function () {
                reloadData(true);
            });
        }
    </script>
    <script type="text/javascript">

        var $modal = $('#myModal');
        var $myModalContent = $("#myModalContent");
        var $myModalTitle = $("#myModalTitle");

        var $modalCTPhieu = $('#myModalCTPhieu');
        var $myModalContentCTPhieu = $("#myModalContentCTPhieu");
        var $myModalTitleCTPhieu = $("#myModalTitleCTPhieu");

        var $modalDetail = $('#myModalDetail');
        var $myModalContentDetail = $("#myModalContentDetail");
        var $myModalTitleDetail = $("#myModalTitleDetail");

        var $modalEditct = $('#myModalEditct');
        var $myModalContentEditct = $("#myModalContentEditct");
        var $myModalTitleEditct = $("#myModalTitleEditct");

        var $modalUpload = $('#myModalUpload');
        var $myModalContentUpload = $("#myModalContentUpload");
        var $myModalTitleUpload = $("#myModalTitleUpload");

        var $modalPrint = $('#myModalPrint');
        var $myModalContentPrint = $("#myModalContentPrint");
        var $myModalTitlePrint = $("#myModalTitlePrint");

        $(document).ready(function () {
            reloadData(false);


            $("#btInsert").click(function () {
                $myModalContent.html("");
                $myModalTitle.html("Thêm mới");
                $.ajax({
                    url: '@Url.Action("_DetailForEdit")',
                    timeout: 200000,
                    data: {
                        maPhieu: "",
                    },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        $myModalContent.html(result);
                        $modal.modal();
                        $(".divLoading").removeClass("loading");
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            });

            $(".select2-ver2").select2({
                width: "100%",
                placeholder: "-- Vui lòng chọn --",
                allowClear: true,
                matcher: function (params, data) {
                    if ($.trim(params.term) === '') return data;

                    let text = (data.text || '').toLowerCase();
                    let term = params.term.toLowerCase();

                    // tìm không dấu
                    let textNo = toNoUnicode(text);
                    let termNo = toNoUnicode(term);

                    if (text.indexOf(term) > -1 || textNo.indexOf(termNo) > -1) {
                        return data;
                    }

                    return null;
                }
            });



        });

        function EditCt(IDKHOA_) {
            $myModalContentEditct.html("");
            $myModalTitleEditct.html("Hiệu Chỉnh");
            $.ajax({
                url: '@Url.Action("_Editview")',
                timeout: 200000,
                data: {
                    IDKHOA: IDKHOA_
                },
                beforeSend: function (xhr) {
