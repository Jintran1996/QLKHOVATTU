
@{ var locations = ViewBag.locations as List<ToolsApp.EntityFramework.VatTu.VATTU2024_DMKHO>; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tra Cứu Tồn Theo Thời Gian Hạn Sử Dụng</title>
    <link rel="stylesheet" href="~/Content/bootstraptracuuxnk.min.css" />

    <style>
        body {
            background: #f5f7fa;
        }

        .card {
            border-radius: 16px;
        }

        .table thead th {
            background: #0d6efd;
            color: white;
        }
    </style>
</head>

<body>
    <div class="card card-primary card-outline">
        <div class="card-header">
            <h3 class="card-title">
                <b>📦 Tra Cứu Tồn Theo Thời Gian Hạn Sử Dụng</b>
            </h3>
        </div>
        <div class="card-body col-md-12 row">
            <!-- Mã kho -->
            <div class="col-md-3">
                <label class="form-label">Mã Kho</label>
                <select id="MAKHOSEARCH"
                        name="MAKHOSEARCH"
                        class="form-control select2-kho"
                        >
                    @foreach (var kho in locations.Where(p => p.NHOM_OGSTM == "KHOCHINH").ToList())
                    {
                        <option value="@kho.MAKHO">@kho.MAKHO || @kho.TENKHO</option>
                    }
                </select>
            </div>

            <!-- Mã vật tư -->
            <div class="col-md-3">
                <label class="form-label">Mã vật tư</label>
                <input type="text"
                       id="MAVTSearch"
                       class="form-control"
                       placeholder="Nhập mã vật tư" />
            </div>
            <!-- Mã vật tư -->
            <div class="col-md-3">
                <label class="form-label">Đến ngày</label>
                <input type="text" id="DENNGAYSearch" class="form-control"
                       value="@DateTime.Now.ToString("dd/MM/yyyy")">
            </div>


        </div>

        <div class="card-body col-md-6" style=" text-align: end">
            <div class="col-md-12">
                <button class="btn btn-outline-primary" style="width: 150px; text-align:center"
                        id="btnSearch"
                        onclick="btnSearch()">
                    <i class="fa fa-search"></i> Tìm kiếm
                </button>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="card card-primary card-outline">
                <div class="card-header">
                    <h3 class="card-title">
                        <b>Danh sách </b>
                    </h3>
                </div>
                <div class="card-body pad">
                    <div class="row">
                        <div class="col-md-12 table-body table-responsive">

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
@section scripts{
    <script language="javascript" type="text/javascript">
        function CallPrint(strid) {
            var prtContent = document.getElementById(strid);
            var WinPrint = window.open('', '', 'left=0,top=0,width=800,height=900,toolbar=0,scrollbars=0,status=0');
            WinPrint.document.write(prtContent.innerHTML);
            WinPrint.document.close();
            WinPrint.focus();
            WinPrint.print();
            WinPrint.close();
        }


        $("#DENNGAYSearch").datepicker({
            format: 'dd/mm/yyyy',
            changeYear: true,
            changeMonth: true,
            onClose: function (selectedDate) {
                //$("#FromDate").datepicker("option", "minDate", selectedDate);
            }
        });

    </script>
    <script type="text/javascript">
        var config_ = {
            '.chosen-select-search': {},
            '.chosen-select-search-deselect': { allow_single_deselect: true },
            '.chosen-select-search-no-single': { disable_search_threshold: 10 },
            '.chosen-select-search-no-results': { no_results_text: 'Oops, nothing found!' },
            '.chosen-select-search-width': { width: "95%" },
            'search_contains': true
        }
        for (var selector in config_) {
            $(selector).chosen(config_);
        }

    </script>

    <script type="text/javascript">

        function btnSearch() {
           // GetList();
            reloadData(false);
        }

        function reloadData(isDelete) {


            let urlAction = '@Url.Action("GetList1")';
      
        try {
            $.ajax({
                url: urlAction,
                timeout: 2000000,
                type: "POST",
                data: {
                    MAKHOSEARCH_: $("#MAKHOSEARCH").val(),
                    MAVTSearch: $("#MAVTSearch").val(),                   
                    DENNGAY: $("#DENNGAYSearch").val(),

                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body').html(response);

                    // Hủy tất cả các DataTable cũ nếu tồn tại
                    $('.table').each(function () {
                        if ($.fn.DataTable.isDataTable(this)) {
                            $(this).DataTable().destroy(); // Phá hủy DataTable cũ
                        }
                    });

                    $('.table').each(function (index) {
                        console.log(index);
                        $(this).attr('id', 'myTable_' + (index + 1)); // Thêm ID động
                        $(this).DataTable({
                            responsive: true,
                            lengthChange: true,
                            autoWidth: false,
                            stateSave: true,
                            buttons: [
                                {
                                    extend: 'csvHtml5',
                                    text: 'CSV',
                                    title: null, // Không thêm tiêu đề vào file xuất
                                    exportOptions: {
                                        columns: ':visible', // Chỉ xuất các cột đang hiển thị
                                    }
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: 'Excel',
                                    title: null, // Không thêm tiêu đề vào file xuất
                                    exportOptions: {
                                        columns: ':visible', // Chỉ xuất các cột đang hiển thị
                                    }
                                },
                                {
                                    extend: 'print',
                                    text: 'Print',
                                    title: 'Tra Cứu Tồn Theo Mã Vật Tư', // Không thêm tiêu đề khi in
                                    exportOptions: {
                                        columns: ':visible',
                                    }
                                },
                                "colvis"

                            ],
                            initComplete: function (oSettings) {
                                // Thêm logic nếu cần khi DataTable đã khởi tạo
                            }
                        }).buttons().container().appendTo('#myTable_' + (index + 1) + '_wrapper .col-md-6:eq(0)');
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
        }



      
        // Hàm bỏ dấu tiếng Việt
        function toNoUnicode(str) {
            return str.normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/đ/g, "d").replace(/Đ/g, "D")
                .toLowerCase();
        }


    </script>

    <script type="text/javascript">

        $(document).ready(function () {
            reloadData(false);
        });
    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            $.fn.select2.amd.require(['select2/compat/matcher'], function (oldMatcher) {
                $(".select2-kho").select2({
                    width: "100%",
                    placeholder: "-- Tất cả --",
                    allowClear: true,
                    matcher: function (params, data) {
                        if ($.trim(params.term) === '') return data;

                        let text = (data.text || '').toLowerCase();
                        let term = params.term.toLowerCase();

                        // tìm không dấu
                        let textNo = toNoUnicode(text);
                        let termNo = toNoUnicode(term);

                        if (text.indexOf(term) > -1 || textNo.indexOf(termNo) > -1) {
                            return data;
                        }

                        return null;
                    }
                });

            });
        });
    </script>


}