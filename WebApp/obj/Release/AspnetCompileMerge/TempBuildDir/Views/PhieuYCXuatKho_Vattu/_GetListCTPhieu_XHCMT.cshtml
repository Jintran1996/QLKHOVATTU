<script>
    const soLuongInput = document.getElementById("SoLuongTT_XHCMT");

    soLuongInput.addEventListener("input", function () {
        // Loại bỏ ký tự không phải số hoặc dấu chấm
        let raw = this.value.replace(/[^0-9.]/g, "");

        // Chỉ cho phép duy nhất 1 dấu chấm
        let parts = raw.split(".");
        if (parts.length > 2) {
            raw = parts[0] + "." + parts.slice(1).join("");
        }

        if (raw.length > 0) {
            this.value = raw;
        } else {
            this.value = "";
        }
    });

    // Chặn nhập ký tự không phải số hoặc dấu chấm từ bàn phím
    soLuongInput.addEventListener("keypress", function (e) {
        if (!/[0-9.]/.test(e.key)) {
            e.preventDefault();
        }
    });
</script>


<script>
    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }


    function reloadData_getlist_ctphieu() {
        var Search_ = $("#hidenSOCTXN_XHCMT").val() ;
            try {
            $.ajax({
                url: '@Url.Action("_GetListCTPhieu_View")',
                timeout: 20000,
                data: {
                    SOCTXN_CT: Search_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-view-xhcmt').html(response);

                    $("#myTablectphieuxuat").DataTable({
                        //"responsive": true,
                        "lengthChange": true,
                        "autoWidth": true,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
    }





    function _Insert_ctphieu_XHCMT() {

        var LOAIXN = $("#hidenLOAIXN_XHCMT").val();
        var SOCTXN = $("#hidenSOCTXN_XHCMT").val();
        var MAKHONHAN = $("#hidenMAKHONHAN_XHCMT").val();
        var MAKHOXUAT = $("#hidenMAKHOXUAT_XHCMT").val();
        var MAVT_XHCMT = $("#MAVT_XHCMT").val();
      
        var SoLuongTT_XHCMT = $("#SoLuongTT_XHCMT").val();
        var GHICHU_XHCMT = $("#GHICHU_XHCMT").val();
        var Maphieupd_XHCMT = $("#Maphieupd_XHCMT").val();

        console.log(LOAIXN, SOCTXN, MAKHONHAN);
        $.ajax({
            url: '@Url.Action("_InsertFunCTPhieu_XHCMT")',
            timeout: 2000000,
            type: "POST",
            data: { LOAIXN: LOAIXN, SOCTXN: SOCTXN, MAKHOXUAT: MAKHOXUAT, MAVT_XHCMT: MAVT_XHCMT, SoLuongTT_XHCMT: SoLuongTT_XHCMT, GHICHU_XHCMT: GHICHU_XHCMT, Maphieupd_XHCMT: Maphieupd_XHCMT },
            beforeSend: function (xhr) {
                $(".divLoading").addClass("loading");
            },
            success: function (result) {
                if (result.status >= 1) {
                    notify(result.text, "success");
                   // Details(SOCTXN, LOAIXN); // LOAD LẠI FORM DETAILS
                    Details(SOCTXN, LOAIXN, MAKHONHAN, MAKHOXUAT);
                }
                else {
                    notify(result.text, "error");
                }
                $(".divLoading").removeClass("loading");
            },
            error: function (message) {
                $(".divLoading").removeClass("loading");
            }
        });
    };


</script>

