<script>
    function OnchangeVT(mavt_) {
        if (!mavt_ || mavt_.trim() === "") {
            console.log(mavt_)
            resetSoLuongTon();
            return;
        }
        SoluongTon(mavt_.trim());
    }

    function resetSoLuongTon() {
        $("#xSoluongton").val("0.00");
    }

    function SoluongTon(mavt_) {

        var maphieu_ = $("#hidenSOCTXN_XHCMT").val();

        // disable khi đang load
        $("#xSoluongton").prop("disabled", true);

        $.ajax({
            url: '@Url.Action("GetSLTonTheoMAVT")',
            type: "GET",
            dataType: "json",
            timeout: 20000,
            data: {
                MAVT: mavt_,
                maphieu: maphieu_
            }
        })
        .done(function (result) {
            $(".divLoading").addClass("loading");
            if (result && result.status === 1) {
                $(".divLoading").addClass("loading");
                let xSoluongton = result.obj;
                let Maphieupd_XHCMT = result.maphieupd;

                $("#xSoluongton").val(isNaN(xSoluongton) ? "0" : xSoluongton);
                // Gán mã phiếu (kiểm tra nếu có giá trị thì giữ nguyên, ngược lại để rỗng)
                $("#Maphieupd_XHCMT").val(Maphieupd_XHCMT ? Maphieupd_XHCMT : "");

                console.log(Maphieupd_XHCMT);

                $(".divLoading").removeClass("loading");
            } else {
                resetSoLuongTon();
            }
       
        })
        .fail(function (xhr, status, error) {
            console.error("Lỗi lấy tồn kho:", error);
            resetSoLuongTon();
            $(".divLoading").removeClass("loading");
        })
        .always(function () {
            $("#xSoluongton").prop("disabled", false);
            $(".divLoading").removeClass("loading");
        });
    }


    function inputChange_Checksluong() {

        var datayc = $('#SoLuongTT_XHCMT').val();
        var dataton = $('#xSoluongton').val();
        var s1 = parseFloat(datayc);
        var s2 = parseFloat(dataton);
        console.log(s1, s2);

        if (s1 > s2) {
            $('#SoLuongTT_XHCMT').val(s2);
            notify("Số lượng yêu cầu không được lớn hơn số lượng tồn hiện tại", "error");
        }
        return;
    }
</script>










