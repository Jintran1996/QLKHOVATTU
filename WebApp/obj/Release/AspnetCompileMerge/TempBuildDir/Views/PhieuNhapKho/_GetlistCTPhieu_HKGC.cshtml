
@{
    ViewBag.CTPhieu = "Danh Sách Nhập Hồi Kho Gia Công - Sợi";
    var SOPHIEU_HKGC = ViewBag.SOPHIEU_HKGC as List<ToolsApp.EntityFramework.KhoSoi.VATTU2024_SP_LOAD_SOPHIEU_SOIGIACONG_CHUAHOIKHO_Result>;
    var SOCTXN_nhap = ViewBag.SOCTXN_nhap;
    var MAHTHUC = ViewBag.MAHTHUC;
    var MAKHONHAN = ViewBag.MAKHONHAN;
}
@using System.Globalization;
@model ToolsApp.Models.NL_CTXUATNHAPViewModels




<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-md-12">
                <div class="card card-info card-tabs" id="myTap">
                    <div class="card-header p-0 pt-1">
                        <ul class="nav nav-tabs" id="custom-tabs-one-tab" role="tablist">
                            <li class="nav-item" id="tab-1">
                                <a class="nav-link active" id="custom-tabs-one-home-tab-getlist-ctphieu" style="display:block;" data-toggle="pill" href="#custom-tabs-one-home-ct" role="tab" aria-controls="custom-tabs-one-home-ct" aria-selected="true">Danh sách chi tiết phiếu @SOCTXN_nhap </a>
                            </li>
                            @*<li class="nav-item" id="tab-2">
                                    <a class="nav-link" id="custom-tabs-one-profile-tab-action-ctphieu" style="display:block;" data-toggle="pill" href="#custom-tabs-one-profile-action" role="tab" aria-controls="custom-tabs-one-profile-action" aria-selected="false">Nhập sản lượng theo đơn hàng </a>
                                </li>*@
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content" id="custom-tabs-one-tabContent">
                            <div class="tab-pane fade col-md-12 show active" id="custom-tabs-one-home-ct" role="tabpanel" aria-labelledby="custom-tabs-one-home-tab-getlist-ctphieu">
                                <!--data-->
                                @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmctphieuXN", id = "frmctphieuXN", enctype = "multipart/form-data" }))
                                {
                                    <input class="form-control" type="text" autocomplete="off"
                                           id="SOCTXN_HKGC" name="SOCTXN_HKGC" value="@SOCTXN_nhap.Trim()" hidden />
                                    <input class="form-control" type="text" autocomplete="off"
                                           id="MAHTHUC_HKGC" name="MAHTHUC_HKGC" value="@MAHTHUC.Trim()" hidden />
                                    <input class="form-control" type="text" autocomplete="off"
                                           id="MAKHONHAN_HKGC" name="MAKHONHAN_HKGC" value="@MAKHONHAN.Trim()" hidden />
                                    <div class="row">
                                        <div class="col-md-8">
                                            <div class="row" style="margin-bottom:15px">
                                                <label class="col-md-3">Kế thừa SOCTXN :</label>
                                                <div class="col-md-9">
                                                    <select class="form-control chosen-select" id="SOPHIEU_HKGC" name="SOPHIEU_HKGC">
                                                        <option disabled selected value="">--Kế thừa SOPHIEU--</option>
                                                        @foreach (var item in SOPHIEU_HKGC)
                                                        {
                                                            <option value="@item.SOPHIEU">@item.SOPHIEU</option>
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="text-center">
                                                <button type="button" id="btSavect" onclick="Insert_ctphieu_HKGC();" class="btn btn-sm btn-primary" style="width: 100px"><i class="fa fa-save"></i>&nbsp;Lưu</button>
                                            </div>
                                        </div>
                                        <div class="card-body pad">
                                            <div class="row">
                                                <div class="col-md-12 table-body-view-ctphieu  table-responsive">

                                                </div>
                                            </div>
                                        </div>
                                        <!-- /.card -->
                                    </div>
                                }
                                <!--data-->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</body>
</html>


<script>
    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }

    function reloadData_getlist_ctphieu_HKGC() {
        var SOCTXN_ = $("#SOCTXN_HKGC").val();
            try {
            $.ajax({
                url: '@Url.Action("_GetListCTPhieu_View")',
                timeout: 20000,
                data: {
                    SOCTXN: SOCTXN_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-view-ctphieu-HKGC').html(response);

                    $("#myTablectview").DataTable({
                        //"responsive": true,
                        "lengthChange": true,
                        "autoWidth": true,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
    }
    function Insert_ctphieu_HKGC() {
  
        var MAKHONHAN_HKGC = $("#MAKHONHAN_HKGC").val();
        var SOCTXN_HKGC = $("#SOCTXN_HKGC").val();
        var MAHTHUC_HKGC = $("#MAHTHUC_HKGC").val();
        var SOPHIEU_HKGC = $("#SOPHIEU_HKGC").val();

        var confirm_ = confirm('Bạn có chắc muốn nhập kế thừa từ SOCTXN xuất này?');
        if (confirm_) {

                $.ajax({
                    url: '@Url.Action("_Insert_ctphieu_HKGC")',
                    type: "POST",
                    data: {
                        MAKHONHAN_HKGC: MAKHONHAN_HKGC, SOCTXN_HKGC: SOCTXN_HKGC, SOPHIEU_HKGC: SOPHIEU_HKGC
                    },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status >= 1) {
                            notify(result.text, "success");

                        }
                        else {
                            notify(result.text, "error");
                        }
                        $(".divLoading").removeClass("loading");
                        document.getElementById("idCloseDetail").addEventListener("click", function () {
                            $('#myModalDetail').modal('hide');
                        });
                        Details(SOCTXN_HKGC, MAHTHUC_HKGC);


                       // reloadData_getlist_ctphieu();
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
        }
    };
</script>

<script type="text/javascript">
    $(document).ready(function () {
        reloadData_getlist_ctphieu($("#SOCTXN_HKGC").val());
    })
</script>








