                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
     }

        // Hàm bỏ dấu tiếng Việt
        function toNoUnicode(str) {
            return str.normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .replace(/đ/g, "d").replace(/Đ/g, "D")
                .toLowerCase();
        }


    </script>

    <script type="text/javascript">

        $(document).ready(function () {
          //  reloadData(false);

            $("#TUNGAYSearch").datepicker({
                format: 'dd/mm/yyyy',
                changeYear: true,
                changeMonth: true,
                onClose: function (selectedDate) {
                    //$("#FromDate").datepicker("option", "minDate", selectedDate);
                }
            });

            $("#DENNGAYSearch").datepicker({
                format: 'dd/mm/yyyy',
                changeYear: true,
                changeMonth: true,
                onClose: function (selectedDate) {
                    //$("#FromDate").datepicker("option", "minDate", selectedDate);
                }
            });

            $("#weekDate").on("change", function () {
                const date = new Date(this.value);
                if (!this.value) return;

                $("#weekValue").val(getISOWeek(date));
            });

        });

        function getISOWeek(date) {
            const d = new Date(Date.UTC(
                date.getFullYear(),
                date.getMonth(),
                date.getDate()
            ));

            const dayNum = d.getUTCDay() || 7;
            d.setUTCDate(d.getUTCDate() + 4 - dayNum);

            const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
            const weekNo = Math.ceil((((d - yearStart) / 86400000) + 1) / 7);

            return `${d.getUTCFullYear()}-W${String(weekNo).padStart(2, '0')}`;
        }



        function btMAVTTD(MAPHIEUPD_, MAVT_) {
            $.ajax({
               url: '@Url.Action("GetListMAVTTD", "tracuutiendomuahang_cungung")',
                timeout: 20000,
                data: {
                    MAPHIEUPD: MAPHIEUPD_, MAVT: MAVT_

                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                    success: function (result) {
                        if (result.status < 0) {
                            notify(result.text, "error");
                            $(".divLoading").removeClass("loading");
                        }
                        else {

                            $myModalTitleMAVTTD.html("MÃ VẬT TƯ TƯƠNG ĐƯƠNG");
                            $myModalContentMAVTTD.html(result);
                            $modalMAVTTD.modal();
                            $(".divLoading").removeClass("loading");
                        }
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }
    </script>

}