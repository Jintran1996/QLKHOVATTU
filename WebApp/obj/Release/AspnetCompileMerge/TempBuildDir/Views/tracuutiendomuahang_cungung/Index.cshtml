    <script type="text/javascript">
        var $modalMAVTTD = $('#myModalMAVTTD');
        var $myModalContentMAVTTD = $("#myModalContentMAVTTD");
        var $myModalTitleMAVTTD = $("#myModalTitleMAVTTD");


        function btnSearch() {
           // GetList();
            reloadData(false);
        }

     function reloadData(isDelete) {
            let weekValue = $("#weekPicker").val();
            var searchType = $('input[name="searchType"]:checked').val();
            let urlAction = '@Url.Action("GetList")';
            if (searchType === "DK5") {
                urlAction = '@Url.Action("GetList")';
                 }
         var currentFilter = {
             searchType: $('input[name="searchType"]:checked').val(),
             MAPHIEUPDSearch: $("#MAPHIEUPDSearch").val(),
             MAVTSearch: $("#MAVTSearch").val(),
             TUNGAYs: $("#TUNGAYSearch").val(),
             DENNGAYs: $("#DENNGAYSearch").val(),
         //    weekValue: $("#weekPicker").val()
             weekValue: $("#weekValue").val()
         };
        try {
            $.ajax({
                url: urlAction,
                timeout: 2000000,
                type: "POST",
                data: currentFilter,
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body').html(response);

                    // Hủy tất cả các DataTable cũ nếu tồn tại
                    $('.table').each(function () {
                        if ($.fn.DataTable.isDataTable(this)) {
                            $(this).DataTable().destroy(); // Phá hủy DataTable cũ
                        }
                    });

                    $('.table').each(function (index) {
                        $(this).attr('id', 'myTable_' + (index + 1)); // Thêm ID động
                        $(this).DataTable({
                            //scrollX: true,                 // ✅ BẮT BUỘC
                            //scrollXInner: "100%",           // ✅ giữ width thật
                            //scrollCollapse: true,
                            responsive: false,              // ❌ tắt responsive
                            autoWidth: false,               // ❌ không cho DataTables tự bóp cột
                            lengthChange: true,
                            stateSave: true,
                            lengthMenu: [5,10,20,30,50,100,200],
                            buttons: [
                                 {
                                     text: '📊 Xuất Excel',
                                     action: function () {
                                            let query = $.param(currentFilter);
                                            window.location ='@Url.Action("ExportTienDoMuaHangExcel")?' + query;
                                            }
                                },
                                {
                                    extend: 'colvis',
                                    text: 'Cột ẩn / hiện',
                                },
                                {
                                    text: '📘 Tài liệu',
                                    action: function () {
                                        window.location = '@Url.Action("DownloadHuongDanTienDo")';
                                    }
                                },
                            ],

                            initComplete: function (oSettings) {
                                // Thêm logic nếu cần khi DataTable đã khởi tạo
                            }
                        }).buttons().container().appendTo('#myTable_' + (index + 1) + '_wrapper .col-md-6:eq(0)');
                    });
                },
