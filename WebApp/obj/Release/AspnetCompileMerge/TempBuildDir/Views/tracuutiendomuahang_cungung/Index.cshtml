<body>
    <div class="card card-primary card-outline">
        <div class="card-header">
            <h3 class="card-title"><b>📦 TRA CỨU TIẾN ĐỘ MUA HÀNG - VẬT TƯ</b></h3>
        </div>

        <div class="card-body row">

            <!-- SEARCH BY PHIEU -->
            <div class="col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input search-type" type="radio" name="searchType" value="DK2">
                    <label class="form-check-label"><b>Theo mã phiếu phê duyệt</b> </label>
                </div>
                <input type="text" id="MAPHIEUPDSearch" class="form-control"
                       placeholder="Nhập mã phiếu phê duyệt">
            </div>

            <!-- SEARCH BY MAVT -->
            <div class="col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input search-type" type="radio" name="searchType" value="DK4">
                    <label class="form-check-label"><b>Theo mã vật tư</b></label>
                </div>
                <input type="text" id="MAVTSearch" class="form-control"
                       placeholder="Nhập mã vật tư">
            </div>

            <!-- SEARCH BY DATE -->
            <div class="col-md-4">
                <div class="form-check mb-2">
                    <input class="form-check-input search-type" type="radio" name="searchType" value="DK3" checked>
                    <label class="form-check-label"><b>Theo ngày phê duyệt</b></label>
                </div>

                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><b>Từ ngày</b></span>
                    </div>

                    <input type="text" id="TUNGAYSearch" class="form-control"
                           value="@DateTime.Now.AddDays(-3).ToString("dd/MM/yyyy")">

                    <div class="input-group-prepend">
                        <span class="input-group-text"><b>Đến ngày</b></span>
                    </div>

                    <input type="text" id="DENNGAYSearch" class="form-control"
                           value="@DateTime.Now.ToString("dd/MM/yyyy")">
                </div>
            </div>

            <!-- SEARCH BY WEEK -->
 
            <div class="col-md-2">
                <div class="form-check mb-2">
                    <input class="form-check-input search-type" type="radio" name="searchType" value="DK5">
                    <label class="form-check-label"><b>Theo Tuần</b></label>
                </div>

                <div class="input-group">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><b>Chọn tuần</b></span>
                    </div>

                    <input type="date"
                           class="form-control"
                           id="weekDate">
                </div>
                <input type="hidden" id="weekValue" name="weekValue">
            </div>

            @*--------- week firefox không hỗ trợ type week------------
                <div class="col-md-2">
            <div class="form-check mb-2">
                <input class="form-check-input search-type" type="radio" name="searchType" value="DK5">
                <label class="form-check-label"><b>Theo Tuần</b></label>
            </div>

            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><b>Chọn tuần</b></span>
                </div>

                <input type="week"
                       class="form-control"
                       id="weekPicker"
                       name="weekPicker">
            </div>
        </div>*@

        </div>

        <div class="card-body">
            <button class="btn btn-primary" onclick="btnSearch()" style="width: 120px">
                <i class="fa fa-search"></i> Tra cứu
            </button>
        </div>
    </div>



    <div class="row">
        <div class="col-md-12">
            <div class="card card-primary card-outline">
