                    },
                    success: function (result) {
                        $myModalContentUpload.html(result);
                        $modalUpload.modal();

                        $(".divLoading").removeClass("loading");
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
    };


</script>

<script type="text/javascript">
    $("#NGAYKETOAN").datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true,
        onClose: function (selectedDate) {
            //$("#FromDate").datepicker("option", "minDate", selectedDate);
        }
    });
    $(document).ready(function () {
      reloadData_getlist_ctphieu(false);

      $(".select2-ver2").select2({
      width: "100%",
      placeholder: "-- Vui lòng chọn --",
      allowClear: true,
      matcher: function (params, data) {
          if ($.trim(params.term) === '') return data;

          let text = (data.text || '').toLowerCase();
          let term = params.term.toLowerCase();

          // tìm không dấu
          let textNo = toNoUnicode(text);
          let termNo = toNoUnicode(term);

          if (text.indexOf(term) > -1 || textNo.indexOf(termNo) > -1) {
              return data;
          }

          return null;
      }
      });

                $("#MAVT_NHGA").select2({
    width: "100%",
    placeholder: "-- Vui lòng chọn --",
    allowClear: true,
    minimumInputLength: 1,

    ajax: {
        url: '@Url.Action("SearchVatTu")',
        dataType: "json",
        delay: 250,

        data: function (params) {
            return {
                search: params.term,
                page: params.page || 1,
                loaiXN: $("#hidenLOAIXN_NHGA").val()
            };
        },

        processResults: function (data, params) {

            params.page = params.page || 1;
            console.log(data);
            return {
                results: data.items,
                pagination: {
                    more: data.more
                }
            };
        },

        cache: true
    }
});
  function toNoUnicode(str) {
      if (!str) return "";
      return str.normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/đ/g, "d")
          .replace(/Đ/g, "D");
  }



    })
</script>







