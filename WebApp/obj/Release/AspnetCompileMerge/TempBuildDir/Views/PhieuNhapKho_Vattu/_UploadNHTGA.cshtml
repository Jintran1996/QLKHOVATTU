
@{
    var SOCTXN = ViewBag.SOCTXN; 
    var LOAIXN = ViewBag.LOAIXN; 

}

<div class="row">
    <div class="col-md-12">
        <div class="card card-primary card-outline">
            <div class="card-body pad">
                <div class="row">
                    <div class="col-md-8">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="form-control" id="fuInputFile" name="fuInputFile" accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet">                           
                                </div>
                                <div class="input-group-append">
                                    <span id="btnSaveExcel" onclick="UploadTemplateNHTGA('@SOCTXN.Trim()', '@LOAIXN')" class="btn bg-gradient-info"><i class="fa fa-file-excel"></i>&nbsp;Tải lên</span>
                                </div>
                                <div class="input-group-append">
                                    <a href="~/UserFiles/Template/MAU_NHAP_EXCEL_TANGGIAMTONKHOVATTU.xlsx" class="btn bg-gradient-primary"><i class="fa fa-table"></i>&nbsp;Tải Mẫu</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /.col -->
                </div>
            </div>
            <!-- /.card -->
        </div>
    </div>
    <!-- /.col -->
</div>
@*
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/css/bootstrap.min.css">*@




