@model ToolsApp.Models.HomeUserViewModel

@{

}

@Html.ValidationSummary(true, "", new { @class = "text-danger" })
<input type="hidden" id="Id" name="Id" value="@Model.Id" />

<div class=" card card-primary card-outline"> 
    <div class="card-body pad">
        <div class="row" style="margin-bottom:5px">
            <div class="col-md-12">
              
                    <label>Mã NV</label>
                    <input class="form-control form-control-sm" type="text" autocomplete="off"
                           id="ChangePwd_MANV" name="ChangePwd_MANV" />
        
            </div>
        </div>
        <div class="row" style="margin-bottom:5px">
            <div class="col-md-12">
            
                    <label>Mật khẩu</label>
                    <input class="form-control form-control-sm" type="text" autocomplete="off"
                           id="ChangePwd_Password" name="ChangePwd_Password" />
              
            </div>
        </div>
        <div class="row" style="margin-bottom:5px">
            <div class="col-md-12">
           
                    <label>Lặp lại mật khẩu</label>
                    <input class="form-control form-control-sm" type="text" autocomplete="off"
                           id="ReChangePwd_Password" name="ReChangePwd_Password" />
         
            </div>
        </div>

    </div>
</div>


