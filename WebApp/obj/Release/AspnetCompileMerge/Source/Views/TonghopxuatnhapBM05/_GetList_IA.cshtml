@{
    var list = ViewBag.List as List<ToolsApp.EntityFramework.KhoTP2023.TONKHO290224_InventoryAdjustment_Result>;
    ViewBag.Title = "Inventory Adjustment";
    var Maphieu = ViewBag.MaPhieu;
    var stt = 1;
}
<table id="myTable" class="table table-bordered table-striped" style="font-size: 12px">
    <thead>
        <tr>
            <th>STT</th>
            <th>External_ID</th>
            <th>REFERENCE</th>
            <th>ADJUSTMENT_ACCOUNT</th>
            <th>EXPIRATION_DATE</th>
            <th>ADJUSTMENT_LOCATION</th>
  
        </tr>
    </thead>
    <tbody>
        @foreach (var item in list)
        {
            <tr>
                <td>@stt</td>
                <td>@item.External_ID</td>
                <td>@item.REFERENCE</td>
                <td>@item.ADJUSTMENT_ACCOUNT</td>
                <td>@item.EXPIRATION_DATE</td>
                <td>@item.ADJUSTMENT_LOCATION</td>   
            </tr>
            stt++;
        }
    </tbody>
</table>

