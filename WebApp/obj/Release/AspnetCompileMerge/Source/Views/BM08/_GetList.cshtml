@{
    var list = ViewBag.List as List<ToolsApp.EntityFramework.VatTu.DMPHIEU>;
    ViewBag.Title = "Danh sách phiếu yêu cầu";
    var stt = 1;
}
<table id="myTable" class="table table-bordered table-striped" style="font-size: 12px">
    <thead>
        <tr>
            <th>STT</th>
            <th style="height:40px; width:10px; margin:0;"></th>
            <th>Mã phiếu</th>
            <th>Ngày yêu cầu</th>
            <th>Người lập</th>
            <th>Lý do </th>
            <th>Người TN</th>
            <th>Ngày TN</th>
            <th>Người PD</th>
            <th>Ngày PD</th>
            <th>Người XX</th>
            <th>Ngày XX</th>
            <th>Mã phiếu PD</th>
            <th>Loại phiếu</th>
            <th>ND</th>
            <th>NK</th>
            <th>KH</th>
            <th>DX</th>
            <th>Loại VT</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in list)
        {
            <tr>
                <td>@stt</td>
                <td style="white-space: nowrap">
                    <a onclick="Detail('@item.MAPHIEU')" class="btn" style="font-size:10px">
                        <i class="fa fa-print">&nbsp;In</i>
                    </a>
                    @if (string.IsNullOrEmpty(item.MaPhieuPD) || item.PDuyet != 1)
                    {
                        <a onclick="AddChiTietPhieu()" class="btn" style="font-size:10px">
                            <i class="fas fa-tasks" aria-hidden="true">&nbsp;Chi tiết</i>
                        </a>
                    }
                    @if (item.NguoiLapPhieu == User.Identity.Name)
                    {
                        <a onclick="Delete('@item.MAPHIEU')" class="btn" style="font-size:10px">
                            <i class="fas fa-trash">&nbsp;Xóa&nbsp;phiếu</i>
                        </a>

                    }

                </td>
                <td>@item.MAPHIEU </td>
                <td>@(item.NgayYC == null ? "": item.NgayYC.Value.ToString("dd/MM/yyyy HH:mm:ss"))</td>
                <td>@item.NguoiLapPhieu</td>
                <td>@item.LyDoSD</td>
                <td>@item.NguoiTiepNhan</td>
                <td>@(item.NgayTN == null ? "": item.NgayTN.Value.ToString("dd/MM/yyyy HH:mm:ss"))</td>
                <td>@item.NguoiPD</td>
                <td>@(item.NgayPD == null ? "": item.NgayPD.Value.ToString("dd/MM/yyyy HH:mm:ss"))</td>
                <td>@item.NguoiXX</td>
                <td>@(item.NgayXX == null ? "": item.NgayXX.Value.ToString("dd/MM/yyyy HH:mm:ss"))</td>
                <td>@item.MaPhieuPD</td>
                <td>@item.LOAIPHIEU</td>
                <td>
                    @if (item.ND == 1)
                    {<i class="fa fa-check"></i>}
                </td>
                <td>
                    @if (item.NK == 1)
                    {<i class="fa fa-check"></i>}
                </td>
                <td>
                    @if (item.KH == 1)
                    {<i class="fa fa-check"></i>}
                </td>
                <td>
                    @if (item.DX == 1)
                    {<i class="fa fa-check"></i>}
                </td>
                <td>@item.LoaiVT</td>
            </tr>
            stt++;
        }
    </tbody>
</table>