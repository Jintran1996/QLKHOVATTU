@using System.Globalization;
@model ToolsApp.Models.NL_DMPHIEUXNViewModels
@{
    var SOCTXN = ViewBag.SOCTXN;
    //  var donvinhan = ViewBag.donvinhan as List<ToolsApp.EntityFramework.QuanLyKhoMoc2023.spLoad_DonVi_Result>;
    var loaihinhthuc = ViewBag.loaihinhthuc as List<ToolsApp.EntityFramework.KhoSoi.SP_LOAD_MAHINHTHUC_XUATKHO_Result>;
    var makhoxuat = ViewBag.makhoxuat as List<ToolsApp.EntityFramework.KhoSoi.SP_MAKHOBYMANV_LOAD_Result>;
    var makhonhan = ViewBag.makhonhan as List<ToolsApp.EntityFramework.KhoSoi.DANHMUC_KHO_NOIDEN_XUATKHO_Result>;
    var MANVYC = ViewBag.MANVYC as List<ToolsApp.EntityFramework.KhoSoi.Load_MANVYC_XNKHO_SOI_Result>;

    var DMDONVI = ViewBag.DMDONVI as List<ToolsApp.EntityFramework.VatTu.VATTU2024_SP_LOAD_QUYEN_SUDUNG_DMDONVI_Result>;
    var manvnhan = ViewBag.manvnhan as List<ToolsApp.EntityFramework.VatTu.DMNHANVIEN>;

}
@Html.ValidationSummary(true, "", new { @class = "text-danger" })



<div class="row">
    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">SOCTXN :</label>
            <div class="col-md-9">
                <input class="form-control" type="text" autocomplete="off" value="@SOCTXN" readonly
                       id="SOCTXN_" name="SOCTXN" />
            </div>
        </div>
    </div>


    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">IDMADV Nhận :</label>
            <div class="col-md-9">
                <select class="form-control chosen-select" id="IDMADVNHAN" name="IDMADVNHAN" onchange="_Onchange_Location_MANV()">
                    @foreach (var item in DMDONVI)
                    {
                        <option value="@item.IDMaDV">@item.IDMaDV || @item.TenDonVi</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">IDMADV Xuất :</label>
            <div class="col-md-9">
                <select class="form-control chosen-select" id="IDMADVXUAT" name="IDMADVXUAT">
                    @foreach (var item in DMDONVI)
                    {
                        <option value="@item.IDMaDV">@item.IDMaDV || @item.TenDonVi</option>
                    }
                </select>
            </div>
        </div>
    </div>

</div>
<div class="row">
    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3 ">Loại Hình thức:</label>
            <div class="col-md-9 ">
                <select class="form-control chosen-select" id="MAHTHUC" name="MAHTHUC" onchange="_Load_SOCTXN()">
                    @foreach (var item in loaihinhthuc)
                    {
                        <option value="@item.MAHTHUC">@item.MAHTHUC  ||  @item.TENHTHUC</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">Mã Kho Nhận :</label>
            <div class="col-md-9">
                <select class="form-control chosen-select" id="MAKHONHAN" name="MAKHONHAN">
                    <option disabled selected value="">-- Kho nhận--</option>
                    @foreach (var item in makhoxuat)
                    {
                        <option value="@item.MAKHO">@item.MAKHO || @item.TENKHO</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">Mã Kho Xuất:</label>
            <div class="col-md-9">
                <select class="form-control chosen-select" id="MAKHOXUAT" name="MAKHOXUAT" >
                    <option disabled selected value="">-- Kho Xuất --</option>
                    @foreach (var item in makhoxuat)
                    {
                        <option value="@item.MAKHO">@item.MAKHO || @item.TENKHO</option>
                    }
                </select>
            </div>
        </div>
    </div>

</div>
<div class="row">
    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">Ngày Chứng Từ:</label>
            <div class="col-md-9">
                <input disabled type="datetime" id="Ngayct" name="Ngayct" value="@DateTime.Now.ToString("dd/MM/yyyy")" class="form-control" />
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">Người Nhận:</label>
            <div class="col-md-9">
                <select class="form-control chosen-select" id="MANVNHAN" name="MANVNHAN">
                    <option disabled selected value="">-- MANV Nhận--</option>
                    @foreach (var item in manvnhan)
                    {
                        <option value="@item.MANV">@item.MANV || @item.HOTEN</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="col-md-4" id="soXBAN">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">Số SO:</label>
            <div class="col-md-9">
                <input type="text" id="SOPO" name="SOPO" class="form-control" />
            </div>
        </div>
    </div>
</div>



<div class="row">
    <div class="col-md-12">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-1">Ghi chú:</label>
            <div class="col-md-11">
                <textarea rows="1" id="GHICHU" name="GHICHU" class="form-control "></textarea>
            </div>
        </div>
    </div>
</div>



<script type="text/javascript">

    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }
    $("#Ngayct").datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true,
        onClose: function (selectedDate) {
            //$("#FromDate").datepicker("option", "minDate", selectedDate);
        }
    });

 //-----------------Load change----------------//

    function _Load_SOCTXN() {

        var MAHTHUCid = $("#MAHTHUC").val();
        var SOCTXNid = $("#SOCTXN_");

        SOCTXNid.empty();

            $.ajax({
                url: '@Url.Action("_Change_SOCTXN")',
                timeout: 20000,
                type: "POST",
                data: { MAHTHUCid: MAHTHUCid },
                success: function (result) {
                    console.log(result.obj);
                    if (result.status < 0) {
                        notify(result.text, "error");
                    }
                    else
                    {
                        SOCTXNid.val(result.obj).trigger("chosen:updated");
                    }
                    LoadSO();
                }
            });
    }

         function _Onchange_Location_MANV() {
        var IDMADVNHAN_ = $("#IDMADVNHAN").val();
        var MAKHONHAN_ = $("#MAKHONHAN_");
         var MANVNHAN_ = $("#MANVNHAN");

       // MAKHONHAN_.empty();
        MANVNHAN_.empty();
            $.ajax({               
                   url: '@Url.Action("_Onchange_Location_MANV", "PhieuNhapKho")',
                timeout: 20000,
                type: "POST",
                data: { IDMADVNHAN: IDMADVNHAN_ },
                success: function (result) {

                    if (result.status < 0) {
                        notify(result.text, "error");
                    }
                    else {
                        $.each(result.obj, function (i, state) {
                            MANVNHAN_.append($('<option/>', { value: this.MANV }).html(this.MANV + "||" + this.HOTEN));
                        });
                        MANVNHAN_.trigger("chosen:updated");
                    }
                }
            });
         }


    function _Onchange_Khonhan() {
        var dvxuat = $("#donvi_xuat").val();
        var MAKHONHAN_ = $("#MAKHONHAN");
        var MAKHOXUAT_ = $("#MAKHOXUAT").val();
        var MAHTHUC_ = $("#MAHTHUC").val();

        MAKHONHAN_.empty();


            $.ajax({
                url: '@Url.Action("_Onchange_Khonhan")',
                timeout: 20000,
                type: "POST",
                data: { MAKHOXUAT: MAKHOXUAT_, MAHTHUC: MAHTHUC_ },
                success: function (result) {

                    if (result.status < 0) {
                        notify(result.text, "error");
                    }
                    else
                    {
                        $.each(result.obj, function (i, state) {
                            MAKHONHAN_.append($('<option/>', { value: this.MAKHO }).html(this.MAKHO || this.TENKHO));
                        });
                        console.log(state.MAKHO)
                    }
                    MAKHONHAN_.trigger("chosen:updated");
                }
            });
    }
    function LoadSO() {
        if ($('#MAHTHUC').val() == 'XBAN') {
            document.getElementById("soXBAN").style.display = 'block';
        }
        else {
            document.getElementById("soXBAN").style.display = 'none';
        }
    }

</script>
