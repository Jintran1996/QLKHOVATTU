    <script>
        var $modalPrint = $('#myModalPrint');
        var $myModalContentPrint = $("#myModalContentPrint");
        var $myModalTitleDT = $("#myModalTitlePrint");

        function Print(SOCTVT_) {

            $.ajax({
                url: '@Url.Action("_PrintReport")',
                timeout: 20000,
                data: {
                    SOCTVT: SOCTVT_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                    success: function (result) {
                        if (result.status < 0) {
                            notify(result.text, "error");
                            $(".divLoading").removeClass("loading");
                        }
                        else {
                            $myModalContentPrint.html(result);
                            $modalPrint.modal();
                            $(".divLoading").removeClass("loading");
                        }
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function Print_HD(SOHD_, Makho_) {

            $.ajax({
                url: '@Url.Action("_PrintReportSoHD")',
                timeout: 20000,
                data: {
                    SOHD: SOHD_, Makho: Makho_
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                    success: function (result) {
                        if (result.status < 0) {
                            notify(result.text, "error");
                            $(".divLoading").removeClass("loading");
                        }
                        else {
                            $myModalContentPrint.html(result);
                            $modalPrint.modal();
                            $(".divLoading").removeClass("loading");
                        }
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function btnBGDXacNhan(SOCTXN_) {
            var confirm_ = confirm('Bạn có chắc muốn xác nhận số phiếu này?' + SOCTXN_);
             if (confirm_) {
                 $.ajax({
                     url: '@Url.Action("BGDXacNhanFun")',
                     timeout: 2000000,
                     type: "POST",
                     data: { SOCTXN: SOCTXN_ },
                     beforeSend: function (xhr) {
                         $(".divLoading").addClass("loading");
                     },
                     success: function (result) {

                         if (result.status >= 1) {
                             notify(result.text, "success");
                             reloadData(false);
                         }
                         else {
                             notify(result.text, "error");
                         }
                         $(".divLoading").removeClass("loading");
                     },
                     error: function (message) {
                         $(".divLoading").removeClass("loading");
                     }
                 });
             }
        }

    </script>
    <script>
function getSoctvt() {
    const soctvt = document.getElementById("SOCTPrint").value;

    if (!soctvt) {
        alert("Vui lòng nhập Số chứng từ");
        return null;
    }
    return encodeURIComponent(soctvt);
}

    function exportPdf() {
        const soctvt = getSoctvt();
        if (!soctvt) return;

        window.location.href =
            '@Url.Action("ExportPdf", "Inphieuchatluongdonvi")'
            + '?soctvt=' + soctvt;
    }

    function exportExcel() {
        const soctvt = getSoctvt();
        if (!soctvt) return;

        window.location.href =
            '@Url.Action("ExportExcel", "Inphieuchatluongdonvi")'
            + '?soctvt=' + soctvt;
    }

    function exportWord() {
        const soctvt = getSoctvt();
        if (!soctvt) return;

        window.location.href =
            '@Url.Action("ExportWord", "Inphieuchatluongdonvi")'
            + '?soctvt=' + soctvt;
    }
    </script>


