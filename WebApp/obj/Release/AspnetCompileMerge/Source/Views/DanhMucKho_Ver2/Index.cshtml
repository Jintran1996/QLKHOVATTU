        <script type="text/javascript">
        var $modalEditct = $("#myModalEditct");
        var $myModalContentEditct = $("#myModalContentEditct");
        var $myModalTitleEditct = $("#myModalTitleEditct");

        function InsertKho() {
        var _maKho = $('#maKho').val();
        var _diaChi = $('#diaChi').val();
        var _maKhoKT = $('#maKhoKT').val();
        var _tenKho = $('#tenKho').val();
        var _khoNhan = $('#khoNhan').val();
        var _thuKho = $('#thuKho').val();
        var check = $('#customSwitches');
        $.ajax({
            url: '@Url.Action("_SaveFun")',
            type: "POST",
            data: {
                maKho: _maKho,
                tenKho: _tenKho,
                maKhoKT: _maKhoKT,
                diaChi: _diaChi,
                khoNhan: _khoNhan,
                thuKho: _thuKho,
                xuatNB: check.is(":checked") ?  true :  false,
            },
            beforeSend: function (xhr) {
                $(".divLoading").addClass("loading");
            },
        }).done(function (data) {
            $(".divLoading").removeClass("loading");
            if (data.status < 0) {
                notify(data.text, "error");
            }
            else {
                notify(data.text, "success");
                reloadData();
            }

        }).fail(function (data) {
            notify(data.text, "error");
        });
    }

    function Delete(_maKho) {
            var confirm_ = confirm('Bạn có chắc muốn xóa mã này?');
            if (confirm_) {
                $.ajax({
                    url: '@Url.Action("_DeleteFun")',
                    timeout: 200000,
                    type: "POST",
                    data: { MAKHO: _maKho },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status >= 1) {
                            notify(result.text, "success");
                            reloadData();
                        }
                        else {
                            notify(result.text, "error");
                        }
                        $(".divLoading").removeClass("loading");
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
    }

    function Edit(_maKho) {
            $myModalContentEditct.html("");
            $myModalTitleEditct.html("Hiệu Chỉnh");
            $.ajax({
                url: '@Url.Action("_Editview")',
                timeout: 200000,
                data: {
                    MAKHO: _maKho
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    $(".divLoading").removeClass("loading");
                    $myModalContentEditct.html(result);
                    $modalEditct.modal();

                },
                failure: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }
        </script>

        <script>
        $("#btSavect").click(function () {
            var _maKho = $('#maKho_UP').val();
            var _diaChi = $('#diaChi_UP').val();
            var _maKhoKT = $('#maKhoKT_UP').val();
            var _tenKho = $('#tenKho_UP').val();
            var _khoNhan = $('#khoNhan_UP').val();
            var _thuKho = $('#thuKho_UP').val();
            var check = $('#xuatNB_UP');
            $.ajax({
                url: '@Url.Action("_EditFunCT")',
                type: "POST",
                data: {
                    maKho: _maKho,
                    tenKho: _tenKho,
                    maKhoKT: _maKhoKT,
                    diaChi: _diaChi,
                    khoNhan: _khoNhan,
                    thuKho: _thuKho,
                    xuatNB: check.is(":checked") ? true : false,
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status >= 1) {
                        notify(result.text, "success");
                        reloadData();
                    }
                    else {
                        notify(result.text, "error");
                    }
                    $(".divLoading").removeClass("loading");
                    $('#closectphieuedit').trigger('click');

                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        });

        </script>

        <script type="text/javascript">
        function SaveQXN() {
