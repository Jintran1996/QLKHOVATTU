
@{
    ViewBag.Title = "Danh mục vật tư";
    var User = ViewBag.User;
    var istrue = ViewBag.istrue;
    var dmloaivt = ViewBag.dmloaivt as List<ToolsApp.EntityFramework.VatTu.VATTU2024_SPLOAD_LOAIVT_COA_Result>;
}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <!-- Section search -->
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <b>Tìm kiếm</b>
                        </h3>
                    </div>
                    <div class="card-body pad">
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Mã Vật Tư:</label>
                                    <input oninput="this.value = this.value.toUpperCase()" class="form-control form-control-sm" type="text" autocomplete="off"
                                           id="MAVTSearch" name="MAVTSearch" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Tên Vật Tư:</label>
                                    <input oninput="this.value = this.value.toUpperCase()" class="form-control form-control-sm" type="text" autocomplete="off"
                                           id="TENVTSearch" name="TENVTSearch" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Loại VT:</label>
                                    <div class="form-group">
                                        <select class="form-control form-control-sm chosen-select" id="LoaiVTSearch" name="LoaiVTSearch" autocomplete="off">
                                            <option value=""></option>
                                            @foreach (var item in dmloaivt)
                                            {
                                                <option value="@item.LoaiVT">
                                                    @item.LoaiVT || @item.TenLoaiVT
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </div>
                            </div>                          
                            <div class="col-md-12">
                                <div class="form-group">
                                    <button id="btnSearch" type="button" class="btn bg-gradient-primary" style="width: 120px; margin-right: 10px"><i class="fa fa-search"></i> Tìm</button>

                                    @if (User == "2464")
                                    {
                                        <button id="btnDongboMAVT" type="button" class="btn bg-gradient-primary" style="margin-right: 10px;"><i class="fas fa-recycle"></i> Đồng bộ MAVT</button>
                                    }

                                    @if (istrue == "1")
                                    {
                                <button id="btnDongboMAVT_NQTH"
                                        type="button"
                                        class="btn bg-gradient-primary"
                                        style="margin-right: 10px;"
                                        title="Đồng bộ mã vật tư theo loại vật tư">
                                    <i class="fas fa-recycle"></i> Đồng bộ Theo Loại VT
                                </button>

                                        <button id="UploadTemplate" onclick="OpenUploadExcel()" type="button" class="btn bg-gradient-info"><i class="far fa-file-excel"></i> Upload Excel</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--End section search-->
            </div>
        </div>
        <!--Section data table-->
        <div class="row">
            <div class="col-md-12">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <b>@ViewBag.Title </b>
                        </h3>
                    </div>
                    <div class="card-body pad">
                        <div class="row" style="margin-bottom:10px">
                            <div class="col-md-4">
                                <button id="btInsert" type="button" title="Thêm mới" class="btn bg-gradient-success" style="width: 120px"><i class="fa fa-plus"></i>&nbsp;Thêm mới</button>
                                &nbsp;
                                <button id="btnXuatExcel" onclick="EXPORT_EXCEL()" type="button" class="btn bg-gradient-info" style="white-space: nowrap; width: 120px "><i class="fa fa-file-excel"></i>&nbsp; Export Excel</button>
                                &nbsp;

                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 table-body table-responsive">

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /.col -->
        </div>
        <!--End section data table-->
    </div>
</section>

<!----------------FORM INSERT----------------->
<div id="myModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frm", id = "frm", enctype = "multipart/form-data" }))
            {

                <div class="modal-header">
                    <div class="modal-title" style="font-size: 17px;text-transform:uppercase;color:#3c8dbc"><strong id="myModalTitle"></strong></div>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div id="myModalContent">
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="text-right">
                        <button type="button" id="btSave" class="btn btn-sm btn-success" style="width: 100px"><i class="fa fa-save"></i>&nbsp;Lưu</button>

                        <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal" style="width: 100px"><i class="fa fa-close"></i>&nbsp;Đóng</button>
                    </div>
                </div>}
        </div>
    </div>
</div>
<!----------------FORM UPLOAD----------------->
<div id="myModalUpload" class="modal fade bd-example-modal-lg" role="dialog">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content">
            @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmUpload", id = "frmUpload", enctype = "multipart/form-data" }))
            {
                <div class="modal-header bg-gradient-blue">
                    <div class="modal-title" style="font-size: 17px;text-transform:uppercase;color:mintcream"><strong id="myModalTitleUpload"></strong></div>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div id="myModalContentUpload">
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="text-right">
                        <button type="button" class="btn btn-danger " data-dismiss="modal" style="width: 100px"><i class="fa fa-close"></i>&nbsp;Đóng</button>
                    </div>
                </div>}
        </div>
    </div>
</div>
<!------------------------------------------>
<!----------------FORM UPDATE----------------->
<div id="myModalUpdate" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <!-- Modal content-->
        <div class="modal-content">
            @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmUpdate", id = "frmUpdate", enctype = "multipart/form-data" }))
            {

                <div class="modal-header">
                    <div class="modal-title" style="font-size: 17px;text-transform:uppercase;color:#3c8dbc"><strong id="myModalTitleUpdate"></strong></div>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div id="myModalContentUpdate">
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="text-right">
                        <button type="button" id="btSave" onclick="reloadEdit()" class="btn btn-sm btn-success"><i class="fa fa-save"></i>&nbsp;Lưu</button>

                        <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal"><i class="fa fa-close"></i>&nbsp;Đóng</button>
                    </div>
                </div>}
        </div>
    </div>
</div>
<!------------------------------------------>

@section scripts{
    <script type="text/javascript">
        var config_ = {
            '.chosen-select-search': {},
            '.chosen-select-search-deselect': { allow_single_deselect: true },
            '.chosen-select-search-no-single': { disable_search_threshold: 10 },
            '.chosen-select-search-no-results': { no_results_text: 'Oops, nothing found!' },
            '.chosen-select-search-width': { width: "95%" },
            'search_contains': true
        }
        for (var selector in config_) {
            $(selector).chosen(config_);
        }

    </script>
    <script>
        function reloadData(page) {
            try {
            $.ajax({
                url: '@Url.Action("_GetList")',
                timeout: 20000,
                data: {
                    MAVTSearch: $("#MAVTSearch").val(), 
                    TENVTSearch: $("#TENVTSearch").val(),
                    LoaiVTSearch: $("#LoaiVTSearch").val(),
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body').html(response);

                    $("#myTable").DataTable({
                        "bFilter": true,
                        "bPaginate": true,
                        "bLengthChange": false,
                        "bInfo": true,
                        "responsive": true,
                        "lengthChange": true,
                        "autoWidth": false,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
        }
        function rowclick(this_) {
            $ID_SOCT = $('.' + this_).data("SystemKeyId");
            console.log($ID_SOCT);
            createCookie('SystemKey', $ID_SOCT, 10);
        }

        function Remove(Id_, Index_) {
            $('#row_' + Index_).attr("style", "display:none");

            $('#Detail_' + Index_ + '_Delete').val(true);
        }
    </script>
    <script type="text/javascript">
        var $ID_SOCT = "";

        var $modal = $('#myModal');
        var $myModalContent = $("#myModalContent");
        var $myModalTitle = $("#myModalTitle");

        var $modalUpload = $('#myModalUpload');
        var $myModalContentUpload = $("#myModalContentUpload");
        var $myModalTitleUpload = $("#myModalTitleUpload");

        var $modalUpdate = $('#myModalUpdate');
        var $myModalContentUpdate = $("#myModalContentUpdate");
        var $myModalTitleUpdate = $("#myModalTitleUpdate");

        $(document).ready(function () {
            reloadData(false);

            $("#btSave").click(function () {
                var confirm_ = confirm('Bạn có chắc muốn lưu ?');
                if (confirm_) {
                    form = $("#frm");
                    form.removeData('validator');
                    form.removeData('unobtrusiveValidation');
                    $.validator.unobtrusive.parse("#frm");
                    if (form.valid()) {
                        $.ajax({
                            url: $("#MAVT").val() == "@string.Empty" ? '@Url.Action("_InsertFun")' : '@Url.Action("_EditFun")',
                            type: "POST",
                            data: $('#frm').serialize(),
                            beforeSend: function (xhr) {
                                $(".divLoading").addClass("loading");
                                console.log($('#frm').serialize());
                            },
                            success: function (result) {
                                if (result.status >= 1) {
                                    notify(result.text, "success");

                                }
                                else {
                                    notify(result.text, "error");
                                }
                                $(".divLoading").removeClass("loading");
                                reloadData(true);
                               // reloadDataCT(true);
                               // reloadEdit(true);
                            },
                            error: function (message) {
                                $(".divLoading").removeClass("loading");
                            }
                        });
                    }
                }
            });

            $("#btInsert").click(function () {
                $myModalContent.html("");
                $myModalTitle.html("Thêm mới");
                $.ajax({
                    url: '@Url.Action("_DetailForEdit")',
                    timeout: 20000,
                    data: {
                        MAVT: '@string.Empty'
                    },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status <= 1) {
                            notify(result.text, "error");
                        }
                        else {
                            $myModalContent.html(result);
                            $modal.modal();
                        }
                        $(".divLoading").removeClass("loading");
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            });

            $("#myModal").on("hidden.bs.modal", function () {
                reloadData(false);
            });

            $("#btnSearch").click(function () {
                reloadData(true);
            });

            $("#btnUpload").click(function () {
                $myModalContentUpload.html("");
                $myModalTitleUpload.html("Upload");
                $.ajax({
                    url: '@Url.Action("_Upload")',
                    timeout: 20000,
                    data: {
                    },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        $myModalContentUpload.html(result);
                        $modalUpload.modal();

                        $(".divLoading").removeClass("loading");
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            });
        });

        $("#btnDongboMAVT").click(function () {

                    $.ajax({
                        url: '@Url.Action("_UpsertMAVTNS")',
                        type: "POST",
                        data: {
                        },
                        beforeSend: function (xhr) {
                            $(".divLoading").addClass("loading");
                        },
                        success: function (result) {
                            console.log(result.obj);
                            if (result.status >= 1) {
                                notify(result.text, "success");
                            }
                            else {
                                notify(result.text, "error");
                            }
                            $(".divLoading").removeClass("loading");
                        },
                        error: function (message) {
                            $(".divLoading").removeClass("loading");
                        }
                    });
        });

        $("#btnDongboMAVT_NQTH").click(function () {
                    $.ajax({
                        url: '@Url.Action("_UpsertMAVTNS_NQTH")',
                        type: "POST",
                        data: {
                            MAVTSearch: $("#MAVTSearch").val(),
                            TENVTSearch: $("#TENVTSearch").val(),
                            LoaiVTSearch: $("#LoaiVTSearch").val(),

                        },
                        beforeSend: function (xhr) {
                            $(".divLoading").addClass("loading");
                        },
                        success: function (result) {
                            console.log(result.obj);
                            if (result.status >= 1) {
                                notify(result.text, "success");
                            }
                            else {
                                notify(result.text, "error");
                            }
                            $(".divLoading").removeClass("loading");
                        },
                        error: function (message) {
                            $(".divLoading").removeClass("loading");
                        }
                    });
            });

        function Delete(MAVT_)
        {
            var confirm_ = confirm('Bạn có chắc muốn xóa mã này?');
            if (confirm_) {
                $.ajax({
                    url: '@Url.Action("_DeleteFun")',
                    timeout: 20000,
                    type: "POST",
                    data: { MAVT: MAVT_ },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status >= 1) {
                            notify(result.text, "success");
                        }
                        else {
                            notify(result.text, "error");
                        }

                        $(".divLoading").removeClass("loading");

                        reloadData(true);
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
        }

        function btnDongBo(MAVT_)
        {
            var confirm_ = confirm('Bạn có chắc muốn đồng bộ mã này?');
            if (confirm_) {
                $.ajax({
                    url: '@Url.Action("_btnDongBo")',
                    timeout: 20000,
                    type: "POST",
                    data: { MAVT: MAVT_ },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status >= 1) {
                            notify(result.text, "success");
                        }
                        else {
                            notify(result.text, "error");
                        }

                        $(".divLoading").removeClass("loading");

                        reloadData(true);
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
        }

        function Edit(MAVT_) {
            $myModalContent.html("");
            $myModalTitle.html("Cập nhật");
            $.ajax({
                url: '@Url.Action("_DetailForEdit")',
                timeout: 20000,
                data: {
                    MAVT: MAVT_
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status == null) {
                        $myModalContent.html(result);
                        $modal.modal();
                    }
                    else {
                        notify(result.text, "error");
                    }

                    $(".divLoading").removeClass("loading");
                },
                failure: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function OpenUploadExcel() {
                $myModalContentUpload.html("");
                $myModalTitleUpload.html("Tải lên");
                $.ajax({
                    url: '@Url.Action("_Upload")',
                    timeout: 20000,
                    data: {
                    },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        $myModalContentUpload.html(result);
                        $modalUpload.modal();

                        $(".divLoading").removeClass("loading");
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });

        };


        function EXPORT_EXCEL() {          
            $.ajax({
                url: '@Url.Action("_ExportExcelFun")',
                timeout: 200000000,
                type: "POST",
                data: {

                    MAVTSearch: $("#MAVTSearch").val(),
                    TENVTSearch: $("#TENVTSearch").val(),
                    LoaiVTSearch: $("#LoaiVTSearch").val(),
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status >= 1) {
                        window.location.href = result.obj;
                    }
                    else {
                        notify(result.text, "error");
                    }
                    $(".divLoading").removeClass("loading");
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function UploadTemplate() {
            form = $("#frmUpload");
            form.removeData('validator');
            form.removeData('unobtrusiveValidation');
            $.validator.unobtrusive.parse("#frmUpload");
            if (form.valid()) {
                var formdata = new FormData(); //FormData object
                var fileInput = document.getElementById('fuInputFile');
                formdata.append("fuInputFile", fileInput.files[0]);

                $.ajax({
                    url: "@Url.Action("_FunImport")",
                    type: "POST",
                    contentType: false,
                    processData: false,
                    data: formdata,
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status == 1) {
                            notify(result.text, "success");
                            $('.close').click();
                            reloadData(false);
                        }
                        else {
                            notify(result.text, "error");
                        }

                        $(".divLoading").removeClass("loading");
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
        }

    </script>
}
