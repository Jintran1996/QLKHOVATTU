@using System.Globalization;

@model ToolsApp.Models.PhieuYCMuaHangViewModels
@{
    var dmsoi = ViewBag.DMSOI as List<ToolsApp.EntityFramework.KhoSoi.SP_LOAD_DANHMUCSOI_2023_Result>;
    var kyhieudv = ViewBag.KYHIEUDV;
    var maphieu = ViewBag.MAPHIEU;
    var nguoixx = ViewBag.NGUOIXX as List<ToolsApp.EntityFramework.VatTu.SP_LOADXEMXETBYMANV_Result>;
    var loaidh = ViewBag.LOAIDH as List<ToolsApp.EntityFramework.KhoSoi.sp_Load_NL_DMloaidonhang_2023_Result>;
    var hieu = ViewBag.HIEU as List<ToolsApp.EntityFramework.KhoSoi.sp_Load_NL_DMNHACCAP_2023_Result>;
    var donviyc = ViewBag.DONVIYC as List<ToolsApp.EntityFramework.VatTu.SP_DonVi_Result>;
    var masocp = ViewBag.MASOCHIPHI as List<ToolsApp.EntityFramework.VatTu.SP_NL_LOADMSCP_2023_Result>;
    var loaiyc = ViewBag.LOAIYC as List<ToolsApp.EntityFramework.KhoSoi.spLoad_NL_DMYEUCAU_ByLoaidonhang_Result>;
}


@Html.ValidationSummary(true, "", new { @class = "text-danger" })
<input type="hidden" value="@Model.MAPHIEU" id="MaPhieu" />

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
<section class="content" style="font-size: 13px">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-sm-12">
                <div class=" card card-primary card-tabs">
                    <div class="card-header p-0 pt-1">
                        <ul class="nav nav-tabs" id="custom-tabs-one-tab" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active" id="custom-tabs-one-chuaduyet-tab" data-toggle="pill" href="#custom-tabs-one-chuaduyet" role="tab" aria-controls="custom-tabs-one-chuaduyet" aria-selected="true">Phiếu YC mua sợi</a>
                            </li>
                            <li class="nav-item" style="pointer-events: none;">
                                <a class="nav-link" id="custom-tabs-one-daduyet-tab" data-toggle="pill" href="#custom-tabs-one-daduyet" role="tab" aria-controls="custom-tabs-one-daduyet" aria-selected="false">Chi tiết phiếu</a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content" id="custom-tabs-one-tabContent">
                            <div class="tab-pane fade show active" id="custom-tabs-one-chuaduyet" role="tabpanel" aria-labelledby="custom-tabs-one-chuaduyet-tab">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="card card-primary card-outline">
                                            <div class="card-body pad">
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label>Người xem xét:</label>
                                                            <select id="pyc_nguoixx" name="NGUOIXX" class="form-control chosen-select" style="width: 100%;">
                                                                @foreach (var item in nguoixx) { <option value="@item.MANV"> @item.VT</option>}
                                                            </select>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Mã phiếu: </label>
                                                            <input type="text" class="form-control" id="pyc_maphieu" oninput="this.value = this.value.trim()" name="MAPHIEU" value="@maphieu" />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Loại đơn hàng: </label>
                                                            <select id="pyc_loaidh" name="LOAIDONHANG" class="form-control chosen-select" onchange="LoaiYC();" style="width: 100%;">
                                                                @foreach (var item in loaidh) { <option value="@item.LOAIDONHANG">@item.LOAIDONHANG: @item.Tendonhang</option>}
                                                            </select>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Thị trường:</label>
                                                            <div class="container-fluid">
                                                                <div class="row">
                                                                    <div class="form-check col-md-4">
                                                                        <input class="form-check-input" type="radio" name="ND" value="ND" id="pyc_rad_nd" checked>
                                                                        <label class="form-check-label" for="pyc_rad_nd">Nội địa</label>
                                                                    </div>
                                                                    <div class="form-check col-md-6">
                                                                        <input class="form-check-input" type="radio" name="ND" value="NK" id="pyc_rad_nk">
                                                                        <label class="form-check-label" for="pyc_rad_nk">Nhập khẩu</label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Kế hoạch:</label>
                                                            <div class="container-fluid">
                                                                <div class="row">
                                                                    <div class="form-check col-md-4">
                                                                        <input class="form-check-input" type="radio" name="KH" value="KH" id="pyc_rad_kh" checked>
                                                                        <label class="form-check-label" for="pyc_rad_kh">Kế hoạch</label>
                                                                    </div>
                                                                    <div class="form-check col-md-6">
                                                                        <input class="form-check-input" type="radio" name="KH" value="DX" id="pyc_rad_dx">
                                                                        <label class="form-check-label" for="pyc_rad_dx">Đột xuất</label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group">
                                                            <label>Người lập phiếu: </label>
                                                            <input type="text" class="form-control" id="pyc_nguoilp" name="NGUOILAPPHIEU" value="@User.Identity.Name" readonly />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Ký hiệu: </label>
                                                            <input type="text" class="form-control" id="pyc_kyhieu" name="KYHIEU" value="@kyhieudv" readonly />
                                                        </div>
                                                        <div class="form-group">
                                                            <label>Lý do sử dụng: </label>
                                                            <textarea class="form-control" id="pyc_ghichu" onclick="this.select();" name="LYDOSD" rows="7" cols="50"></textarea>

                                                        </div>
                                                        <div class="form-group" style="text-align:right">
                                                            <button type="button" class="btn btn-sm btn-primary" onclick="NhapTiep();">Nhập tiếp  <i class="fa fa-arrow-right" aria-hidden="true"></i></button>
                                                        </div>
                                                    </div>
                                                    <!-- /.col -->
                                                </div>
                                            </div>
                                            <!-- /.card -->
                                        </div>
                                    </div>
                                    <!-- /.col -->
                                </div>
                                <!-- Main content -->
                            </div>
                            <div class="tab-pane fade" id="custom-tabs-one-daduyet" role="tabpanel" aria-labelledby="custom-tabs-one-daduyet-tab">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="card card-primary card-outline">
                                            <div class="card-header">
                                                <h3 class="card-title">
                                                    <b>Chi tiết phiếu đề nghị mua hàng:</b>
                                                </h3>
                                            </div>
                                            <div class="card-body pad">
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="form-group row">
                                                            <div class="col-md-4">
                                                                <label>Mã phiếu:</label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                <input id="ct_pyc_maphieu" name="MAPHIEU" class="form-control" type="search" value="@maphieu"
                                                                       oninput="this.value = this.value.trim()" onchange="reloadCT()" />
                                                            </div>
                                                        </div>
                                                        <div class="form-group row">
                                                            <div class="col-md-4">
                                                                <label>Mã sợi:</label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                <select id="ct_pyc_mavattu" name="MAVT" class="form-control chosen-select" style="width: 100%;">
                                                                    @foreach (var item in dmsoi) { <option value="@item.MAVATTU">@item.MAVATTU</option>}
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="form-group row">
                                                            <div class="col-md-4">
                                                                <label>Nhãn hiệu:</label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                <select id="ct_pyc_hieu" name="HIEU" class="form-control chosen-select" style="width: 100%;">
                                                                    @foreach (var item in hieu) {<option value="@item.HIEU">@item.HIEU</option>}
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="form-group row">
                                                            <div class="col-md-4">
                                                                <label>Số lượng:</label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                <input id="ct_pyc_soluong" name="SLYCAU" class="form-control"
                                                                       onclick="this.select();" type="number" step="0.001" min="0" value="0.000" />
                                                            </div>
                                                        </div>

                                                        <div class="form-group row">
                                                            <div class="col-md-4">
                                                                <label>Tình trạng:</label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                <input id="ct_pyc_tinhtrang" name="TINHTRANG" class="form-control" type="text" />
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <div class="form-group row">
                                                            <div class="col-md-4">
                                                                <label>Đơn vị YC mua:</label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                <select id="ct_pyc_donvi" name="IDMaDV_YCMUA" class="form-control chosen-select" style="width: 100%;">
                                                                    @foreach (var item in donviyc){<option value="@item.MaDonVi">@item.MaDonVi: @item.TenDonVi</option>}
                                                                </select>
                                                            </div>
                                                        </div>
                                                    

                                                        <div class="form-group row">
                                                            <div class="col-md-4">
                                                                <label>Thời điểm SD:</label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                <input value="@DateTime.Now.AddDays(3).ToString("dd/MM/yyyy")"
                                                                       class="form-control" type="text" autocomplete="off"
                                                                       id="ct_pyc_thoidiemsd" name="THOIDIEMSD_" />
                                                            </div>
                                                        </div>

                                                        <div class="form-group row">
                                                            <div class="col-md-4">
                                                                <label>Loại yêu cầu:</label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                <select id="ct_pyc_loaiyc" name="LOAIYEUCAU" class="form-control chosen-select" style="width: 100%;">
                                                                    @foreach (var item in loaiyc)
                                                                    {<option value="@item.LOAIYEUCAU">@item.TENLOAIIYC</option>}
                                                                </select>
                                                            </div>
                                                        </div>

                                                        <div class="form-group row">
                                                            <div class="col-md-4">
                                                                <label>Ghi chú:</label>
                                                            </div>
                                                            <div class="col-md-8">
                                                                <textarea class="form-control" id="ct_pyc_ghichu" onclick="this.select();" name="GHICHU" rows="1" cols="50"></textarea>
                                                            </div>
                                                        </div>

                                                    </div>
                                                    <div class="col-md-12" style="text-align:right">
                                                        <button type="button" id="btSaveCT" onclick="LuuCT();reloadCT();" class="btn btn-sm btn-success"><i class="fa fa-save"></i>&nbsp;Lưu</button>
                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /.card -->
                                        </div>
                                    </div>
                                    <!-- /.col -->
                                </div>
                                <!-- Main content -->
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="card card-primary card-outline">
                                            <div class="card-header">
                                                <h3 class="card-title">
                                                    <b>Danh sách vật tư đã lưu</b>
                                                </h3>
                                            </div>
                                            <div class="card-body pad">
                                                <div class="row">
                                                    <div class="col-md-12 table-body-ctphieu table-responsive">
                                                        <div class="sidebar-mini layout-fixed layout-navbar-fixed layout-footer-fixed text-sm sidebar-collapse">

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script type="text/javascript">
    $(function () { // will trigger when the document is ready
        $('.datepicker').datepicker(); //Initialise any date pickers
    });

</script>

<script type="text/javascript">
    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }
    $("#ct_pyc_thoidiemsd").datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true,
        onClose: function (selectedDate) {
            //$("#FromDate").datepicker("option", "minDate", selectedDate);
        }
    });

    function reloadCT(maphieu_) {
        try {
            $.ajax({
                url: '@Url.Action("_GetListCTPhieu")',
                timeout: 20000,
                data: {
                    maphieu: maphieu_ == null ? $("#ct_pyc_maphieu").val() : maphieu_
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-ctphieu').html(response);

                    $("#myTableCT").DataTable({
                        destroy: true,
                        "bFilter": true,
                        "bPaginate": false,
                        "bLengthChange": false,
                        "bInfo": false,
                        "responsive": true,
                        "lengthChange": false,
                        "autoWidth": false,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },

                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }
        catch (e) {
        }
    };

    function ClickSecondTab() {
        var maphieu = $('#pyc_maphieu').val();
        $('#ct_pyc_maphieu').val(maphieu);
        reloadCT(maphieu);
        $('[href="#custom-tabs-one-daduyet"]').tab('show');
    }

    function NhapTiep() {
        form = $("#frm");
        form.removeData('validator');
        form.removeData('unobtrusiveValidation');
        $.validator.unobtrusive.parse("#frm");
        if (form.valid()) {
            $.ajax({
                url: '@Url.Action("_InsertFun")',
                type: "POST",
                data: $('#frm').serialize(),
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                    //console.log($('#frm').serialize());
                },
                success: function (result) {
                    if (result.status >= 1) {
                        if (result.status == 1) {
                            notify(result.text, "success");
                        }
                        if (result.status == 2) {
                            notify(result.text, "info");
                        }
                        reloadData();
                        ClickSecondTab();
                    }
                    else {
                        notify(result.text, "error");
                    }
                    $(".divLoading").removeClass("loading");
                    console.log(result.text);
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }
    }

    function LuuCT() {
        form = $("#frm");
        form.removeData('validator');
        form.removeData('unobtrusiveValidation');
        $.validator.unobtrusive.parse("#frm");
        if (form.valid()) {
            $.ajax({
                url: '@Url.Action("_InsertCTPhieuFun")',
                type: "POST",
                data: $('#frm').serialize(),
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                    console.log($('#frm').serialize());
                },
                success: function (result) {
                    if (result.status >= 1) {
                        notify(result.text, "success");
                    }
                    else {
                        notify(result.text, "error");
                    }
                    reloadCT();
                    $(".divLoading").removeClass("loading");

                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }
    }

    function DeleteCT_AD(khoa_)
        {
            var confirm_ = confirm('Bạn có chắc muốn xóa mã này?');
            if (confirm_) {
                $.ajax({
                    url: '@Url.Action("_DeleteCTFun")',
                    timeout: 20000,
                    type: "POST",
                    data: { khoathamchieu: khoa_ },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status >= 1) {
                            notify(result.text, "success");
                        }
                        else {
                            notify(result.text, "error");
                        }
                        $(".divLoading").removeClass("loading");
                        reloadCT();

                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
        }
    function LoaiYC() {
        var _loaidh = $("#pyc_loaidh").val();
        var loaiycID = $("#ct_pyc_loaiyc");
        loaiycID.empty();
        $.ajax({
            url: '@Url.Action("LoaiYeuCau")',
            type: "POST",
            timeout: 10000,
            data: { loaidh: _loaidh },
            success: function(result) {
                $.each(result.obj, function (i, state) {
                    loaiycID.append($('<option/>', { value: this.LOAIYEUCAU }).html(this.TENLOAIIYC));
                });
                loaiycID.trigger("chosen:updated");
            },
        });
    }
</script>

