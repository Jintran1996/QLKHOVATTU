
@{
    ViewBag.CTPhieu = "Danh Sách Xuất Kho";

    //  var madh = ViewBag.madh as List<ToolsApp.EntityFramework.QuanLyKhoMoc2023.Sp_API_LoadDonHang_CoKeyHH_Result>;
    // var APIs = ViewBag.APIs as IEnumerable<ToolsApp.EntityFramework.QuanLyKhoMoc2023.tblphieukho>;

    var MAHTHUC = ViewBag.MAHTHUC;

    var DMLO = ViewBag.DMLO as List<ToolsApp.EntityFramework.KhoSoi.SP_LOAD_NL_DMLO_BY_HIEU_Result>;
    var NL_DMNHACCAP = ViewBag.NL_DMNHACCAP as List<ToolsApp.EntityFramework.KhoSoi.NL_DMNHACCAP>;
    var Masoi_hknvl = ViewBag.Masoi_hknvl as List<ToolsApp.EntityFramework.KhoSoi.VATTU2024_SPLOAD_DMNGUYENLIEUSOI_Result>;
    var MAKHONHAN = ViewBag.MAKHONHAN;
    var MAKHOXUAT = ViewBag.MAKHOXUAT;



}
@using System.Globalization;
@model ToolsApp.Models.NL_CTXUATNHAPViewModels


<input class="form-control" type="text" autocomplete="off"
       id="hidenSOCTXN" name="SophieuN_CT" value="@Model.SOCTXN.Trim()" hidden />
<input class="form-control" type="text" autocomplete="off"
       id="hidenMAKHONHAN" value="@MAKHONHAN.Trim()" hidden />
<input class="form-control" type="text" autocomplete="off"
       id="hidenMAKHOXUAT" value="@MAKHOXUAT.Trim()" hidden />
<input class="form-control" type="text" autocomplete="off"
       id="hidenMAHTHUC" name="SophieuN_CT" value="@MAHTHUC.Trim()" hidden />



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-md-12">
                <div class="card card-info card-tabs" id="myTap">
                    <div class="card-header p-0 pt-1">
                        <ul class="nav nav-tabs" id="custom-tabs-one-tab" role="tablist">
                            <li class="nav-item" id="tab-1">
                                <a class="nav-link active" id="custom-tabs-one-home-tab-getlist-ctphieu" style="display:block;" data-toggle="pill" href="#custom-tabs-one-home-ct" role="tab" aria-controls="custom-tabs-one-home-ct" aria-selected="true">Danh sách chi tiết phiếu @Model.SOCTXN </a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content" id="custom-tabs-one-tabContent">
                            <div class="tab-pane fade col-md-12 show active" id="custom-tabs-one-home-ct" role="tabpanel" aria-labelledby="custom-tabs-one-home-tab-getlist-ctphieu">
                                <!--data-->
                                @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmctphieuXN", id = "frmctphieuXN", enctype = "multipart/form-data" }))
                                {
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="row ">
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3">SOCTXN :</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="text" autocomplete="off" value="@Model.SOCTXN" readonly
                                                                   id="SOCTXN_CT" name="SOCTXN" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">Loại đơn hàng:</label>
                                                        <div class="col-md-9">
                                                            <select class="form-control chosen-select" id="LOAIDONHANG" name="LOAIDONHANG">
                                                                <option value="INKH"> INKH</option>
                                                                <option value="OUTKH"> OUTKH</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3">Ngày kế toán:</label>
                                                        <div class="col-md-9">
                                                            <input id="NGAYKETOAN" name="NGAYKETOAN_" value="@DateTime.Now.ToString("dd/MM/yyyy")" class="form-control" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3">Mã sợi :</label>
                                                        <div class="col-md-9">
                                                            <select class="form-control chosen-select" id="MAVT" name="MAVT">
                                                                <option selected value="">-- Chọn mã sợi --</option>
                                                                @foreach (var item in Masoi_hknvl)
                                                                {
                                                                    <option value="@item.MAVATTU">
                                                                        @item.MAVATTU || @item.Tenvattu
                                                                    </option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3">Hiệu:</label>
                                                        <div class="col-md-9">
                                                            <select class="form-control chosen-select" id="HIEU" name="HIEU" onchange="_Load_DMLO()">
                                                                <option selected value="">-- Chọn hiệu --</option>
                                                                @foreach (var item in NL_DMNHACCAP)
                                                                {
                                                                    <option value="@item.HIEU"> @item.HIEU</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">LÔ: </label>
                                                        <div class="col-md-9">
                                                            <select class="form-control" id="LO" name="LO">
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">Số lượng:</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="number" autocomplete="off" value="0.00" min="0"
                                                                   id="SOLUONGTT" name="SOLUONGTT" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">Ghi chú:</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="text" autocomplete="off" value=""
                                                                   id="GHICHU" name="GHICHU" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div>                                               
                                                @*Row 3*@
                                                <div class="row">
                                                </div>
                                                <div class="row">
                                                </div>
                                                <div class="text-center">
                                                    <button type="button" id="btSavect_HK" class="btn btn-sm btn-primary" style="width: 100px"><i class="fa fa-save"></i>&nbsp;Lưu</button>

                                                </div>

                                            </div>
                                            <div class="card-body pad">
                                                <div class="row">
                                                    <div class="col-md-12 table-body-view-ctphieu  table-responsive">

                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /.card -->
                                        </div>
                                        <!--data-->
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</body>
</html>


<script>
    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }




    function reloadData_getlist_ctphieu() {
        var SOCTXN_ = $("#SOCTXN_CT").val();

            try {
            $.ajax({
                url: '@Url.Action("_GetListCTPhieu_View")',
                timeout: 20000,
                data: {
                    SOCTXN: SOCTXN_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-view-ctphieu').html(response);

                    $("#myTablectview").DataTable({
                        //"responsive": true,
                        "lengthChange": true,
                        "autoWidth": true,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
    }



     function _Load_DMLO() {

        var HIEUid = $("#HIEU").val();
       // var MAVTid = $("#MAVT").val();
        var MAVTid = "";
        var LOid = $("#LO");
        var MADINHMUCID = $("#MADINHMUC");
        LOid.empty();     

            $.ajax({
                url: '@Url.Action("_Load_DMLO")',
                timeout: 20000,
                type: "POST",
                data: {
                    HIEUid: HIEUid, MAVTid: MAVTid
                },
                success: function (result) {

                    $.each(result.obj, function (i, state) {
                        LOid.append($('<option/>', { value: this.LO }).html(this.LO));
                    });
                    LOid.trigger("chosen:updated");           


                 //   updateInputValue();

                }
            });
    }

</script>

<script type="text/javascript">
    $("#NGAYKETOAN").datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true,
        onClose: function (selectedDate) {
            //$("#FromDate").datepicker("option", "minDate", selectedDate);
        }
    });
    $(document).ready(function () {
        reloadData_getlist_ctphieu(false);




        $("#btSavect_HK").click(function () {
            var hidenMAKHONHAN = $("#hidenMAKHONHAN").val();
            var hidenMAKHOXUAT = $("#hidenMAKHOXUAT").val();
            var hidenMAHTHUC = $("#hidenMAHTHUC").val();
            var hidenSOCTXN = $("#hidenSOCTXN").val();

            form = $("#frmctphieuXN");
                form.removeData('validator');
                form.removeData('unobtrusiveValidation');
            $.validator.unobtrusive.parse("#frmctphieuXN");
                if (form.valid()) {
                    $.ajax({
                         url: '@Url.Action("_InsertFunCTPhieu_HK")',
                        type: "POST",
                        data: $('#frmctphieuXN').serialize(),
                        beforeSend: function (xhr) {
                            $(".divLoading").addClass("loading");
                        },
                        success: function (result) {
                            if (result.status >= 1) {
                                notify(result.text, "success");
                              //  Details(hidenSOCTXN, "", hidenMAHTHUC, hidenMAKHO); // LOAD LẠI FORM DETAILS
                                reloadData_getlist_ctphieu();
                            }
                            else {
                                notify(result.text, "error");
                            }
                            $(".divLoading").removeClass("loading");
                        },
                        error: function (message) {
                            $(".divLoading").removeClass("loading");
                        }
                    });
                }
            });
    })
</script>








