
@{

    var SOCTXN_nhap = ViewBag.SOCTXN_nhap;
    var DANHMUCMAVT = ViewBag.DANHMUCMAVT as List<ToolsApp.EntityFramework.VatTu.VATTU2024_SPLOAD_DANHMUCVATTU_Result>;
    var MAKHONHAN = ViewBag.MAKHONHAN;
    var MAKHOXUAT = ViewBag.MAKHOXUAT;
    var LOAIXN = ViewBag.LOAIXN;

}
@using System.Globalization;
@model ToolsApp.Models.XUATNHAPViewModels


<input class="form-control" type="text" autocomplete="off"
       id="hidenSOCTXN_NHGA" value="@SOCTXN_nhap.Trim()" hidden />
<input class="form-control" type="text" autocomplete="off"
       id="hidenMAKHONHAN_NHGA" value="@MAKHONHAN.Trim()" hidden />
<input class="form-control" type="text" autocomplete="off"
       id="hidenMAKHOXUAT_NHGA" value="@MAKHOXUAT.Trim()" hidden />
<input class="form-control" type="text" autocomplete="off"
       id="hidenLOAIXN_NHGA" value="@LOAIXN.Trim()" hidden />



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-md-12">
                <div class="card card-info card-tabs" id="myTap">
                    <div class="card-header p-0 pt-1">
                        <ul class="nav nav-tabs" id="custom-tabs-one-tab" role="tablist">
                            <li class="nav-item" id="tab-1">
                                <a class="nav-link active" id="custom-tabs-one-home-tab-getlist-ctphieu" style="display:block;" data-toggle="pill" href="#custom-tabs-one-home-ct" role="tab" aria-controls="custom-tabs-one-home-ct" aria-selected="true">Danh sách chi tiết phiếu @SOCTXN_nhap </a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content" id="custom-tabs-one-tabContent">
                            <div class="tab-pane fade col-md-12 show active" id="custom-tabs-one-home-ct" role="tabpanel" aria-labelledby="custom-tabs-one-home-tab-getlist-ctphieu">
                                <!--data-->
                                @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmctphieu_NHGA", id = "frmctphieu_NHGA", enctype = "multipart/form-data" }))
                                {
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="row ">
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3">SOCTXN :</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="text" autocomplete="off" value="@SOCTXN_nhap" readonly
                                                                   id="SOCTXN_CT" name="SoCTXN" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">Mã kho:</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="text" autocomplete="off"
                                                                   id="MaKho_NHGA" name="MaKho" value="@MAKHONHAN.Trim()" readonly />
                                                            <input class="form-control" type="text" autocomplete="off"
                                                                   id="LoaiXN_NHGA" name="LoaiXN" value="@LOAIXN.Trim()" hidden />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3">Ngày kế toán:</label>
                                                        <div class="col-md-9">
                                                            <input id="NGAYKETOAN_NHGA" name="NgayKeToan" value="@DateTime.Now.ToString("dd/MM/yyyy")" class="form-control" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3">Mã VT :</label>
                                                        <div class="col-md-9">
                                                            <select class="form-control chosen-select" id="MAVT_NHGA" name="MAVT">
                                                                <option selected value="">-- Chọn mã VT --</option>
                                                                @foreach (var item in DANHMUCMAVT)
                                                                {
                                                                    <option value="@item.MAVT">
                                                                        @item.MAVT || @item.TenVT
                                                                    </option>
                                                                }
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">Số lượng:</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="text" autocomplete="off"
                                                                   id="SoLuongTT_NHGA" name="SoLuongTT" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">Ghi chú:</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="text" autocomplete="off" value=""
                                                                   id="GHICHU_NHGA" name="GHICHU" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">Mã phiếu PD:</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="text" autocomplete="off" value=""
                                                                   id="Maphieupd_NHGA" name="MAPHIEUPD" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row" style="margin-bottom:20px">
                                            </div>
                                            <div>
                                                @*Row 3*@
                                                <div class="row">
                                                </div>
                                                <div class="row">
                                                </div>
                                                <div class="text-center">
                                                    <button type="button" id="btSavect_NHGA" onclick="_Insert_ctphieu_NHGA()" class="btn btn-primary" style="width: 100px"><i class="fa fa-save"></i>&nbsp;Lưu</button>

                                                </div>

                                            </div>
                                            <div class="row" style="margin-bottom:20px">
                                            </div>
                                            <div class="card-body pad">
                                                <div class="row">
                                                    <div class="col-md-12 table-body-view-ctphieu-nhga  table-responsive">

                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /.card -->
                                        </div>
                                        <!--data-->
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</body>
</html>


<script>
    const soLuongInput = document.getElementById("SoLuongTT_NHGA");

    soLuongInput.addEventListener("input", function () {
        // Loại bỏ ký tự không phải số hoặc dấu chấm
        let raw = this.value.replace(/[^0-9.]/g, "");

        // Chỉ cho phép duy nhất 1 dấu chấm
        let parts = raw.split(".");
        if (parts.length > 2) {
            raw = parts[0] + "." + parts.slice(1).join("");
        }

        if (raw.length > 0) {
            this.value = "-" + raw;
        } else {
            this.value = "";
        }
    });

    // Chặn nhập ký tự không phải số hoặc dấu chấm từ bàn phím
    soLuongInput.addEventListener("keypress", function (e) {
        if (!/[0-9.]/.test(e.key)) {
            e.preventDefault();
        }
    });
</script>


<script>
    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }


    function reloadData_getlist_ctphieu() {
        var SOCTXN_ = $("#SOCTXN_CT").val();
            try {
            $.ajax({
                url: '@Url.Action("_GetListCTPhieu_View")',
                timeout: 20000,
                data: {
                    SOCTXN: SOCTXN_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-view-ctphieu-nhga').html(response);

                    $("#myTablectview").DataTable({
                        //"responsive": true,
                        "lengthChange": true,
                        "autoWidth": true,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
    }


    function _Insert_ctphieu_NHGA() {

        var LOAIXN = $("#hidenLOAIXN_NHGA").val();
        var SOCTXN = $("#hidenSOCTXN_NHGA").val();
        var MAKHONHAN = $("#hidenMAKHONHAN_NHGA").val();
        var MAVT_NHGA = $("#MAVT_NHGA").val();
        var NGAYKETOAN_NHGA = $("#NGAYKETOAN_NHGA").val();
        var SoLuongTT_NHGA = $("#SoLuongTT_NHGA").val();
        var GHICHU_NHGA = $("#GHICHU_NHGA").val();
        var Maphieupd_NHGA = $("#Maphieupd_NHGA").val();

        console.log(LOAIXN, SOCTXN, MAKHONHAN);

        $.ajax({
            url: '@Url.Action("_InsertFunCTPhieu_NHGA")',
            timeout: 2000000,
            type: "POST",
            data: { LOAIXN: LOAIXN, SOCTXN: SOCTXN, MAKHONHAN: MAKHONHAN, MAVT_NHGA: MAVT_NHGA, NGAYKETOAN_NHGA: NGAYKETOAN_NHGA, SoLuongTT_NHGA: SoLuongTT_NHGA, GHICHU_NHGA: GHICHU_NHGA, Maphieupd_NHGA: Maphieupd_NHGA },
            beforeSend: function (xhr) {
                $(".divLoading").addClass("loading");
            },
            success: function (result) {
                if (result.status >= 1) {
                    notify(result.text, "success");
                    Details(SOCTXN, LOAIXN); // LOAD LẠI FORM DETAILS
                }
                else {
                    notify(result.text, "error");
                }
                $(".divLoading").removeClass("loading");
            },
            error: function (message) {
                $(".divLoading").removeClass("loading");
            }
        });
    };
</script>

<script type="text/javascript">
    $("#NGAYKETOAN").datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true,
        onClose: function (selectedDate) {
            //$("#FromDate").datepicker("option", "minDate", selectedDate);
        }
    });
    $(document).ready(function () {
        reloadData_getlist_ctphieu(false);
    })
</script>







