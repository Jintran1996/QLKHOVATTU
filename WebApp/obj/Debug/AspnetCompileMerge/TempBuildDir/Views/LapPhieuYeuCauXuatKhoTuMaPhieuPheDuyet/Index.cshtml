    <!--Chuyển Base-->
    <script type="text/javascript">
        var $myModalDetailReport = $('#myModalDetailReport');
        var $myModalContentDetailReport = $("#myModalContentDetailReport");
        var $myModalTitleDetailReport = $("#myModalTitleDetailReport");

        $(document).ready(function () {
            _Phieu_Action();
            reloadData(false);

            $("#myModal").on("hidden.bs.modal", function () {
                reloadData(false);
            });

            $("#btnSearch").click(function () {
                reloadData(true);
            });
        });

        //-------------Tao Phieu Moi Click--------------//
        function New_Phieu_Click() {
            _Phieu_Action();
            reloadData(false);
        }


        //-------------Click load mã vật tư--------------//
        function Load_GetListMaVatTu_Onchange() {
        var SoChungTu = $("#SoChungTu").val();
        var MaPhieuPD = $("#MaPhieuPD").val();
        var MaKho = $("#MaKho").val();
        _GetList_MaVatTu(MaPhieuPD, MaKho, SoChungTu);
        }


        //-------------Click Next page--------------//
        function Action_Next_Click() {
            var index_ = $("#Stt_Tamp").val();
            var SoChungTu = $("#SoChungTu").val();
            var MaPhieuPD = $("#MaPhieuPD").val();
            var MaKho = $("#MaKho").val();
            var LoaiXuatNhap = $("#LoaiXuatNhap").val();
            var GhiChu = $("#GhiChu").val();
            for (var i = 0; i <= index_; i = i + 1) {
                var tamp_ = $('#check_MaVatTu_' + i);
                if (tamp_.is(':checked')) {
                    var tamp_MaVt = $("#data_MAVT_"+i).val();
                    var tamp_TenVT = $("#data_TenVT_"+i).val();
                    var tamp_SLTONTHEOMAPHIEUPB = $("#data_SLTONTHEOMAPHIEUPB_"+i).val();
                    var tamp_SLPD = $("#data_SLPD_"+i).val();
                    var tamp_SLXK = $("#data_SLXK_" + i).val();
                    insert_record(tamp_MaVt, tamp_TenVT, MaPhieuPD, tamp_SLTONTHEOMAPHIEUPB, tamp_SLPD, tamp_SLXK, SoChungTu, MaKho, LoaiXuatNhap, GhiChu);


                }
            }

        }



        function insert_record(tamp_MaVt, tamp_TenVT, MaPhieuPD, tamp_SLTONTHEOMAPHIEUPB, tamp_SLPD, tamp_SLXK, SoChungTu, MaKho, LoaiXuatNhap, GhiChu) {
            $.ajax({
                url: '@Url.Action("_btn_Next_Click")',
                type: "POST",
                data: {
                    MaVt: tamp_MaVt
                    , TenVT: tamp_TenVT
                    , MaPhieuPD: MaPhieuPD
                    , SLTONTHEOMAPHIEUPB: tamp_SLTONTHEOMAPHIEUPB
                    , SLPD: tamp_SLPD
                    , SLXK: tamp_SLXK
                    , SoChungTu: SoChungTu
                    , MaKho: MaKho
                    , LoaiXuatNhap: LoaiXuatNhap
                    , GhiChu: GhiChu
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    $(".divLoading").removeClass("loading");
                    if (result.status < 0) {
                        notify(result.text, "error");
                    }
                    _GetList_MaVatTu_DaChon(SoChungTu);
                    _GetList_MaVatTu(MaPhieuPD, MaKho, SoChungTu);
                },
                error: function (message) {
                    console.log(message);
                }
            });
        }

        //-------------Click back page--------------//
        function Action_Back_Click() {
            var index_ = $("#Stt_dact_Tamp").val();
            var SoChungTu = $("#SoChungTu").val();
            var MaKho = $("#MaKho").val();
            var MaPhieuPD = $("#MaPhieuPD").val();
            for (var i = 0; i <= index_; i = i + 1) {
                var tamp_ = $('#check_MaVatTu_DaChon_' + i);
                if (tamp_.is(':checked')) {
                    var tamp_MaVt = $("#data_CT_MAVT_" + i).val();
                    var tamp_MANVYC = $("#data_CT_MANVYC_" + i).val();
                    delete_record(SoChungTu, tamp_MaVt, tamp_MANVYC, MaKho, MaPhieuPD);
                }
            }

        }


        function delete_record(SoChungTu, tamp_MaVt, tamp_MANVYC, MaKho, MaPhieuPD) {
            $.ajax({
                url: '@Url.Action("_btn_back_Click")',
                type: "POST",
                data: {
                    MaVt: tamp_MaVt
                    , SoChungTu: SoChungTu
                    , MaKho: MaKho
                    , MANVYC: tamp_MANVYC
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    $(".divLoading").removeClass("loading");
                    if (result.status < 0) {
                        notify(result.text, "error");
                    }
                    _GetList_MaVatTu_DaChon(SoChungTu);
                    _GetList_MaVatTu(MaPhieuPD, MaKho, SoChungTu);
                },
                error: function (message) {
                    console.log(message);
                }
            });
        }

        //-----------------Action print----------------//
        function printReport() {
                $myModalContentDetailReport.html("");
                $myModalTitleDetailReport.html("Phiếu yêu cầu xuất kho vật tư hàng hoá - đơn vị" );
            var SoChungTu = $('#SoChungTu').val();
            var makho = $('#MaKho').val();

                $.ajax({
                    url: '@Url.Action("print_Phieu")',
                    timeout: 200000,
                    data: {
                        SoChungTu: SoChungTu,
                            makho: makho,
                    },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                }).done(function (data) {
                    if (data.status == null) {
                        $(".divLoading").removeClass("loading");
                        $myModalContentDetailReport.html(data);
                        $myModalDetailReport.modal();
                    }
                    else {
                        $(".divLoading").removeClass("loading");
                        notify(data.text, "error");
                    }
                }).fail(function (data) {
                    notify(data.text, "error");
                });
        }


    </script>
}

