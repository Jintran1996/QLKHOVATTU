<section>
    <div class="card card-primary card-outline">
        <div class="card-header">
            <h3 class="card-title">
                <b>Tìm kiếm phiếu để đồng bộ từ Netsuite</b>
            </h3>
        </div>
        <div class="card-body col-md-12 row">
            <div class="col-md-4">
                <div class="form-group">
                    <div class="input-group">
                        <input class="form-control input-group-append" type="text" id="IDSearch" placeholder="Nhập mã phiếu" style="flex-grow: 1;">
                        <div class="input-group-append">
                            <button class="btn bg-gradient-primary" id="btnSearch" onclick="btnSearch()"><i class="fa fa-search"></i> Tìm kiếm</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card card-primary card-outline">
                <div class="card-header">
                    <h3 class="card-title">
                        <b>Danh sách phiếu yêu cầu mua hàng</b>
                    </h3>
                </div>
                <div class="card-body pad">
                    <div class="row">
                        <div class="col-md-12 table-body table-responsive">

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="myModalDetail" class="modal fade modal-wide " role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmDetail", id = "frmDetail", enctype = "multipart/form-data" }))
                {
                    <div class="modal-header bg-gradient-blue">
                        <div class="modal-title" style="font-size: 17px;text-transform:uppercase;color:mintcream"><strong id="myModalTitleDetail"></strong></div>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <div id="myModalContentDetail">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="text-right">
                            <button type="button" class="btn btn-danger" data-dismiss="modal" style="width: 100px"><i class="fa fa-close"></i>&nbsp;Đóng</button>
                        </div>
                    </div>}
            </div>
        </div>
    </div>
    <div id="myModalPrint" class="modal fade modal-wide" role="dialog">
        <div class="modal-dialog">
            <!-- Modal content-->
            <div class="modal-content">
                @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frm", id = "frm", enctype = "multipart/form-data" }))
                {

                    <div class="modal-header">
                        <div class="modal-title" style="font-size: 17px;text-transform:uppercase;color:#3c8dbc"><strong id="myModalTitlePrint"></strong></div>
                        <button type="button" class="close" data-dismiss="modal">&times;</button>
                    </div>
                    <div class="modal-body">
                        <div id="myModalContentPrint">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <div class="text-right">
                            <button type="button" id="btPrint" onclick="javascript:CallPrint('myModalContentPrint');" class="btn btn-sm btn-success" style="width: 100px"><i class="fa fa-print"></i>&nbsp;In</button>
                            <button type="button" class="btn btn-danger " data-dismiss="modal" style="width: 100px"><i class="fa fa-close"></i>&nbsp;Đóng</button>
                        </div>
                    </div>}
            </div>
        </div>
    </div>
</section>
@section scripts{
    <script language="javascript" type="text/javascript">
        function CallPrint(strid) {
            var prtContent = document.getElementById(strid);
            var WinPrint = window.open('', '', 'left=0,top=0,width=800,height=900,toolbar=0,scrollbars=0,status=0');
            WinPrint.document.write(prtContent.innerHTML);
            WinPrint.document.close();
            WinPrint.focus();
            WinPrint.print();
            WinPrint.close();
        }

    </script>
    <script type="text/javascript">

        var $modalDetail = $('#myModalDetail');
        var $myModalContentDetail = $("#myModalContentDetail");
        var $myModalTitleDetail = $("#myModalTitleDetail");

        var $modalPrint = $('#myModalPrint');
        var $myModalContentPrint = $("#myModalContentPrint");
        var $myModalTitlePrint = $("#myModalTitlePrint");


        function btnCapnhat(maphieu_) {
            $.ajax({
                url: '@Url.Action("_Dongbo")',
                timeout: 20000,
                data: {
                    //maphieu: $("#IDSearch").val()
                    maphieu: maphieu_
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");
                    if (response.status < 0) {
                        notify(response.text, "error");
                    } else {
                        notify(response.text, "success");

                    }
                    return GetList();
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }


        function Details(maphieu_) {
            $myModalContentDetail.html("");
            $myModalTitleDetail.html("Chi tiết");
            $.ajax({
                url: '@Url.Action("_Details")',
                timeout: 20000,
                data: {
                    maphieu: maphieu_
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    $myModalContentDetail.html(result);
                    $modalDetail.modal();
                    $(".divLoading").removeClass("loading");
                },
                failure: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

        function Print(maphieu_) {
             $.ajax({
                url: '@Url.Action("_ReportPrintCT")',
                timeout: 20000,
                type: "GET",
                 data: {
                     maphieu: maphieu_,
                 },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                 success: function (result) {
                     if (result.status < 0) {
                         notify(result.text, "error");
                     }
                     else {
                         $myModalContentPrint.html(result);
                         $modalPrint.modal();
                         $(".divLoading").removeClass("loading");
                     }
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

    </script>

    <script type="text/javascript">

        function btnSearch() {
            GetList();
        }
        function GetList() {
            try {
            $.ajax({
                url: '@Url.Action("GetList")',
                type: "GET",
                data: {
                    maphieu: $("#IDSearch").val()
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status < 0) {
                        notify(result.text, "error");
                        $(".divLoading").removeClass("loading");
                    }
                    else {
                        $('.table-body').html(result);
                        $("#myTable").DataTable({
                            destroy: true,
                            "language": {
                                "sProcessing": "Đang xử lý...",
                                "sLengthMenu": " Hiển thị _MENU_ dữ liệu",
                                "sZeroRecords": "Không tìm thấy kết quả",
                                "sEmptyTable": "Không có dữ liệu",
                                "sInfo": "Hiển thị _START_ tới _END_ của _TOTAL_ dữ liệu",
                                "sInfoEmpty": "Hiển thị 0 tới 0 của 0 dữ liệu",
                                "sInfoFiltered": "(được lọc từ _MAX_ dữ liệu)",
                                "sInfoPostFix": "",
                                "sSearch": "Tìm kiếm:",
                                "sUrl": "",
                                "sInfoThousands": ",",
                                "sLoadingRecords": "Đang tải...",
                                "oPaginate": {
                                    "sFirst": "Đầu tiên",
                                    "sLast": "Cuối cùng",
                                    "sNext": "Sau",
                                    "sPrevious": "Trước"
                                },
                                "oAria": {
                                    "sSortAscending": ":Sắp xếp thứ tự tăng dần",
                                    "sSortDescending": ": Sắp xếp thứ tự giảm dần"
                                }
                            },
                            "lengthMenu": [25, 50, 75, 100],
                            "info": false,
                            "processing": false,
                            "serverSide": false,
                            "bFilter": true,
                            "bPaginate": true,
                            "bLengthChange": true,
                            "bInfo": true,
                            "responsive": true,
                            "lengthChange": true,
                            "autoWidth": false,
                            "stateSave": true,
                            "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                            "initComplete": function (oSettings) {

                            }
                        });
                        $(".divLoading").removeClass("loading");
                    }
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });

            } catch (e) {
            }
        }

        function API_BASE(MAPHIEU_) {
            var confirm_ = confirm('Bạn có chắc chuyển thông tin này đến BASE theo số phiếu này?' + MAPHIEU_);
            if (confirm_) {
                $.ajax({
                    url: '@Url.Action("_APIBASE")',
                    timeout: 200000,
                    type: "POST",
                    data: {
                        MAPHIEU: MAPHIEU_,
                        KEY: "1"
                    },
                    beforeSend: function () {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {

                        if (result.status >= 1) {
                            notify(result.text, "success");

                        }
                        else {
                            notify(result.text, "error");
                        }
                        $(".divLoading").removeClass("loading");

                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
        }

    </script>

    <script type="text/javascript">
        $(document).ready(function () {
            GetList(false);
        });
    </script>
}