
@{
    var data = ViewBag.DATA as IEnumerable<ToolsApp.EntityFramework.KhoSoi.SP_GC_LOAD_DONHANGGCSOI_CT_BYMADH_Result>;
    var STT = 1;
}
<table id="myTable-XN" class="table table-bordered table-hover" width="100%">
    <thead>
        <tr>
            <th></th>
            <th>STT</th>
            <th>Mã đơn hàng GC</th>
            <th>Loại đơn hàng</th>
            <th>Diễn giải</th>
            <th>Số lượng</th>
            <th>Mã sợi thành phẩm</th>
            <th>Ngày yêu cầu</th>
            <th>Ngày kết thúc</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in data)
        {
            <tr>
                <td width="100px">
                    <div class="row">
                        <a onclick="Edit('@item.KHOA_ID')" class="btn">
                            <i class="fas fa-edit"></i> Sửa
                        </a>
                        <a onclick="_GuiAPI('@item.KHOA_ID')" class="btn">
                            <i class="fas fa-recycle"></i> APIs
                        </a>
                    </div>                   
                </td>
                <td> @STT </td>
                <td>@item.MADH_GCSOI</td>
                <td>@item.Loaidh</td>
                <td>@item.DIENGIAI</td>
                <td>@item.SOLUONGYEUCAU</td>
                <td>@item.MASOITHANHPHAM</td>
                <td>@item.NGAYYCAU</td>
                <td>@item.NGAYKETTHUC</td>
            </tr>
            STT++;
        }
    </tbody>
</table>











