@{
    var list = ViewBag.data as List<ToolsApp.EntityFramework.KhoSoi.SP_LOADCHITIET_KIEMTRACHATLUONG_DONVI_Result>;

    var Stt = 0;
}

<table id="myTableKSV" class="table table-bordered">
    <thead>
        <tr style="background-color: #00CED1; text-align: center ">

            <th width="150px">Mã sản phẩm</th>
            <th width="150px">Hiệu</th>
            <th width="150px">Lô</th>
            <th width="120px">Nhập kho kiểm tra</th>
            <th width="70px">Kho nhận xét</th>
            <th width="70px">Nguồn CC</th>
            <th width="120px">Mã phiếu PD</th>
            <th width="150px">Số CTXN</th>
        </tr>
    </thead>

    <tbody id="detailKSV">
        @if (list != null && list[0].SOCTXN != null && list[0].MAPHIEUPD != null && list[0].MAVT != null)
        {
            foreach (var item_chitiet in list)
            {
                <tr id="row_@(Stt)">

                    <td>
                        <input class="form-control text-box single-line" data-val="true" style="width: 100%;"
                               id="Detail_@(Stt)_MAVT" name="Detail[@(Stt)].MAVT" type="text" value="@item_chitiet.MAVT" readonly>
                        <span class="field-validation-valid text-danger" data-valmsg-for="Detail_@(Stt)_MAVT"
                              data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <input class="form-control text-box single-line" data-val="true" style="width: 100%;"
                               id="Detail_@(Stt)_HIEU" name="Detail[@(Stt)].HIEU" type="text" value="@item_chitiet.HIEU" readonly>
                        <span class="field-validation-valid text-danger" data-valmsg-for="Detail_@(Stt)_HIEU"
                              data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <input class="form-control text-box single-line" data-val="true" style="width: 100%;"
                               id="Detail_@(Stt)_LO" name="Detail[@(Stt)].LO" type="text" value="@item_chitiet.LO" readonly>
                        <span class="field-validation-valid text-danger" data-valmsg-for="Detail_@(Stt)_LO"
                              data-valmsg-replace="true"></span>
                    </td>

                    <td>
                        <input class="form-control text-box single-line" data-val="true" style="width: 100%;"
                               id="Detail_@(Stt)_THUC" name="Detail[@(Stt)].THUC" type="number" value="@item_chitiet.THUC" readonly>
                        <span class="field-validation-valid text-danger" data-valmsg-for="Detail_@(Stt)_THUC"
                              data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <select id="Detail_@(Stt)KHOKIEMTRA" name="Detail[@(Stt)].KHOKIEMTRA"
                                class="form-control chosen-select" style="width: 100%;">
                            <option value="@item_chitiet.KHOKIEMTRA" selected>@(item_chitiet.KHOKIEMTRA == "D" ? "Đạt" : item_chitiet.KHOKIEMTRA == "T" ? "Thiếu" : item_chitiet.KHOKIEMTRA == "S" ? "Sai" : "Hỏng")</option>

                        </select>

                    </td>

                    <td>
                        <input class="form-control text-box single-line" data-val="true" style="width: 100%;"
                               id="Detail_@(Stt)_NHACC" name="Detail[@(Stt)].NHACC" type="text" value="@item_chitiet.NHACC" readonly>
                        <span class="field-validation-valid text-danger" data-valmsg-for="Detail_@(Stt)_NHACC"
                              data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <input class="form-control text-box single-line" data-val="true" style="width: 100%;"
                               id="Detail_@(Stt)_MAPHIEUPD" name="Detail[@(Stt)].MAPHIEUPD" type="text" value="@item_chitiet.MAPHIEUPD" readonly>
                        <span class="field-validation-valid text-danger" data-valmsg-for="Detail_@(Stt)_MAPHIEUPD"
                              data-valmsg-replace="true"></span>
                    </td>
                    <td>
                        <input class="form-control text-box single-line" data-val="true" style="width: 100%;"
                               id="Detail_@(Stt)_SOCTXN" name="Detail[@(Stt)].SOCTXN" type="text" value="@item_chitiet.SOCTXN" readonly>
                        <span class="field-validation-valid text-danger" data-valmsg-for="Detail_@(Stt)_SOCTXN"
                              data-valmsg-replace="true"></span>
                    </td>
                </tr>

                Stt++;
            }
        }
    </tbody>

</table>


<script>
    var index = @(Stt);

    $(document).ready(function () {
        //Nút tạo nhiều dòng dữ liệu
        $("#addMore").click(function (e) {
            var mau = $('#tblMau').html();

            mau = mau.replace(/{index}/g, index);

            $('#detailKS').append(mau);

            index++;
        });
    });
</script>



