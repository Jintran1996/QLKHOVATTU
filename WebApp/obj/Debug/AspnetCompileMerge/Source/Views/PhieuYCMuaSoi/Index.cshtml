
@{
    ViewBag.Title = "Lập phiếu YC mua sợi";

}

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <!-- Section search -->
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <b>Tìm kiếm</b>
                        </h3>
                    </div>
                    <div class="card-body pad">
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label>Mã phiếu:</label>
                                    <input class="form-control form-control-sm" type="text" autocomplete="off"
                                           id="MaPhieuSearch" name="MaPhieuSearch" />
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="form-group">
                                    <button id="btnSearch" type="button" class="btn bg-gradient-primary"><i class="fa fa-search"></i> Tìm</button>
                                    &nbsp;
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <!--End section search-->
            </div>
        </div>
        <!--Section data table-->
        <div class="row">
            <div class="col-md-12">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title">
                            <b>@ViewBag.Title </b>
                        </h3>
                    </div>
                    <div class="card-body pad">
                        <div class="row" style="margin-bottom:10px">
                            <div class="col-md-4">
                                <button id="btInsert" onclick="CreateNew();" type="button" title="Thêm mới" class="btn bg-gradient-success"><i class="fa fa-plus"></i>&nbsp;Thêm mới</button>
                                &nbsp;
                                <button id="btUpdate" onclick="Edit();" type="button" title="Hiệu chỉnh phiếu" class="btn bg-gradient-info"><i class="fas fa-edit"></i>&nbsp;Hiệu chỉnh</button>
                                &nbsp;
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 table-body table-responsive">

                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /.col -->
        </div>
        <!--End section data table-->
    </div>
</section>

<!----------------FORM INSERT----------------->
<div id="myModal" class="modal fade modal-wide" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content ">
            @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frm", id = "frm", enctype = "multipart/form-data" }))
            {

                <div class="modal-header">
                    <div class="modal-title" style="font-size: 17px;text-transform:uppercase;color:#3c8dbc"><strong id="myModalTitle"></strong></div>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div id="myModalContent">
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="text-right">
                        <button type="button" id="btnNew" onclick="CreateNew();" class="btn btn-sm btn-success"><i class="fa fa-plus"></i>&nbsp;Phiếu mới</button>

                        <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal"><i class="fa fa-close"></i>&nbsp;Đóng</button>
                    </div>
                </div>}
        </div>
    </div>
</div>
<!------------------------------------------>
<!----------------FORM DETAILS----------------->
<div id="myModalDetail" class="modal fade modal-wide" role="dialog" style="overflow:auto">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmDetail", id = "frmDetail", enctype = "multipart/form-data" }))
            {
                <div class="modal-header">
                    <div class="modal-title" style="font-size: 17px;text-transform:uppercase;color:#3c8dbc"><strong id="myModalTitleDetail"></strong></div>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div id="myModalContentDetail">

                    </div>
                </div>
                <div class="modal-footer">
                    <div class="text-right">
                        @*<button id="btnExportCT" type="button" class="btn btn-primary btn-sm" data-dismiss="modal"><i class="fa fa-close"></i>&nbsp;Xuất excel</button>*@
                        <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal"><i class="fa fa-close"></i>&nbsp;Đóng</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<!------------------------------------------>
<!----------------FORM UPDATE----------------->
<div id="myModalUpdate" class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <!-- Modal content-->
        <div class="modal-content">
            @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmUpdate", id = "frmUpdate", enctype = "multipart/form-data" }))
            {

                <div class="modal-header">
                    <div class="modal-title" style="font-size: 17px;text-transform:uppercase;color:#3c8dbc"><strong id="myModalTitleUpdate"></strong></div>
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                </div>
                <div class="modal-body">
                    <div id="myModalContentUpdate">
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="text-right">
                        @*<button type="button" id="btSave" onclick="reloadEdit()" class="btn btn-sm btn-success"><i class="fa fa-save"></i>&nbsp;Lưu</button>*@

                        <button type="button" class="btn btn-danger btn-sm" data-dismiss="modal"><i class="fa fa-close"></i>&nbsp;Đóng</button>
                    </div>
                </div>}
        </div>
    </div>
</div>
<!------------------------------------------>

@section scripts{
    <script type="text/javascript">
        var config = {
            '.chosen-select-search': {},
            '.chosen-select-search-deselect': { allow_single_deselect: true },
            '.chosen-select-search-no-single': { disable_search_threshold: 10 },
            '.chosen-select-search-no-results': { no_results_text: 'Oops, nothing found!' },
            '.chosen-select-search-width': { width: "95%" },
            'search_contains': true
        }
        for (var selector in config) {
            $(selector).chosen(config);
        }

    </script>
    <script>
        function reloadData(page) {
            try {
            $.ajax({
                url: '@Url.Action("_GetList")',
                timeout: 20000,
                data: {
                    MaPhieuSearch: $("#MaPhieuSearch").val(),
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body').html(response);

                    $("#myTable").DataTable({
                        "bFilter": true,
                        "bPaginate": true,
                        "bLengthChange": false,
                        "bInfo": true,
                        "responsive": true,
                        "lengthChange": true,
                        "autoWidth": false,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
        }

        

        function rowclick(this_) {
            $ID_SOCT = $('.' + this_).data("SystemKeyId");
            console.log($ID_SOCT);
            createCookie('SystemKey', $ID_SOCT, 10);
        }

        function Remove(Id_, Index_) {
            $('#row_' + Index_).attr("style", "display:none");

            $('#Detail_' + Index_ + '_Delete').val(true);
        }
    </script>

    <script type="text/javascript">
        var $ID_SOCT = "";

        var $modal = $('#myModal');
        var $myModalContent = $("#myModalContent");
        var $myModalTitle = $("#myModalTitle");

        var $modalDetail = $('#myModalDetail');
        var $myModalContentDetail = $("#myModalContentDetail");
        var $myModalTitleDetail = $("#myModalTitleDetail");

        var $modalUpdate = $('#myModalUpdate');
        var $myModalContentUpdate = $("#myModalContentUpdate");
        var $myModalTitleUpdate = $("#myModalTitleUpdate");

        $(document).ready(function () {
            reloadData(false);


            $("#myModal").on("hidden.bs.modal", function () {
                reloadData(false);
            });

            $("#btnSearch").click(function () {
                reloadData(true);
            });

            $("#btnUpload").click(function () {
                $myModalContentUpload.html("");
                $myModalTitleUpload.html("Upload");
                $.ajax({
                    url: '@Url.Action("_Upload")',
                    timeout: 20000,
                    data: {
                    },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        $myModalContentUpload.html(result);
                        $modalUpload.modal();

                        $(".divLoading").removeClass("loading");
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            });
        });

        function CreateNew() {
            $myModalContent.html("");
            $myModalTitle.html("Thêm mới");
            $.ajax({
                url: '@Url.Action("_DetailForEdit")',
                timeout: 20000,
                data: {
                    dvt: '@string.Empty'
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status <= 1) {
                        notify(result.text, "error");
                    }
                    else {
                        $myModalContent.html(result);
                        $modal.modal();
                    }
                    $(".divLoading").removeClass("loading");
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        };

        function Detail(maphieu_) {
            try {
            $.ajax({
                url: '@Url.Action("_Details")',
                timeout: 2000000,
                data: {
                    maphieu: maphieu_
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $myModalContentDetail.html(response);

                    $modalDetail.modal();

                    $myModalTitleDetail.html('CHI TIẾT PHIẾU (' + maphieu_ + ')');
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
        }

        function Delete(maphieu_)
        {
            var confirm_ = confirm('Bạn có chắc muốn xóa phiếu này?');
            if (confirm_) {
                $.ajax({
                    url: '@Url.Action("_DeleteFun")',
                    timeout: 20000,
                    type: "POST",
                    data: { maphieu: maphieu_ },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status >= 1) {
                            notify(result.text, "success");
                        }
                        else {
                            notify(result.text, "error");
                        }

                        $(".divLoading").removeClass("loading");

                        reloadData(true);
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
        }
        function DeleteCT(maphieu_ , mavt_)
        {
            var confirm_ = confirm('Bạn có chắc muốn xóa mã này?');
            if (confirm_) {
                $.ajax({
                    url: '@Url.Action("_DeleteCTFun")',
                    timeout: 20000,
                    type: "POST",
                    data: { maphieu: maphieu_, mavt: mavt_ },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        if (result.status >= 1) {
                            notify(result.text, "success");
                        }
                        else {
                            notify(result.text, "error");
                        }

                        $(".divLoading").removeClass("loading");

                        reloadData(true);
                        reloadCT(true);
                        reloadCT_UD(true);

                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
            }
        }
        function Edit() {
            $myModalContentUpdate.html("");
            $myModalTitleUpdate.html("Cập nhật");
            $.ajax({
                url: '@Url.Action("_Update")',
                timeout: 20000,
                data: {
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status == null) {
                        $myModalContentUpdate.html(result);
                        $modalUpdate.modal();
                    }
                    else {
                        notify(result.text, "error");
                    }

                    $(".divLoading").removeClass("loading");
                },
                failure: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        }

    </script>
}
