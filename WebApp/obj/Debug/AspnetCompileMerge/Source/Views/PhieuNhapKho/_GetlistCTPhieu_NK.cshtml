<script>
    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }

    function _Load_DMLO() {

        var HIEUid = $("#HIEU").val();
        var MAVTid = $("#MAVT").val();
        var LOid = $("#LO");
        var MADINHMUCID = $("#MADINHMUC");
        LOid.empty();
        MADINHMUCID.empty();

            $.ajax({
                url: '@Url.Action("_Load_DMLO")',
                timeout: 20000,
                type: "POST",
                data: {
                    HIEUid: HIEUid, MAVTid: MAVTid
                },
                success: function (result) {

                    $.each(result.obj, function (i, state) {
                        LOid.append($('<option/>', { value: this.LO }).html(this.LO));
                    });
                    LOid.trigger("chosen:updated");
                    $.each(result.objdm, function (i, state) {
                        MADINHMUCID.append($('<option/>', { value: state }).html(state));

                    });

                    MADINHMUCID.trigger("chosen:updated");


                    updateInputValue();

                }
            });
    }
    function updateInputValue() {
        var selectBox = document.getElementById("MAVT");
       // var selectedValue = selectBox.options[selectBox.selectedIndex].value;
        var selectedData = selectBox.options[selectBox.selectedIndex].getAttribute('data-maphieupd');
        document.getElementById("MAPHIEUPD").value = selectedData;
    }


</script>

<script type="text/javascript">
    $("#NGAYKETOAN").datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true,
        onClose: function (selectedDate) {
            //$("#FromDate").datepicker("option", "minDate", selectedDate);
        }
    });
    $(document).ready(function () {
        var SOCTXN_ = $("#SophieuN_CT").val();
        reloadData_getlist_ctphieu(SOCTXN_);
     
    })
</script>








