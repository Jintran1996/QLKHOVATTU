        function EXCEL_IA() {
            $.ajax({
                url: '@Url.Action("_ExportExcelFun_IA")',
                timeout: 200000000,
                type: "POST",
                data: {
                    MAKHO: $("#MAKHO").val(),
                    LoaiTon: $("#LoaiTon").val(), Thang: $("#Thang").val(),
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status >= 1) {
                        window.location.href = result.obj;
                        EXCEL_IAA();
