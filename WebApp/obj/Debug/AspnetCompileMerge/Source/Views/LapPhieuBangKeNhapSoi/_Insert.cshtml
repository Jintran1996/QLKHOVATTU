    function click_Phieumoi() {
        var SOPHIEU = $("#SOPHIEU").val();
        $.ajax({
            type: "POST",
            async: false,
            url: '@Url.Action("TaoPhieuMoi_Click")',
            data: {
                SOPHIEU: SOPHIEU,
            },
            beforeSend: function () {
                $(".divLoading").addClass("loading");
            },
        }).done(function (data) {
            $(".divLoading").removeClass("loading");
            if (data.status == 1) {
                $('#custom-tabs-one-home-tab').trigger('click');
                document.getElementById("tab-2").style.display = 'none';
                document.getElementById("tab-1").style.display = 'block';
                $("#SOPHIEU").empty();
                $("#SOPHIEU").append($('<option/>', { value: " " }).html("--Danh sách phiếu bảng kê sợi --"));
                $("#SOPHIEU").trigger("chosen:updated");
            }
            if (data.status == -1)
            {
                notify(data.text, "error");
                //$('#custom-tabs-one-home-tab').trigger('click');
                //document.getElementById("tab-2").style.display = 'none';
                //document.getElementById("tab-1").style.display = 'block';
                //$("#Sohopdong").empty();
                //$("#Sohopdong").append($('<option/>', { value: " " }).html("--Danh sách phiếu chuyển thông tin--"));
                //$("#Sohopdong").trigger("chosen:updated");
            }
            else {
                notify(data.text, "error");
            }


        }).fail(function (errors) {
            console.log(errors);
        });
    }
    function Loaddinhmuc() {
        var KHOACTHUC = $("#KHOACTHUC").val();
        var SLDINHMUC = $("#SLDINHMUC");
        SLDINHMUC.empty();
        $.ajax({
            type: "POST",
            async: false,
            url: '@Url.Action("_Loaddinhmuc")',
            data: {
                KHOACTHUC: KHOACTHUC,
            },
            success: function (result) {
                $.each(result.obj, function (i, state) {
                    document.getElementById('SLDINHMUC').value = state.SLPD;
                    console.log(state.SLPD);
                });
                SLDINHMUC.trigger("chosen:updated");
                _Load_SLNhap_SLHaoHut();
            }
        });
    }
    function LoadLo() {
        var HIEU = $("#HIEU").val();
        var LO = $("#LO");
        LO.empty();
        $.ajax({
            type: "POST",
            async: false,
            url: '@Url.Action("_LoadLo")',
            data: {
                HIEU: HIEU,
            },
            success: function (result) {
                $.each(result.obj, function (i, state) {
                    LO.append($('<option/>', { value: this.LO }).html(this.LO));
                });
                LO.trigger("chosen:updated");
            }
        });
    }
