<script type="text/javascript">
    function toggle(source) {
        var checkboxes = document.querySelectorAll('input[type="checkbox"]');
        for (var i = 0; i < checkboxes.length; i++) {
            if (checkboxes[i] != source)
                checkboxes[i].checked = source.checked;
        }
    }
    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }
    $('#THANGNAM').datepicker({
        format: 'mm/yyyy',
        startView: "months",
        minViewMode: "months",
        language: 'pt-BR',
        endDate: "0m",
        autoclose: true,
        onclose: function (selecteddate) {
            //$("#fromdate").datepicker("option", "mindate", selecteddate);
        }
    });   
</script>

<!--    Load Data   -->
<script type="text/javascript">
    var $myModalDetailReport = $('#myModalDetailReport');
    var $myModalContentDetailReport = $("#myModalContentDetailReport");
    var $myModalTitleDetailReport = $("#myModalTitleDetailReport");

    $(document).ready(function () {
        $("#close_").click(function () {
            Xoa_DonHangKhiDongKhongChiTiet_Click();
            reloadData(true);
        });
    });

    //-------------Xoá đơn hàng khi đóng chưa có chi tiết đơn hàng--------------//
     function Xoa_DonHangKhiDongKhongChiTiet_Click() {
         var SOPHIEU = $('#SOPHIEU').val();
         var confirm_ = confirm('Bạn có chắc muốn đóng chương trình?');
         if (confirm_) {
             $.ajax({
                 type: "POST",
                 async: false,
                 url: '@Url.Action("Xoa_DonHangKhiDongKhongChiTiet_Click")',
                 data: {
                     SOPHIEU: SOPHIEU,
                 },
                 beforeSend: function () {
                     $(".divLoading").addClass("loading");
                 },
             }).done(function (data) {
                 $(".divLoading").removeClass("loading");
                 if (data.status > 0) {
                     notify(data.text, "success");
                 }
                 else {
                     notify(data.text, "error");
                 }

             }).fail(function (errors) {
                 console.log(errors);
             });
         }
     }

    //-------------Load view update detail--------------//
    function UpdateChiTietView_Click(Khoa) {
        $.ajax({
            type: "GET",
            async: false,
            url: '@Url.Action("UpdateChiTietView_Click")',
            data: {
                Khoa: Khoa,
            },
            beforeSend: function () {
                $(".divLoading").addClass("loading");
            },
        }).done(function (data) {
            $(".divLoading").removeClass("loading");
            $('.table-updateDetail').html(data);
        }).fail(function (errors) {
            console.log(errors);
        });

    }
</script>
<!--    Action event  -->
<script type="text/javascript">
    function Loadquacongdoan() {
        if ($('#MALOAICONGDOAN').val() == 'SOICHAP') {
            document.getElementById("quacongdoan").style.display = 'none';
        }
        else {
            document.getElementById("quacongdoan").style.display = 'block';
        }
    }
    //-----------------Action chuyển tiếp----------------//
    function ChuyenTiep_click() {
        var MADV = $('#MADV').val();
        var THANGNAM = $('#THANGNAM').val();
        var NHAPKHO = $('#NHAPKHO').val();
        var MAKH = $('#MAKH').val();
        var MALOAICONGDOAN = $('#MALOAICONGDOAN').val();
        var CONGDOAN = $('#CONGDOAN').val();
        var MANV_XX = $('#MANV_XX').val();
        var LYDOSANXUAT = $('#LYDOSANXUAT').val();
        $.ajax({
            type: "POST",
            async: false,
            url: '@Url.Action("ChuyenTiep_click")',
            data: {
                MADV: MADV,
                THANGNAM: THANGNAM,
                NHAPKHO: NHAPKHO,
                MAKH: MAKH,
                MALOAICONGDOAN: MALOAICONGDOAN,
                CONGDOAN: CONGDOAN,
                MANV_XX: MANV_XX,
                LYDOSANXUAT: LYDOSANXUAT,
            },
            beforeSend: function () {
                $(".divLoading").addClass("loading");
            },
        }).done(function (data) {
            $(".divLoading").removeClass("loading");
            if (data.status > 0) {
                notify(data.text, "success");
                $('#custom-tabs-one-profile-tab').trigger('click');
                //$("#custom-tabs-one-profile-tab").attr('style', 'display:""');
                //$("#custom-tabs-one-home-tab").attr('style', 'display:none');
                document.getElementById("tab-1").style.display = 'none';
                document.getElementById("tab-2").style.display = 'block';
                load_CTPhieu();
                $(".divLoading").removeClass("loading");
            }
            else {
                notify(data.text, "error");
            }

        }).fail(function (errors) {
            console.log(errors);
        });

    }
    // Update SL nhập, SL hao hụt theo Công thức định mức
    function _Load_SLNhap_SLHaoHut() {

        var dinhmuc = $('#SLDINHMUC').val();
        var slxuat = $('#SOLUONGXuat').val();
      
        var s1 = parseFloat(slxuat);
        var s2 = parseFloat(dinhmuc);
        console.log(s1, s2);
        var slnhap_ = s1 / (1 - s2 + 1 );
        var slhaohut_ = parseFloat(slnhap_) - s1;

        if (parseFloat(slnhap_) >= s1) {
            $('#SOLUONGNhap').val(parseFloat(slnhap_));
            $('#SLHaoHutDM').val(parseFloat(slhaohut_));
        }
        return;
    }
    
    //-----------------Lưu chi tiết Đơn hàng----------------//
    function Luu_click() {
        var SOPHIEU = $('#SOPHIEU').val();
        var KHOACTHUC = $('#KHOACTHUC').val();
        var SOTRUC = $('#SOTRUC').val();
        var MASOI = $('#MASOI').val();
        var DVT = $('#DVT').val();
        var MADH_GCSOI = $('#MADH_GCSOI').val();
        var MASOIHOANTAT = $('#MASOIHOANTAT').val();
        var HIEU = $('#HIEU').val();
        var LO = $('#LO').val();
        var MACONGDOAN = $('#MACONGDOAN').val();
        var DANGCONGDOAN = $('#DANGCONGDOAN').val();
        var CHIEUDAI = $('#CHIEUDAI').val();
        var SOCANH = $('#SOCANH').val();
        var KHOTRUC = $('#KHOTRUC').val();
        var SOLUONGNhap = $('#SOLUONGNhap').val();
        var SOLUONGXuat = $('#SOLUONGXuat').val();
        var SLHaoHutDM = $('#SLHaoHutDM').val();
        var GHICHU = $('#GHICHU').val();
        $.ajax({
            type: "POST",
            async: false,
            url: '@Url.Action("Luu_click")',
            data: {
                SOPHIEU: SOPHIEU,
                KHOACTHUC: KHOACTHUC,
                SOTRUC: SOTRUC,
                MASOI: MASOI,
                DVT: DVT,
                MADH_GCSOI: MADH_GCSOI,
                MASOIHOANTAT: MASOIHOANTAT,
                HIEU: HIEU,
                LO: LO,
                MACONGDOAN: MACONGDOAN,
                DANGCONGDOAN: DANGCONGDOAN,
                CHIEUDAI: CHIEUDAI,
                SOCANH: SOCANH,
                KHOTRUC: KHOTRUC,
                SOLUONGNhap: SOLUONGNhap,
                SOLUONGXuat: SOLUONGXuat,
                SLHaoHutDM: SLHaoHutDM,
                GHICHU: GHICHU,
            },
            beforeSend: function () {
                $(".divLoading").addClass("loading");
            },
        }).done(function (data) {
            $(".divLoading").removeClass("loading");
            if (data.status > 0) {
                notify(data.text, "success");
                load_CTPhieu();
            }
            else {
                notify(data.text, "error");
                $(".divLoading").removeClass("loading");
            }

        }).fail(function (errors) {
            console.log(errors);
        });
    }
