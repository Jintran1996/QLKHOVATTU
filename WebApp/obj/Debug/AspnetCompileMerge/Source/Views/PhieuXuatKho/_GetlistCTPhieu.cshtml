                                                                        </option>
                                                                    }
                                                                </select>
                                                                <input hidden type="text" class="form-control" id="MAPHIEUPD" name="MAPHIEUPD" readonly>
                                                                <input hidden type="text" class="form-control" id="HIEU" name="HIEU" readonly>
                                                                <input hidden type="text" class="form-control" id="LO" name="LO" readonly>
                                                                <input hidden class="form-control" id="SOLUONGTON" name="SOLUONGTON" readonly>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="row" style="margin-bottom:5px">
                                                            <label class="col-md-3 ">Số lượng:</label>
                                                            <div class="col-md-9">
