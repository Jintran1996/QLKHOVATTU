                                                                       id="SOLUONGYC" name="SOLUONGYC" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="row" style="margin-bottom:5px">
                                                            <label class="col-md-3 ">Ghi chú:</label>
                                                            <div class="col-md-9">
                                                                <input class="form-control" type="text" autocomplete="off" value=""
                                                                       id="GHICHU" name="GHICHU" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div>
                                                    @if (MAHTHUC == "XD1" || MAHTHUC == "XD2" || MAHTHUC == "XKNB")
                                                    {
                                                        <div class="row">
                                                            <div class="col-md-4">
                                                                <div class="row" style="margin-bottom:5px">
                                                                    <label class="col-md-3">Mã đơn hàng :</label>
                                                                    <div class="col-md-9">
                                                                        <select class="form-control chosen-select" id="MADH" name="MADH">
                                                                            <option disabled selected value="">-- Chọn mã đơn hàng --</option>
                                                                            @foreach (var item in dhsoi)
                                                                            {
                                                                                <option value="@item.MADH">
                                                                                    MADH: @item.MADH
                                                                                </option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    @*Row 3*@
                                                    <div class="row">
                                                    </div>
                                                    <div class="row">
                                                    </div>
                                                    @if (ChkAPI != "1")
                                                    {
                                                    <div class="text-center">
                                                        <button type="button" id="btSavect" class="btn btn-sm btn-primary" style="width: 100px"><i class="fa fa-save"></i>&nbsp;Lưu</button>
                                                    </div>
                                                    }
                                                </div>


                                                <!-- /.card -->
                                            </div>
                                            <!--data-->
                                        </div>
                                    
                                }
                                <div class="card-body pad">
                                    <div class="row">
                                        <div class="col-md-12 table-body-view-ctphieu  table-responsive">

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</body>
</html>


<script>
