                            <div class="tab-pane fade col-md-12 show active" id="custom-tabs-one-home-ct" role="tabpanel" aria-labelledby="custom-tabs-one-home-tab-getlist-ctphieu">
                                <!--data-->
                                @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmctphieuXN", id = "frmctphieuXN", enctype = "multipart/form-data" }))
                                {
                                 
                                        <div class="row">
                                            <div class="col-md-12">
                                                <div class="row ">
                                                    <div class="col-md-4">
                                                        <div class="row" style="margin-bottom:5px">
                                                            <label class="col-md-3">SOCTXN :</label>
                                                            <div class="col-md-9">
                                                                <input class="form-control" type="text" autocomplete="off" value="@Model.SOCTXN" readonly
                                                                       id="SOCTXN_CT" name="SOCTXN" />
                                                                <input class="form-control" type="text" autocomplete="off"
                                                                       id="MAHTHUC" name="MAHTHUC" value="@MAHTHUC.Trim()" hidden />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="row" style="margin-bottom:5px">
                                                            <label class="col-md-3 ">Loại đơn hàng:</label>
                                                            <div class="col-md-9">
                                                                <select class="form-control chosen-select" id="LOAIDONHANG" name="LOAIDONHANG">
                                                                    <option value="INKH"> INKH</option>
                                                                    <option value="OUTKH"> OUTKH</option>
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-4">
                                                        <div class="row" style="margin-bottom:5px">
                                                            <label class="col-md-3">Ngày kế toán:</label>
                                                            <div class="col-md-9">
                                                                <input id="NGAYKETOAN" name="NGAYKETOAN_" value="@DateTime.Now.ToString("dd/MM/yyyy")" class="form-control" />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-4">
                                                        <div class="row" style="margin-bottom:5px">
                                                            <label class="col-md-3">Mã sợi :</label>
                                                            <div class="col-md-9">
                                                                <select class="form-control chosen-select" id="MAVT" name="MAVT" onchange="updateInputValue()">
                                                                    <option selected value="">-- Chọn mã sợi --</option>
                                                                    @foreach (var item in masoi)
                                                                    {
                                                                        <option value="@item.MAVT"
                                                                                data-maphieupd="@item.MAPHIEUPD"
                                                                                data-hieu="@item.HIEU"
                                                                                data-lo="@item.LO"
                                                                                data-SOLUONGTON="@item.SOLUONGTT">
