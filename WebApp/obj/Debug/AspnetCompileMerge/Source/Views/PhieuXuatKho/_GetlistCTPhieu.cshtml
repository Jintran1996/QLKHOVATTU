        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }




    function isreloadData_getlist_ctphieu() {
        var SOCTXN_ = $("#SOCTXN_CT").val();

            try {
            $.ajax({
                url: '@Url.Action("_GetListCTPhieu_View")',
                timeout: 20000,
                data: {
                    SOCTXN: SOCTXN_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-view-ctphieu').html(response);

                    $("#myTablectview").DataTable({
                        //"responsive": true,
                        "lengthChange": true,
                        "autoWidth": true,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
    }

    function reloadData_getlist_ctphieu_theomadh(MAPHIEUPD_) {
        var Search_ = MAPHIEUPD_ == null ? $('#MAPHIEUPD').val() : MAPHIEUPD_ ;
            try {
            $.ajax({
                url: '@Url.Action("_GetListCTPhieu_theomadh")',
                timeout: 20000,
                data: {
                    Sophieu: Search_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-ctphieu_theomadh').html(response);

                    $("#myTablect").DataTable({
                        //"responsive": true,
                        "lengthChange": true,
                        "autoWidth": true,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
    }




    function updateInputValue() {
        var selectBox = document.getElementById("MAVT");
       // var selectedValue = selectBox.options[selectBox.selectedIndex].value;
        var selectedData = selectBox.options[selectBox.selectedIndex].getAttribute('data-maphieupd');
        document.getElementById("MAPHIEUPD").value = selectedData;
        var selectedData = selectBox.options[selectBox.selectedIndex].getAttribute('data-hieu');
        document.getElementById("HIEU").value = selectedData;
        var selectedData = selectBox.options[selectBox.selectedIndex].getAttribute('data-lo');
        document.getElementById("LO").value = selectedData;
        var selectedData = selectBox.options[selectBox.selectedIndex].getAttribute('data-SOLUONGTON');
        document.getElementById("SOLUONGTON").value = selectedData;

        console.log($('#MAPHIEUPD').val(), $('#HIEU').val(), $('#LO').val(), $('#SOLUONGTON').val())
    }
    function inputChange_Checksluong() {

        var datayc = $('#SOLUONGYC').val();
        var dataton = $('#SOLUONGTON').val();
        var s1 = parseFloat(datayc);
        var s2 = parseFloat(dataton);
        console.log(s1, s2);

        if (s1 > s2) {
            $('#SOLUONGYC').val(0);
            notify("Số lượng yêu cầu không được lớn hơn số lượng tồn hiện tại || SOLUONGTON: " + dataton  , "error");
        }
        return;
    }
    function onkey_Number(value) {
        if (!value) {
            return;
        }
        return padLeftWithBounds(parseInt(value), '0', 5, 0, 99999);
    };

    function padLeftWithBounds(input, padChar, maxLength, min, max) {
        if (input <= min)
            return min;
        if (input >= max)
            return max;
        var s = input.toString(10);
        var padding = "";
        for (var i = 0; i < maxLength; ++i)
            padding += padChar;
        return padding.substring(0, maxLength - s.length) + s;
    };

     function Deletect(Khoa_) {
            var hidenMAKHO = $("#hidenMAKHO").val();
            var hidenMAHTHUC = $("#hidenMAHTHUC").val();
            var hidenSOCTXN = $("#hidenSOCTXN").val();
            var confirm_ = confirm('Bạn có chắc muốn xóa mã hàng này?' + Khoa_);
             if (confirm_) {
                 $.ajax({
                     url: '@Url.Action("_DeletectFun")',
                     timeout: 2000000,
                     type: "POST",
                     data: { Khoa: Khoa_ },
                     beforeSend: function (xhr) {
                         $(".divLoading").addClass("loading");
                     },
                     success: function (result) {

                         if (result.status >= 1) {
                             notify(result.text, "success");
                             Details(hidenSOCTXN, "", hidenMAHTHUC, hidenMAKHO); // LOAD LẠI FORM DETAILS

                         }
                         else {
                             notify(result.text, "error");
                         }
                         $(".divLoading").removeClass("loading");
                     },
                     error: function (message) {
                         $(".divLoading").removeClass("loading");
                     }
                 });
             }
        }

        function DeletectALL(SOCTXN_) {
            var hidenMAKHO = $("#hidenMAKHO").val();
            var hidenMAHTHUC = $("#hidenMAHTHUC").val();
            var hidenSOCTXN = $("#hidenSOCTXN").val();
            var confirm_ = confirm('Bạn có chắc muốn xóa tất cả theo số phiếu này?' + SOCTXN_);
             if (confirm_) {
                 $.ajax({
                     url: '@Url.Action("_DeleteALLFun")',
                     timeout: 2000000,
                     type: "POST",
                     data: { SOCTXN: SOCTXN_ },
                     beforeSend: function (xhr) {
                         $(".divLoading").addClass("loading");
                     },
                     success: function (result) {
                         if (result.status >= 1) {
                             notify(result.text, "success");
                             Details(hidenSOCTXN, "", hidenMAHTHUC, hidenMAKHO); // LOAD LẠI FORM DETAILS
                         }
                         else {
                             notify(result.text, "error");
                         }
                         $(".divLoading").removeClass("loading");
                     },
                     error: function (message) {
                         $(".divLoading").removeClass("loading");
                     }
                 });
             }
        }

</script>

<script type="text/javascript">
    $("#NGAYKETOAN").datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true,
        onClose: function (selectedDate) {
            //$("#FromDate").datepicker("option", "minDate", selectedDate);
        }
    });
    $(document).ready(function () {
        isreloadData_getlist_ctphieu($("#hidenSOCTXN").val());

        $("#btSavect").click(function () {
            var hidenMAKHO = $("#hidenMAKHO").val();
            var hidenMAHTHUC = $("#hidenMAHTHUC").val();
            var hidenSOCTXN = $("#hidenSOCTXN").val();

            form = $("#frmctphieuXN");
                form.removeData('validator');
                form.removeData('unobtrusiveValidation');
            $.validator.unobtrusive.parse("#frmctphieuXN");
                if (form.valid()) {
                    $.ajax({
                         url: '@Url.Action("_InsertFunCTPhieuXN")',
                        type: "POST",
                        data: $('#frmctphieuXN').serialize(),
                        beforeSend: function (xhr) {
                            $(".divLoading").addClass("loading");
                        },
                        success: function (result) {
                            if (result.status >= 1) {
                                notify(result.text, "success");
                                Details(hidenSOCTXN, "", hidenMAHTHUC, hidenMAKHO); // LOAD LẠI FORM DETAILS
                              
                            }
                            else {
                                notify(result.text, "error");
                            }
                            $(".divLoading").removeClass("loading");
                        },
                        error: function (message) {
                            $(".divLoading").removeClass("loading");
                        }
                    });
                }
            });
    })
</script>








