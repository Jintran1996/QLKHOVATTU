
@{
    ViewBag.CTPhieu = "Danh Sách Xuất Kho";

    //  var madh = ViewBag.madh as List<ToolsApp.EntityFramework.QuanLyKhoMoc2023.Sp_API_LoadDonHang_CoKeyHH_Result>;
    // var APIs = ViewBag.APIs as IEnumerable<ToolsApp.EntityFramework.QuanLyKhoMoc2023.tblphieukho>;

    var MAHTHUC = ViewBag.MAHTHUC;
    var SOCTXN = ViewBag.SOCTXN;
    var ChkAPI = ViewBag.ChkAPI;
    var MAKHO = ViewBag.MAKHO;
    var masoi = ViewBag.masoi as List<ToolsApp.EntityFramework.KhoSoi.LOAD_DATA_MASOI_XUATKHO_THEO_XKNB_Result>;   
    var DMLO = ViewBag.DMLO as List<ToolsApp.EntityFramework.KhoSoi.SP_LOAD_NL_DMLO_BY_HIEU_Result>;
    var NL_DMNHACCAP = ViewBag.NL_DMNHACCAP as List<ToolsApp.EntityFramework.KhoSoi.NL_DMNHACCAP>;
    var dhsoi = ViewBag.dhsoi as List<ToolsApp.EntityFramework.KhoSoi.VATTU2024_SPLOAD_MADONHANG_ND_XK_Result>;



}
@using System.Globalization;
@model ToolsApp.Models.NL_CTXUATNHAPViewModels


<input class="form-control" type="text" autocomplete="off"
       id="hidenSOCTXN" name="SophieuN_CT" value="@SOCTXN.Trim()" hidden />
<input class="form-control" type="text" autocomplete="off"
       id="hidenMAKHO" value="@MAKHO.Trim()" hidden />
<input class="form-control" type="text" autocomplete="off"
       id="hidenMAHTHUC" name="SophieuN_CT" value="@MAHTHUC.Trim()" hidden />



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-md-12">
                <div class="card card-info card-tabs" id="myTap">
                    <div class="card-header p-0 pt-1">
                        <ul class="nav nav-tabs" id="custom-tabs-one-tab" role="tablist">
