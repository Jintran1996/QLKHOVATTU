<script type="text/javascript">
    $(function () { // will trigger when the document is ready
        $('.datepicker').datepicker(); //Initialise any date pickers
    });
</script>

<script>
    var index = 0;

    $(document).ready(function () {
        $('#HIEULUC').click(function (e) {
            if ($('#HIEULUC').val() != true) {
                $('#HIEULUC').val(true);
            }
            else {
                $('#HIEULUC').val(false);
            }
        });

        $("#btnTaoMaSoi").click(function () {
            var MaNGL_ = $("#MaNGL").val();
            var Chisosoi_ = $("#Chisosoi").val();
            var SoFilament_ = $("#SoFilament").val();
            var MAVATTU_ = $("#MAVATTU");
            var STT_ = $("#STT");
            console.log(111);
            $.ajax({
                url: '@Url.Action("_btnTaoMaSoi")',
                type: "POST",
                data: {
                    MaNGL: MaNGL_,
                    Chisosoi: Chisosoi_,
                    SoFilament: SoFilament_,
                },
                beforeSend: function (xhr) {
                    $(".divLoading").addClass("loading");
                },
                success: function (result) {
                    if (result.status >= 1) {
                        notify(result.text, "success");

                        STT_.val(result.obj).trigger("chosen:updated");
                        MAVATTU_.val(result.obj1).trigger("chosen:updated");

                    }
                    else {
                        notify(result.text, "error");
                    }
                    $(".divLoading").removeClass("loading");
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
        });

    });
</script>
<script type="text/javascript">
    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }

</script>

<script>
    function checkDecimal(input) {
        // Lấy giá trị nhập vào từ trường input
        var value = input.value;

        // Kiểm tra nếu giá trị không rỗng và không hợp lệ
        if (value && !(/^\d{1,2}(\.\d{0,2})?$/.test(value))) {
            // Xóa giá trị không hợp lệ từ trường input
            input.value = value.slice(0, -1);
        }

        // Kiểm tra nếu giá trị vượt quá 100
        if (parseFloat(value) >= 100) {
            // Đặt giá trị trường input thành 100
            input.value = "100";
        }
    }
</script>
