<script>
    function MASOCP() {
            var LoaiVT_ = $("#LoaiVT").val();
            var MASOCPID = $("#MASOCP");
            MASOCPID.empty();
        console.log("test");
            $.ajax({
                url: '@Url.Action("_LoadMASOCP")',
                timeout: 20000,
                type: "GET",
                data: { LoaiVT: LoaiVT_ },
                success: function (result) {
                    $.each(result.obj, function (i, state) {
                        MASOCPID.append($('<option/>', { value: this.MSCHIPHI }).html(this.MSCHIPHI + ' || ' + this.TENCHIPHI));
                        });
                    MASOCPID.trigger("chosen:updated");
                }
            });
        }
    function setImage(maVT) {
        var imgID = $("#myImg");
        $.ajax({
            url: '@Url.Action("SetImage")',
            timeout: 20000,
            type: "GET",
            data: {
                MAVT: maVT
            },
        }).done(function (data) {
            if (maVT != "") {
                console.log(maVT);
                document.getElementById("customer-image").style.display = "block";
            } else {

                document.getElementById("customer-image").style.display = "none";
            }
            $("#myImg").attr("src", "https://thaituangarment.com.vn/QLVatTuKhoSoi/" + data.obj[0].Images);
        }).fail(function (errors) {
            concole.log(errors);
        });

    }
</script>


