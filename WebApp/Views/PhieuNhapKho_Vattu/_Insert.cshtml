@using System.Globalization;
@model ToolsApp.Models.DM_XUATNHAPViewModels
@{
    var SOCTXN = ViewBag.SOCTXN;
    //  var donvinhan = ViewBag.donvinhan as List<ToolsApp.EntityFramework.QuanLyKhoMoc2023.spLoad_DonVi_Result>;
    var loaixn = ViewBag.loaihinhthuc as List<ToolsApp.EntityFramework.VatTu.VATTU2024_SPLOAD_DMHINHTHUC_NHAPKHO_Result>;

    var makhonhan = ViewBag.makhonhan as List<ToolsApp.EntityFramework.VatTu.VATTU2024_SP_LOADKHOQUYENNHAP_Result>;
    var NL_DMNHACCAP = ViewBag.NL_DMNHACCAP as List<ToolsApp.EntityFramework.KhoSoi.NL_DMNHACCAP>;
    var DMDONVI = ViewBag.DMDONVI as List<ToolsApp.EntityFramework.VatTu.VATTU2024_SP_LOAD_QUYEN_SUDUNG_DMDONVI_Result>;
     var manvnhan = ViewBag.manvnhan as List<ToolsApp.EntityFramework.VatTu.DMNHANVIEN>;

}
@Html.ValidationSummary(true, "", new { @class = "text-danger" })



<div class="row">
    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">SOCTXN :</label>
            <div class="col-md-9">
                <input class="form-control" type="text" autocomplete="off" value="@SOCTXN" readonly
                       id="SOCTXN_" name="SOCTXN" />
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">IDMADV Nhận :</label>
            <div class="col-md-9">
                <select class="form-control chosen-select" id="IDMADVNHAN" name="IDMADVNHAN" onchange="_Onchange_Location_MANV()">
                    @foreach (var item in DMDONVI)
                    {
                        <option value="@item.IDMaDV">@item.IDMaDV || @item.TenDonVi</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">IDMADV Xuất :</label>
            <div class="col-md-9">
                <select class="form-control chosen-select" id="IDMADVXUAT" name="IDMADVXUAT">
                    @foreach (var item in DMDONVI)
                    {
                        <option value="@item.IDMaDV">@item.IDMaDV || @item.TenDonVi</option>
                    }
                </select>
            </div>
        </div>
    </div>

</div>
<div class="row">
    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3 ">Loại XN:</label>
            <div class="col-md-9 ">
                <select class="form-control chosen-select" id="LOAIXN" name="LOAIXN" onchange="_Load_SOCTXN()">
                    @foreach (var item in loaixn)
                    {
                        <option value="@item.LOAIXN">@item.LOAIXN  ||  @item.TEN</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">Mã Kho Nhận :</label>
            <div class="col-md-9">
                <select class="form-control chosen-select" id="MAKHONHAN" name="MAKHONHAN">
                    <option disabled selected value="">-- Kho nhận--</option>
                    @foreach (var item in makhonhan)
                    {
                        <option value="@item.MAKHO">@item.MAKHO || @item.TENKHO</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">Mã Kho Xuất/NCC:</label>
            <div class="col-md-9">
                <select class="form-control chosen-select" id="MAKHOXUAT" name="MAKHOXUAT">
                    <option disabled selected value="">-- Kho nhận--</option>
                    <option value="NCC">Nhà Cung Cấp</option>
                    @foreach (var item in makhonhan)
                    {
                        <option value="@item.MAKHO">@item.MAKHO || @item.TENKHO</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">Ngày Chứng Từ:</label>
            <div class="col-md-9">
                <input type="text" autocomplete="off" id="NGAYCT" name="NGAYCT_" value="@DateTime.Now.ToString("dd/MM/yyyy")" class="form-control" />
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">Người Nhận:</label>
            <div class="col-md-9">
                <select class="form-control chosen-select" id="NGUOINHAN" name="NGUOINHAN">
                    <option disabled selected value="">-- MANV Nhận--</option>
                    @foreach (var item in manvnhan)
                    {
                        <option value="@item.MANV">@item.MANV || @item.HOTEN</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <div class="col-md-4" id="poNhapMuaNgoai">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">Số PO:</label>
            <div class="col-md-9">
                <input type="text" id="SOPO" name="SOPO" class="form-control" />
            </div>
        </div>
    </div>
    <div class="col-md-4" id="KH_NCC" style="display: none">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-3">Nhà cung cấp:</label>
            <div class="col-md-9">
                <input type="text" id="KH_NCC" name="KH_NCC" class="form-control" required />
                <small style="color: red">* Vui lòng nhập nhà cung cấp</small>
            </div>
          
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="row" style="margin-bottom:5px">
            <label class="col-md-1">Ghi chú:</label>
            <div class="col-md-11">
                <textarea rows="1" id="GHICHU" name="GHICHU" class="form-control "></textarea>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">

    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }
    $("#NGAYCT").datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true,
        onClose: function (selectedDate) {
            //$("#FromDate").datepicker("option", "minDate", selectedDate);
        }
    });

 //-----------------Load change----------------//

    function _Load_SOCTXN() {
        var IDMADVNHAN_ = $("#IDMADVNHAN").val();
        var LOAIXNid = $("#LOAIXN").val();
        var SOCTXNid = $("#SOCTXN_");

        SOCTXNid.empty();
            $.ajax({
                url: '@Url.Action("_Change_SOCTXN")',
                timeout: 20000,
                type: "POST",
                data: { LOAIXNid: LOAIXNid, IDMADVNHAN: IDMADVNHAN_},
                success: function (result) {
                    console.log(result.obj);
                    if (result.status < 0) {
                        notify(result.text, "error");
                    }
                    else
                    {
                        SOCTXNid.val(result.obj).trigger("chosen:updated");
                    }
                    LoadPO();
                }
            });
    }     

    function _Onchange_Location_MANV() {
        var IDMADVNHAN_ = $("#IDMADVNHAN").val();       
        var MANVNHAN_ = $("#NGUOINHAN");    
        MANVNHAN_.empty();        
            $.ajax({
                url: '@Url.Action("_Onchange_Location_MANV")',
                timeout: 20000,
                type: "POST",
                data: { IDMADVNHAN: IDMADVNHAN_},
                success: function (result) {

                    if (result.status < 0) {
                        notify(result.text, "error");
                    }
                    else {
                        console.log(IDMADVNHAN_);                        

                        $.each(result.obj, function (i, state) {
                            MANVNHAN_.append($('<option/>', { value: this.MANV }).html(this.MANV + "||" + this.HOTEN));
                        });
                        MANVNHAN_.trigger("chosen:updated");

                        _Load_SOCTXN();       // chạy lại soctxn theo idmadv nhận                
                    }                  
                }
            });
    }

    function LoadPO() {
        var loaixn = $('#LOAIXN').val();
        if (loaixn == 'N' || loaixn == 'NKH') {
            if (loaixn == 'N') {
                document.getElementById("poNhapMuaNgoai").style.display = 'block';
                document.getElementById("KH_NCC").style.display = 'none';
            } else {
                document.getElementById("KH_NCC").style.display = 'block';
                document.getElementById("poNhapMuaNgoai").style.display = 'none';
            }
           
        } else {
            document.getElementById("poNhapMuaNgoai").style.display = 'none';
            document.getElementById("KH_NCC").style.display = 'none';
        }
    }

</script>
