
@{

    var SOCTXN_nhap = ViewBag.SOCTXN_nhap;
    var DANHMUCMAVT = ViewBag.DANHMUCMAVT as List<ToolsApp.EntityFramework.VatTu.VATTU2024_SPLOAD_DANHMUCVATTU_Result>;
    var MAKHONHAN = ViewBag.MAKHONHAN;
    var MAKHOXUAT = ViewBag.MAKHOXUAT;
    var LOAIXN = ViewBag.LOAIXN;
    var nguoixx = ViewBag.nguoixx as List<ToolsApp.EntityFramework.VatTu.SP_LoadXemXetBM03TTKD_Result>;

}
@using System.Globalization;
@model ToolsApp.Models.XUATNHAPViewModels


<input class="form-control" type="text" autocomplete="off"
       id="hidenSOCTXN_NHTA" value="@SOCTXN_nhap.Trim()" hidden />
<input class="form-control" type="text" autocomplete="off"
       id="hidenMAKHONHAN_NHTA" value="@MAKHONHAN.Trim()" hidden />
<input class="form-control" type="text" autocomplete="off"
       id="hidenMAKHOXUAT_NHTA" value="@MAKHOXUAT.Trim()" hidden />
<input class="form-control" type="text" autocomplete="off"
       id="hidenLOAIXN_NHTA" value="@LOAIXN.Trim()" hidden />



<!DOCTYPE html>
<html lang="en">
<head>
    @*chạy load select2 cho mavt*@
    <link href="~/Content/select2.min.css" rel="stylesheet" />
    <script src="~/Scripts/select2.min.js"></script>
    @*chạy load select2 cho mavt*@


    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-md-12">
                <div class="card card-info card-tabs" id="myTap">
                    <div class="card-header p-0 pt-1">
                        <ul class="nav nav-tabs" id="custom-tabs-one-tab" role="tablist">
                            <li class="nav-item" id="tab-1">
                                <a class="nav-link active" id="custom-tabs-one-home-tab-getlist-ctphieu" style="display:block;" data-toggle="pill" href="#custom-tabs-one-home-ct" role="tab" aria-controls="custom-tabs-one-home-ct" aria-selected="true">Danh sách chi tiết phiếu @SOCTXN_nhap </a>
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        <div class="tab-content" id="custom-tabs-one-tabContent">
                            <div class="tab-pane fade col-md-12 show active" id="custom-tabs-one-home-ct" role="tabpanel" aria-labelledby="custom-tabs-one-home-tab-getlist-ctphieu">
                                <!--data-->
                                @using (Html.BeginForm(null, null, FormMethod.Get, new { name = "frmctphieu_NHTA", id = "frmctphieu_NHTA", enctype = "multipart/form-data" }))
                                {
                                    <div class="row">
                                        <div class="col-md-12">
                                            <div class="row ">
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3">SOCTXN :</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="text" autocomplete="off" value="@SOCTXN_nhap" readonly
                                                                   id="SOCTXN_CT" name="SoCTXN" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">Mã kho:</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="text" autocomplete="off"
                                                                   id="MaKho_NHTA" name="MaKho" value="@MAKHONHAN.Trim()" readonly />
                                                            <input class="form-control" type="text" autocomplete="off"
                                                                   id="LoaiXN_NHTA" name="LoaiXN" value="@LOAIXN.Trim()" hidden />
                                                        </div>
                                                    </div>
                                                </div>
                                                @*<div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3">Ngày kế toán:</label>
                                                        <div class="col-md-9">
                                                            <input id="NGAYKETOAN_NHTA" name="NgayKeToan" value="@DateTime.Now.ToString("dd/MM/yyyy")" class="form-control" />
                                                        </div>
                                                    </div>
                                                </div>*@
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3">Mã VT :</label>
                                                        <div class="col-md-9">
                                                            <select class="form-control chosen-select" id="MAVT_NHTA" name="MAVT">
                                                                <option selected value="">-- Chọn mã VT --</option>
                                                                @foreach (var item in DANHMUCMAVT)
                                                                {
                                                                    <option value="@item.MAVT">
                                                                        @item.MAVT || @item.TenVT
                                                                    </option>
                                                                }
                                                            </select>

                                                            @*<select id="MAVT_NHTA"
                                                                    name="MAVT"
                                                                    class="form-control"
                                                                    style="width:100%">
                                                            </select>*@
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">Số lượng: </label>
                                                        <div class="col-md-9">
                                                            <input class="form-control"
                                                                   type="number"
                                                                   id="SoLuongTT_NHTA"
                                                                   name="SoLuongTT"
                                                                   autocomplete="off" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">Ghi chú:</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="text" autocomplete="off" value=""
                                                                   id="GHICHU_NHTA" name="GHICHU" />
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="row" style="margin-bottom:5px">
                                                        <label class="col-md-3 ">Mã phiếu PD:</label>
                                                        <div class="col-md-9">
                                                            <input class="form-control" type="text" autocomplete="off" value=""
                                                                   id="Maphieupd_NHTA" name="MAPHIEUPD" />
                                                        </div>
                                                    </div>
                                                </div>
                                                @if (LOAIXN != "NKH")
                                                {
                                                    <div class="col-md-4">
                                                        <div class="row" style="margin-bottom:5px">
                                                            <label class="col-md-3">Người xem xét :</label>
                                                            <div class="col-md-9">
                                                                <select class="form-control chosen-select" id="MANVXX" name="MANVXX">
                                                                    <option selected value="">-- Người xem xét --</option>
                                                                    @foreach (var manv in nguoixx)
                                                                    {
                                                                        <option value="@manv.MaNV">
                                                                            @manv.MaNV || @manv.HoTen
                                                                        </option>
                                                                    }
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                </div>
                                            <div class="row" style="margin-bottom:20px">
                                            </div>
                                            <div>
                                                @*Row 3*@
                                                <div class="row">
                                                </div>
                                                <div class="row">
                                                </div>
                                                <div class="text-center">
                                                    <button type="button" id="btSavect_NHTA" onclick="_Insert_ctphieu_NHTA()" class="btn btn-primary" style="width: 100px"><i class="fa fa-save"></i>&nbsp;Lưu</button>
                                                    &nbsp;
                                                    <button type="button" onclick="OpenUploadExcelNHTA()" class="btn btn-info" style="width: 130px"><i class="fa fa-save"></i>&nbsp;UploadExcel</button>
                                                    &nbsp;
                                                    @if (LOAIXN != "NKH")
                                                    {
                                                        <button onclick="SendMail_NHTA()" type="button" class="btn btn-warning" style=" width: 100px;"><i class="fa fa-envelope"></i>&nbsp; Email</button>

                                                    }  &nbsp;

                                                </div>
                                            </div>
                                            <div class="row" style="margin-bottom:20px">
                                            </div>
                                            <div class="card-body pad">
                                                <div class="row">
                                                    <div class="col-md-12 table-body-view-ctphieu-nhta  table-responsive">

                                                    </div>
                                                </div>
                                            </div>
                                            <!-- /.card -->
                                        </div>
                                        <!--data-->
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</body>
</html>


<script>
    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }

    document.getElementById('SoLuongTT_NHTA').addEventListener('input', function () {
        let val = parseFloat(this.value);
        if (isNaN(val) || val < 0) {
            this.value = 0; // chỉ reset nếu âm hoặc không phải số
        }
    });


    function reloadData_getlist_ctphieu() {
        var SOCTXN_ = $("#SOCTXN_CT").val();
            try {
            $.ajax({
                url: '@Url.Action("_GetListCTPhieu_View")',
                timeout: 20000,
                data: {
                    SOCTXN: SOCTXN_,
                },
                beforeSend: function () {
                    $(".divLoading").addClass("loading");
                },
                success: function (response) {
                    $(".divLoading").removeClass("loading");

                    $('.table-body-view-ctphieu-nhta').html(response);

                    $("#myTablectview").DataTable({
                        //"responsive": true,
                        "lengthChange": true,
                        "autoWidth": true,
                        "stateSave": true,
                        "buttons": ["copy", "csv", "excel", "pdf", "print", "colvis"],
                        "initComplete": function (oSettings) {

                        }
                    });
                },
                error: function (message) {
                    $(".divLoading").removeClass("loading");
                }
            });
            } catch (e) {
            }
    }

    function SendMail_NHTA() {
        var SOCTXN_ = $("#SOCTXN_CT").val();
        var MANVXX_ = $("#MANVXX").val();

        var confirm_ = confirm('Bạn có chắc muốn gửi email yêu cầu xem xét?');
        if (confirm_) {


                    $.ajax({
                        url: '@Url.Action("openOutlookemailbox")',
                        timeout: 20000,
                        type: "POST",
                        data: { SOCTXN: SOCTXN_, MANVXX: MANVXX_  },
                        beforeSend: function (xhr) {
                            $(".divLoading").addClass("loading");
                        },
                        success: function (result) {
                            window.location = result;
                            $(".divLoading").removeClass("loading");
                            window.location.reload();

                        },
                        error: function (message) {
                            $(".divLoading").removeClass("loading");
                        }
                    });
                }

            }

    function _Insert_ctphieu_NHTA() {

        var LOAIXN = $("#hidenLOAIXN_NHTA").val();
        var SOCTXN = $("#hidenSOCTXN_NHTA").val();
        var MAKHONHAN = $("#hidenMAKHONHAN_NHTA").val();
        var MAVT_NHTA = $("#MAVT_NHTA").val();
     
        var SoLuongTT_NHTA = $("#SoLuongTT_NHTA").val();
        var GHICHU_NHTA = $("#GHICHU_NHTA").val();
        var Maphieupd_NHTA = $("#Maphieupd_NHTA").val();
        $.ajax({
            url: '@Url.Action("_InsertFunCTPhieu_NHTA")',
            timeout: 2000000,
            type: "POST",
            data: { LOAIXN: LOAIXN, SOCTXN: SOCTXN, MAKHONHAN: MAKHONHAN, MAVT_NHTA: MAVT_NHTA, SoLuongTT_NHTA: SoLuongTT_NHTA, GHICHU_NHTA: GHICHU_NHTA, Maphieupd_NHTA: Maphieupd_NHTA },
            beforeSend: function (xhr) {
                $(".divLoading").addClass("loading");
            },
            success: function (result) {
                if (result.status >= 1) {
                    notify(result.text, "success");

                    console.log("test2");
                    Details(SOCTXN, LOAIXN); // LOAD LẠI FORM DETAILS

                }
                else {
                    notify(result.text, "error");
                }
                $(".divLoading").removeClass("loading");
            },
            error: function (message) {
                $(".divLoading").removeClass("loading");
            }
        });
    };

    function OpenUploadExcelNHTA() {
                $myModalContentUpload.html("");
                $myModalTitleUpload.html("Tải lên");
                $.ajax({
                    url: '@Url.Action("_UploadNHTGA")',
                    timeout: 20000,
                    data: {
                        SOCTXN: $("#SOCTXN_CT").val(),
                    },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        $myModalContentUpload.html(result);
                        $modalUpload.modal();

                        $(".divLoading").removeClass("loading");
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });
        };
</script>

