<div class="row">
    <div class="col-md-12">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">
                    <b>Upload template</b>
                </h3>
            </div>
            <div class="card-body pad">
                <div class="row">
                    <div class="col-md-8">
                        <div class="form-group">
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="form-control" id="fuInputFile" name="fuInputFile">
                                </div>
                                <div class="input-group-append">
                                    <span id="btnSaveExcel" onclick="UploadTemplate()" class="btn bg-gradient-info"><i class="fa fa-file-excel"></i>&nbsp;Nhập Excel</span>
                                </div>
                                <div class="input-group-append">
                                    <a href="~/UserFiles/Template/Invoice.xlsx" class="btn bg-gradient-primary"><i class="fa fa-table"></i>&nbsp;Mẫu Excel</a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /.col -->
                </div>
            </div>
            <!-- /.card -->
        </div>
    </div>
    <!-- /.col -->
</div>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/css/bootstrap.min.css">




