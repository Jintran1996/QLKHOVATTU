<script type="text/javascript">
    var config = {
        '.chosen-select': {},
        '.chosen-select-deselect': { allow_single_deselect: true },
        '.chosen-select-no-single': { disable_search_threshold: 10 },
        '.chosen-select-no-results': { no_results_text: 'Oops, nothing found!' },
        '.chosen-select-width': { width: "95%" },
        'search_contains': true
    }
    for (var selector in config) {
        $(selector).chosen(config);
    }

    $("#btNhaptiep").click(function () {
        form = $("#frmdmphieu");
                form.removeData('validator');
                form.removeData('unobtrusiveValidation');
        $.validator.unobtrusive.parse("#frmdmphieu");
                if (form.valid()) {
                    $.ajax({
                        url: '@Url.Action("_InsertFun")',
                        type: "POST",
                        data: $('#frmdmphieu').serialize(),
                        beforeSend: function (xhr) {
                            $(".divLoading").addClass("loading");
                        },
                        success: function (result) {
                            if (result.status >= 1) {
                                notify(result.text, "success");

                                $('#custom-tabs-one-profile-tab').trigger('click');
                                $("#custom-tabs-one-profile-tab").attr('style', 'display:""');
                                $("#custom-tabs-one-home-tab").attr('style', 'display:none');
                                reloadCTPhieu(true);
                            }
                            else {
                                notify(result.text, "error");
                            }
                            $(".divLoading").removeClass("loading");
                        },
                        error: function (message) {
                            $(".divLoading").removeClass("loading");
                        }
                    });
                }
    });

    $("#THOIDIEMSD_String").datepicker({
        format: 'dd/mm/yyyy',
        changeYear: true,
        changeMonth: true,
        onClose: function (selectedDate) {
            //$("#FromDate").datepicker("option", "minDate", selectedDate);
        }
    });
</script>

<script>
    function btLuu() {
        form = $("#frmctphieu");
                form.removeData('validator');
                form.removeData('unobtrusiveValidation');
        $.validator.unobtrusive.parse("#frmctphieu");
                if (form.valid()) {
                    $.ajax({
                        url: '@Url.Action("_SaveCTPhieu")',
                        type: "POST",
                        data: $('#frmctphieu').serialize(),
                        beforeSend: function (xhr) {
                            $(".divLoading").addClass("loading");
                        },
                        success: function (result) {
                            if (result.status >= 1) {
                                notify(result.text, "success");
                                reloadCTPhieu(true);
                                $("#myModal").on("hidden.bs.modal", function () {
                                    reloadData(false);
                                });
                            }
                            else {
                                notify(result.text, "error");
                            }
                            $(".divLoading").removeClass("loading");
                        },
                        error: function (message) {
                            $(".divLoading").removeClass("loading");
                        }
                    });
                }
    }

    function btExcel() {
                $myModalContentUpload.html("");
                $myModalTitleUpload.html("Tải lên");
                $.ajax({
                    url: '@Url.Action("_Upload")',
                    timeout: 20000,
                    data: {
                    },
                    beforeSend: function (xhr) {
                        $(".divLoading").addClass("loading");
                    },
                    success: function (result) {
                        $myModalContentUpload.html(result);
                        $modalUpload.modal();

                        $(".divLoading").removeClass("loading");
                    },
                    error: function (message) {
                        $(".divLoading").removeClass("loading");
                    }
                });

    };
    function LoaiVT1() {
        var _loaiphieu = $('#LoaiPhieu').val();
        var LoaiVT = $("#LoaiVT");
        LoaiVT.empty();
        $.ajax({
            url: '@Url.Action("_LoadLoaiVT")',
            timeout: 20000,
            data: {
                LoaiPhieu: _loaiphieu
            },
            beforeSend: function () {
                $(".divLoading").addClass("loading");
            },
            success: function (result) {
                $.each(result.obj, function (i, state) {
                    LoaiVT.append($('<option/>', { value: this.LoaiVT }).html(this.LoaiVT));
                });
                LoaiVT.trigger("chosen:updated");
                $(".divLoading").removeClass("loading");
            }, 
            error: function (message) {
                $(".divLoading").removeClass("loading");
            }
        });
    }

    function MaVT1() {
        var _loaivt = $('#LoaiVT').val();
        var _loaiphieu = $('#LoaiPhieu').val();
        var MaVTID = $("#MAVT");
        MaVTID.empty();
        $.ajax({
            url: '@Url.Action("LoadMaVT")',
            timeout: 20000,
            data: {
                loaivt: _loaivt,
                LoaiPhieu: _loaiphieu
            },
            beforeSend: function () {
                $(".divLoading").addClass("loading");
            },
            success: function (result) {
                console.log(result.obj);
                //$.each(result.obj, function (i, state) {
                //    MaVTID.append($('<option/>', { value: this.MAVT }).html(this.VT));
                //});
                if ($('#LoaiPhieu').val() == "04") {
                    var options = result.obj;
                    for (var i = 0; i < options.length; i++) {
                        var option = options[i];
                        MaVTID.append($('<option/>', { value: option.MAVT }).html(option.MAVT + "||" + option.TenVT));
                    };
                }
                else {
                    if ($('#LoaiVT').val() == "PT-VT") {
                        var options = result.obj;
                        for (var i = 0; i < options.length; i++) {
                            var option = options[i];
                            MaVTID.append($('<option/>', { value: option.MAVT }).html(option.MAVT + "||" + option.TENVT + "|| Số lượng tồn : " + option.TONKHODONVI));
                        }
                    }
                    else {
                        var options = result.obj;
                        for (var i = 0; i < options.length; i++) {
                            var option = options[i];
                            MaVTID.append($('<option/>', { value: option.MAVT }).html(option.VT));
                        }
                    }
                }
                

                MaVTID.trigger("chosen:updated");
                $('#LoaiVT_2').val($('#LoaiVT').val()).trigger("chosen:updated");

                $(".divLoading").removeClass("loading");
            },
            error: function (message) {
                $(".divLoading").removeClass("loading");
            }
        });
    }

