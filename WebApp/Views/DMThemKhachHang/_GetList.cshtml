@{
    var list = ViewBag.List as List<ToolsApp.EntityFramework.VatTu.KhachHang>;

    var STT = 1;
}

<table id="myTable" class="table table-bordered">
    <thead>
        <tr style="background-color: aqua; text-align:center" >
            <th width="40px">STT</th>
            <th></th>          
            <th>Mã khách hàng</th>
            <th>Tên khách hàng</th>
            <th>Địa chỉ</th>
            <th>Mã số thuế</th>          
        </tr>
    </thead>

    <tbody>
        @foreach (var item in list)
        {
        <tr>
            <td style="text-align:center"> @STT </td>
            <td width="133px">
                <a onclick="Edit('@item.MaKH')" class="btn">
                    <i class="fas fa-edit"></i> Sửa
                </a>
                <a onclick="Delete('@item.MaKH')" class="btn">
                    <i class="far fa-trash-alt"></i> Xóa
                </a>
            </td>
            <td> @item.MaKH </td>
            <td> @item.TenKH </td>
            <td> @item.DiaChi </td>
            <td>@item.MaSothue</td>
        </tr>
            STT++;
        }
    </tbody>
</table>
